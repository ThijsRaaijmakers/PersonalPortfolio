---
export interface BreadcrumbItem {
  label: string;
  href?: string;
}

export interface Props {
  items: BreadcrumbItem[];
}

const { items = [] } = Astro.props;
---

<nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 font-mono text-xs text-slate-500 dark:text-slate-400">
  {items.map((item, index) => {
    const isLast = index === items.length - 1;
    return (
      <div class="flex items-center space-x-2">
        {index > 0 && <span class="text-cyan-500/60 dark:text-cyan-400/60 select-none">/</span>}
        {item.href && !isLast ? (
          <a
            href={item.href}
            class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors"
          >
            {item.label}
          </a>
        ) : (
          <span class={isLast ? "text-cyan-600 dark:text-cyan-400 font-semibold" : ""}>
            {item.label}
          </span>
        )}
      </div>
    );
  })}
</nav>
