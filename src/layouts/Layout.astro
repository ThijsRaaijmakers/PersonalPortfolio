---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "AI & Cybersecurity MSc Portfolio | Tilburg University",
  description = "Professional portfolio of an MSc candidate in AI and Cybersecurity at Tilburg University.",
  image = "/og-image.png"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'http://localhost:4321');
---

<!doctype html>
<html lang={Astro.url.pathname.startsWith('/nl') ? 'nl' : 'en'} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <ClientRouter />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- FOUC Prevention Theme Script (Strict Dark Mode Default) -->
    <script is:inline>
      function applyTheme() {
        const theme = (() => {
          if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
            return localStorage.getItem('theme');
          }
          return 'dark'; // Strict dark mode default
        })();
        if (theme === 'light') {
          document.documentElement.classList.remove('dark');
        } else {
          document.documentElement.classList.add('dark');
        }
        window.localStorage.setItem('theme', theme);
      }
      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
    </script>

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- PWA Web App Manifest & OS Share Target -->
    <link rel="manifest" href="/manifest.json" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />
  </head>
  
  <body class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 min-h-screen flex flex-col font-sans antialiased selection:bg-cyan-500/30 transition-colors duration-500 ease-in-out overflow-x-hidden">
    <!-- Progressive Enrollment Passkey Nudge Toast -->
    <div id="passkey-nudge" class="fixed top-6 left-1/2 -translate-x-1/2 z-[9999] w-[90%] max-w-sm p-4 rounded-2xl bg-slate-900/95 backdrop-blur border border-cyan-500/50 shadow-2xl shadow-cyan-500/20 translate-y-[-150%] opacity-0 transition-all duration-500 font-mono text-xs flex items-start space-x-3">
      <div class="mt-0.5 text-cyan-400">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.07 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 004.07 9M3 15.364c.64-1.319 1-2.8 1-4.364 0-1.457.39-2.823 1.07-4"/></svg>
      </div>
      <div class="flex-1 space-y-1.5">
        <p class="font-bold text-slate-100">{Astro.url.pathname.startsWith('/nl') ? 'Verbeter je beveiliging' : 'Upgrade your security'}</p>
        <p class="text-slate-400 text-[11px] leading-relaxed">{Astro.url.pathname.startsWith('/nl') ? 'Je apparaat ondersteunt biometrisch inloggen. Stel een Passkey in voor snelle toegang zonder wachtwoord.' : 'Your device supports biometric login. Set up a Passkey for instant, passwordless access.'}</p>
        <div class="pt-1 flex space-x-3 font-semibold">
          <a href={Astro.url.pathname.startsWith('/nl') ? '/nl/profile#biometric-settings' : '/profile#biometric-settings'} class="text-cyan-400 hover:text-cyan-300 transition-colors">{Astro.url.pathname.startsWith('/nl') ? 'Nu instellen →' : 'Set up now →'}</a>
          <button id="dismiss-nudge-btn" class="text-slate-500 hover:text-slate-300 transition-colors cursor-pointer">{Astro.url.pathname.startsWith('/nl') ? 'Sluiten' : 'Dismiss'}</button>
        </div>
      </div>
    </div>

    <Header />
    
    <main class="flex-grow w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
      <slot />
    </main>

    <Footer />

    <!-- Global Layout Client Scripts -->
    <script>
      import { supabase } from '../lib/supabase';

      const CIPHER_CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*<>/[]{}~';

      function initCipherHover() {
        const elements = document.querySelectorAll<HTMLElement>('.cipher-hover');

        elements.forEach((el) => {
          if (el.dataset.cipherInit === 'true') return;
          el.dataset.cipherInit = 'true';

          if (!el.dataset.original) {
            el.dataset.original = el.textContent?.trim() || '';
          }

          let intervalId: ReturnType<typeof setInterval> | null = null;

          el.addEventListener('mouseenter', () => {
            const originalText = el.dataset.original || el.textContent?.trim() || '';
            if (!originalText) return;

            if (intervalId) clearInterval(intervalId);

            let iteration = 0;
            const totalSteps = 10; // ~300ms total (10 steps * 30ms)

            intervalId = setInterval(() => {
              const resolvedLength = Math.floor((iteration / totalSteps) * originalText.length);

              el.textContent = originalText
                .split('')
                .map((char, index) => {
                  if (index < resolvedLength) {
                    return originalText[index];
                  }
                  if (char === ' ' || char === '\n') {
                    return char;
                  }
                  return CIPHER_CHARS[Math.floor(Math.random() * CIPHER_CHARS.length)];
                })
                .join('');

              iteration++;

              if (iteration > totalSteps) {
                if (intervalId) clearInterval(intervalId);
                el.textContent = originalText;
                intervalId = null;
              }
            }, 30);
          });
        });
      }

      async function evaluatePasskeyNudge() {
        const nudge = document.getElementById('passkey-nudge');
        const dismissBtn = document.getElementById('dismiss-nudge-btn');
        if (!nudge || !dismissBtn) return;

        // 1. Check user preferences
        if (localStorage.getItem('passkey_nudge_dismissed') === 'true') return;

        // 2. Ensure user is logged in
        const { data: { session } } = await supabase.auth.getSession();
        if (!session) return;

        // 3. Query profiles table for definitive passkey registration status
        const { data: profile } = await supabase
          .from('profiles')
          .select('has_passkey')
          .eq('id', session.user.id)
          .single();

        // If they already have a passkey in the DB, silently save to localStorage and abort
        if (profile?.has_passkey) {
          try {
            localStorage.setItem('fleetport_has_passkey', 'true');
          } catch {}
          return;
        }

        // 4. Check for hardware biometric scanner
        if (window.PublicKeyCredential && typeof window.PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable === 'function') {
          const isAvailable = await window.PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable();
          if (isAvailable) {
            // Delay the nudge slightly so it doesn't collide with the page load
            setTimeout(() => {
              nudge.classList.remove('translate-y-[-150%]', 'opacity-0');

              // Auto-dismiss after 8 seconds
              setTimeout(() => {
                nudge.classList.add('translate-y-[-150%]', 'opacity-0');
              }, 8000);
            }, 1500);
          }
        }

        // 5. Handle Dismissal
        dismissBtn.addEventListener('click', () => {
          try {
            localStorage.setItem('passkey_nudge_dismissed', 'true');
          } catch {}
          nudge.classList.add('translate-y-[-150%]', 'opacity-0');
        }, { once: true });
      }

      document.addEventListener('astro:page-load', () => {
        initCipherHover();
        evaluatePasskeyNudge();
      });
    </script>
  </body>
</html>
