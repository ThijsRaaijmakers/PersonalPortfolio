    if (ulcerVal) ulcerVal.textContent = ulcer.toFixed(3);
    if (zStressVal) zStressVal.textContent = zStress.toFixed(2);
    if (ddBadge) {
      if (dd <= -4.0) {
        ddBadge.textContent = 'CIRCUIT BREACH';
        ddBadge.className = 'px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-rose-500/20 text-rose-400 border border-rose-500/40';
      } else if (dd <= -2.0) {
        ddBadge.textContent = 'TAIL DEFENSE';
        ddBadge.className = 'px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-amber-500/20 text-amber-400 border border-amber-500/40';
      } else {
        ddBadge.textContent = 'NOMINAL RISK';
        ddBadge.className = 'px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-emerald-500/15 text-emerald-500 border border-emerald-500/30';
      }
    }

    // Card 3: Dual-Nullspace Neutrality
    const tailBeta = Number(norm.realized_tail_beta) || 0;
    const netExp = Number(norm.net_dollar_exposure) || 0;
    const grossLev = Number(norm.gross_leverage) || 0;

    if (betaVal) betaVal.textContent = tailBeta.toFixed(3);
    if (netExpVal) netExpVal.textContent = formatUsd(netExp);
    if (grossLevVal) grossLevVal.textContent = `${grossLev.toFixed(2)}x`;

    if (betaBadge) {
      if (tailBeta <= 0.035) {
        betaBadge.textContent = 'SAFE (<= 0.035)';
        betaBadge.className = 'px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-emerald-500/15 text-emerald-500 border border-emerald-500/30';
      } else {
        betaBadge.textContent = 'BETA BREACH (> 0.035)';
        betaBadge.className = 'px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-rose-500/20 text-rose-400 border border-rose-500/50';
      }
    }

    // Card 4: Layer-1 Regime & CSD Gate
    const gate = norm.gate;
    if (gateVal) gateVal.textContent = `${gate.toFixed(2)}x`;
    if (gCsdVal) gCsdVal.textContent = norm.gCsd.toFixed(3);
    if (rhoVal) rhoVal.textContent = norm.rhoConc.toFixed(3);
    if (csdRegimeLabel) csdRegimeLabel.textContent = norm.regime;
    if (quantL1ErrVal) quantL1ErrVal.textContent = norm.l1QuantErr === 0 ? '0.000 (NOMINAL)' : norm.l1QuantErr.toFixed(3);
    if (csdProgressBar) csdProgressBar.style.width = `${Math.min(100, Math.max(0, gate * 100))}%`;

    if (csdBadge) {
      if (gate >= 0.8) {
        csdBadge.textContent = 'GATE OPEN (1.0x)';
        csdBadge.className = 'px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-emerald-500/15 text-emerald-500 border border-emerald-500/30';
      } else if (gate > 0) {
        csdBadge.textContent = `THROTTLED (${gate.toFixed(2)}x)`;
        csdBadge.className = 'px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-amber-500/20 text-amber-400 border border-amber-500/40';
      } else {
        csdBadge.textContent = 'GATE CLOSED (0.0x)';
        csdBadge.className = 'px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-rose-500/20 text-rose-400 border border-rose-500/50';
      }
    }

    // Card 5: Execution Quality
    const mtPercentage = norm.normRatio * 100;
    if (mtVal) mtVal.textContent = `${mtPercentage.toFixed(2)}%`;
    if (mtProgressBar) mtProgressBar.style.width = `${Math.min(100, Math.max(0, mtPercentage))}%`;
    if (makerFillsVal) makerFillsVal.textContent = String(norm.makerFills);
    if (takerFillsVal) takerFillsVal.textContent = String(norm.takerFills);
    if (gtxRejectsVal) gtxRejectsVal.textContent = `${norm.gtxRejects} (Protected)`;
    if (card5FeesVal) card5FeesVal.textContent = formatUsd(fees);

    // Card 6: Core-Satellite Split Calculator calculation
    updateCalculatorOutputs(nav);
  }

  // ==========================================
  // CORE-SATELLITE CALCULATOR
  // ==========================================
  function updateCalculatorOutputs(currentSatNav?: number) {
    const coreInput = document.getElementById('core-balance-input') as HTMLInputElement | null;
    const salaryInput = document.getElementById('salary-deposit-input') as HTMLInputElement | null;
    const satPctLabel = document.getElementById('calc-sat-pct');
    const bandBadge = document.getElementById('band-status-badge');
    const depCoreLabel = document.getElementById('calc-deposit-core');
    const depSatLabel = document.getElementById('calc-deposit-sat');
    const totalNavLabel = document.getElementById('calc-total-nav');

    const coreNav = Math.max(0, Number(coreInput?.value) || 0);
    const cNew = Math.max(0, Number(salaryInput?.value) || 0);
    const satNav = currentSatNav !== undefined 
      ? currentSatNav 
      : Math.max(0, Number(document.getElementById('nav-usd-val')?.textContent?.replace(/[^0-9.-]+/g, '')) || 0);

    const totalNav = coreNav + satNav;
    const combinedTotal = totalNav + cNew;

    // Current satellite allocation %
    const satPct = totalNav > 0 ? (satNav / totalNav) * 100 : 10.0;

    if (satPctLabel) satPctLabel.textContent = `${satPct.toFixed(2)}%`;
    if (totalNavLabel) totalNavLabel.textContent = formatUsd(combinedTotal);

    // 90/10 Split of new deposit C_new
    const depCore = cNew * 0.90;
    const depSat = cNew * 0.10;

    if (depCoreLabel) depCoreLabel.textContent = `+${formatUsd(depCore)}`;
    if (depSatLabel) depSatLabel.textContent = `+${formatUsd(depSat)}`;

    // Tolerance band [7.0%, 13.5%]
    if (bandBadge) {
      if (satPct >= 7.0 && satPct <= 13.5) {
        bandBadge.textContent = 'OPTIMAL [7.0%, 13.5%]';
        bandBadge.className = 'px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-emerald-500/15 text-emerald-500 border border-emerald-500/30';
      } else if (satPct < 7.0) {
        bandBadge.textContent = 'UNDER-ALLOCATED (< 7.0%)';
        bandBadge.className = 'px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-amber-500/20 text-amber-400 border border-amber-500/40';
      } else {
        bandBadge.textContent = 'OVER-ALLOCATED (> 13.5%)';
        bandBadge.className = 'px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-rose-500/20 text-rose-400 border border-rose-500/50';
      }
    }
  }

  // ==========================================
  // SECTION 3 RENDERER (SVG CHART & BASKET)
  // ==========================================
  function renderSection3(latest: any, history: any[]) {
    // 1. Render Basket Exposure Table
    const navUsd = Number(latest?.nav_usd) || 100000;
    renderBasketTable(latest?.positions_lots || latest?.positions || {}, navUsd);

    // 2. Render SVG Chart
    renderChart(history);
  }

  function renderBasketTable(positions: Record<string, any>, navUsdParam?: number) {
    const tbody = document.getElementById('basket-table-body');
    if (!tbody) return;

    const navUsd = Number(navUsdParam) || (latestTelemetryRow ? Number(latestTelemetryRow.nav_usd) : 100000) || 100000;
    const basketTickers = ['BTCUSDC', 'ETHUSDC', 'SOLUSDC', 'SUIUSDT', 'XRPUSDC', 'DOGEUSDC'];

    let activeLegsCount = 0;
    let totalGrossExposure = 0;
    let totalBasketUpnlUsd = 0;

    const rowsHtml = basketTickers.map(ticker => {
      const rawEntry = positions[ticker] ?? positions[ticker.replace('USDC', '')] ?? {};
      const h = computeAssetHoldingMetrics(ticker, rawEntry, navUsd);

      const isLong = h.direction === 'LONG';
      const isShort = h.direction === 'SHORT';
      const isFlat = h.direction === 'FLAT';

      if (!isFlat) {
        activeLegsCount++;
        totalGrossExposure += Math.abs(h.notional_usd);
        totalBasketUpnlUsd += h.upnl_usd;
      }

      // Column 1: Asset + Badge
      let badgeHtml = '<span class="bg-slate-800 text-slate-400 px-1 py-0.5 rounded text-[9px] font-bold shrink-0">FLAT</span>';
      if (isLong) {
        badgeHtml = '<span class="bg-emerald-500/15 text-emerald-400 border border-emerald-500/30 px-1 py-0.5 rounded text-[9px] font-bold shrink-0">LONG</span>';
      } else if (isShort) {
        badgeHtml = '<span class="bg-rose-500/15 text-rose-400 border border-rose-500/30 px-1 py-0.5 rounded text-[9px] font-bold shrink-0">SHORT</span>';
      }

      // Column 2: Size (Lots)
      let lotsFormatted = '0.0000';
      if (!isFlat) {
        const absLots = Math.abs(h.qty_lots);
        const signLots = h.qty_lots > 0 ? '+' : '';
        lotsFormatted = absLots >= 100 
          ? `${signLots}${h.qty_lots.toLocaleString('en-US', { minimumFractionDigits: 1, maximumFractionDigits: 2 })}`
          : `${signLots}${h.qty_lots.toFixed(4)}`;
      }

      // Column 3: Exposure ($ / %)
      let exposureTop = '$0.00';
      let exposureBottom = '(0.00%)';
      let exposureColor = 'text-slate-400';
      if (!isFlat) {
        const absNotional = Math.abs(h.notional_usd);
        const signNotional = h.notional_usd > 0 ? '+' : '-';
        exposureTop = `${signNotional}$${absNotional.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
        exposureColor = isLong ? 'text-emerald-500 dark:text-emerald-400 font-bold' : 'text-rose-500 dark:text-rose-400 font-bold';
        const weightPct = h.weight * 100;
        exposureBottom = `(${weightPct >= 0 ? '+' : ''}${weightPct.toFixed(2)}%)`;
      }

      // Column 4: Entry / Mark ($)
      let entryMarkHtml = '<span class="text-slate-500">—</span>';
      if (!isFlat) {
        entryMarkHtml = `
          <div><span class="text-slate-400 text-[10px] mr-1">IN:</span><span class="text-slate-700 dark:text-slate-200 font-semibold">${fmtContractPrice(h.entry_price, h.symbol)}</span></div>
          <div class="mt-0.5"><span class="text-slate-400 text-[10px] mr-1">NOW:</span><span class="text-cyan-600 dark:text-cyan-400 font-semibold">${fmtContractPrice(h.mark_price, h.symbol)}</span></div>
        `;
      }

      // Column 5: Unrealized PnL ($ / %)
      let upnlHtml = `
        <div class="font-bold text-slate-400 dark:text-slate-500 leading-tight">$0.00</div>
        <div class="text-[10px] text-slate-400 dark:text-slate-500 leading-tight mt-0.5">0.00%</div>
      `;
      if (!isFlat) {
        if (h.upnl_usd > 0.005) {
          upnlHtml = `
            <div class="font-bold text-emerald-600 dark:text-emerald-400 leading-tight">
              +$${h.upnl_usd.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
            </div>
            <div class="mt-0.5">
              <span class="inline-block px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 text-[10px] font-bold">
                +${h.upnl_pct.toFixed(2)}%
              </span>
            </div>
          `;
        } else if (h.upnl_usd < -0.005) {
          upnlHtml = `
            <div class="font-bold text-rose-600 dark:text-rose-400 leading-tight">
              -$${Math.abs(h.upnl_usd).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
            </div>
            <div class="mt-0.5">
              <span class="inline-block px-1.5 py-0.5 rounded bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20 text-[10px] font-bold">
                ${h.upnl_pct.toFixed(2)}%
              </span>
            </div>
          `;
        } else {
          upnlHtml = `
            <div class="font-bold text-slate-500 dark:text-slate-400 leading-tight">$0.00</div>
            <div class="text-[10px] text-slate-500 dark:text-slate-400 leading-tight mt-0.5">0.00%</div>
          `;
        }
      }

      return `
        <tr class="hover:bg-slate-200/50 dark:hover:bg-slate-800/40 transition-colors">
          <td class="py-2.5 px-2 font-bold text-slate-900 dark:text-slate-100">
            <div class="flex items-center space-x-1 min-w-0">
              <span class="truncate">${ticker}</span>
              ${badgeHtml}
            </div>
          </td>
          <td class="py-2.5 px-1.5 text-right text-slate-700 dark:text-slate-300 font-medium truncate">
            ${lotsFormatted}
          </td>
          <td class="py-2.5 px-1.5 text-right truncate">
            <div class="${exposureColor} leading-tight">${exposureTop}</div>
            <div class="text-[11px] text-slate-400 leading-tight mt-0.5">${exposureBottom}</div>
          </td>
          <td class="py-2.5 px-1.5 text-right truncate">
            ${entryMarkHtml}
          </td>
          <td class="py-2.5 px-2 text-right truncate">
            ${upnlHtml}
          </td>
        </tr>
      `;
    }).join('');

    tbody.innerHTML = rowsHtml;

    // Update Footer Summary
    const activeLegsEl = document.getElementById('basket-active-legs');
    const grossExpEl = document.getElementById('basket-gross-exposure');
    const totalUpnlEl = document.getElementById('basket-total-upnl');

    if (activeLegsEl) activeLegsEl.textContent = `${activeLegsCount} / 6`;
    if (grossExpEl) grossExpEl.textContent = formatUsd(totalGrossExposure);

    if (totalUpnlEl) {
      const basketUpnlPct = navUsd > 0 ? (totalBasketUpnlUsd / navUsd) * 100 : 0;
      if (totalBasketUpnlUsd > 0.005) {
        totalUpnlEl.textContent = `+${formatUsd(totalBasketUpnlUsd)} (+${basketUpnlPct.toFixed(2)}%)`;
        totalUpnlEl.className = 'font-bold text-emerald-600 dark:text-emerald-400';
      } else if (totalBasketUpnlUsd < -0.005) {
        totalUpnlEl.textContent = `-${formatUsd(Math.abs(totalBasketUpnlUsd))} (${basketUpnlPct.toFixed(2)}%)`;
        totalUpnlEl.className = 'font-bold text-rose-600 dark:text-rose-400';
      } else {
        totalUpnlEl.textContent = `$0.00 (0.00%)`;
        totalUpnlEl.className = 'font-bold text-slate-500 dark:text-slate-400';
      }
    }
  }

  function renderChart(history: any[]) {
    const emptyState = document.getElementById('chart-empty-state');
    const navArea = document.getElementById('chart-nav-area');
    const navPath = document.getElementById('chart-nav-path');
    const betaPath = document.getElementById('chart-beta-path');
    const gridLines = document.getElementById('chart-grid-lines');
    const yLabels = document.getElementById('chart-y-labels');
    const betaThresholdLine = document.getElementById('chart-beta-threshold-line');
    const betaThresholdLabel = document.getElementById('chart-beta-threshold-label');

    if (!history || history.length === 0) {
      if (emptyState) emptyState.classList.remove('hidden');
      if (navArea) navArea.setAttribute('d', '');
      if (navPath) navPath.setAttribute('d', '');
      if (betaPath) betaPath.setAttribute('d', '');
      if (gridLines) gridLines.innerHTML = '';
      if (yLabels) yLabels.innerHTML = '';
      return;
    }

    if (emptyState) emptyState.classList.add('hidden');

    // Chronological order: reverse from DESC
    const sorted = [...history].sort((a, b) => Number(a.timestamp_ms) - Number(b.timestamp_ms));

    const width = 900;
    const height = 300;
    const padLeft = 60;
    const padRight = 50;
    const padTop = 25;
    const padBottom = 35;
    const chartW = width - padLeft - padRight;
    const chartH = height - padTop - padBottom;

    // NAV min & max
    let minNav = Math.min(...sorted.map(d => Number(d.nav_usd) || 0));
    let maxNav = Math.max(...sorted.map(d => Number(d.nav_usd) || 0));
    if (minNav === maxNav) {
      minNav *= 0.98;
      maxNav *= 1.02;
    }
    const navMargin = (maxNav - minNav) * 0.1 || 100;
    minNav = Math.max(0, minNav - navMargin);
    maxNav = maxNav + navMargin;

    // Beta min & max (0.0 to 0.05 min range)
    let minBeta = 0.0;
    let maxBeta = Math.max(0.045, ...sorted.map(d => Number(d.realized_tail_beta) || 0));

    // Coordinate scales
    const scaleX = (idx: number) => {
      if (sorted.length === 1) return padLeft + chartW / 2;
      return padLeft + (idx / (sorted.length - 1)) * chartW;
    };

    const scaleYNav = (val: number) => {
      return padTop + chartH - ((val - minNav) / (maxNav - minNav)) * chartH;
    };

    const scaleYBeta = (val: number) => {
      return padTop + chartH - ((val - minBeta) / (maxBeta - minBeta)) * chartH;
    };

    // Grid lines & labels (4 levels)
    if (gridLines && yLabels) {
      let gridHtml = '';
      let labelHtml = '';

      for (let i = 0; i <= 4; i++) {
        const frac = i / 4;
        const y = padTop + chartH * (1 - frac);
        const navVal = minNav + frac * (maxNav - minNav);
        const betaVal = minBeta + frac * (maxBeta - minBeta);

        gridHtml += `<line x1="${padLeft}" y1="${y}" x2="${width - padRight}" y2="${y}" />`;
        labelHtml += `<text x="${padLeft - 8}" y="${y + 3}" text-anchor="end">${formatUsd(navVal)}</text>`;
        labelHtml += `<text x="${width - padRight + 8}" y="${y + 3}" text-anchor="start" fill="#fbbf24">${betaVal.toFixed(3)}</text>`;
      }

      gridLines.innerHTML = gridHtml;
      yLabels.innerHTML = labelHtml;
    }

    // Beta threshold reference line (0.035)
    const thresholdY = scaleYBeta(0.035);
    if (betaThresholdLine) {
      betaThresholdLine.setAttribute('y1', thresholdY.toString());
      betaThresholdLine.setAttribute('y2', thresholdY.toString());
      betaThresholdLine.setAttribute('x1', padLeft.toString());
      betaThresholdLine.setAttribute('x2', (width - padRight).toString());
    }
    if (betaThresholdLabel) {
      betaThresholdLabel.setAttribute('y', (thresholdY - 4).toString());
      betaThresholdLabel.setAttribute('x', (width - padRight - 5).toString());
    }

    // Build SVG paths
    const navPoints = sorted.map((d, i) => ({
      x: scaleX(i),
      y: scaleYNav(Number(d.nav_usd) || 0),
      data: d,
    }));

    const betaPoints = sorted.map((d, i) => ({
      x: scaleX(i),
      y: scaleYBeta(Number(d.realized_tail_beta) || 0),
    }));

    const navPathD = navPoints.map((p, i) => `${i === 0 ? 'M' : 'L'} ${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join(' ');
    const betaPathD = betaPoints.map((p, i) => `${i === 0 ? 'M' : 'L'} ${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join(' ');

    const baselineY = padTop + chartH;
    const navAreaD = `${navPathD} L ${navPoints[navPoints.length - 1].x.toFixed(1)} ${baselineY} L ${navPoints[0].x.toFixed(1)} ${baselineY} Z`;

    if (navPath) navPath.setAttribute('d', navPathD);
    if (navArea) navArea.setAttribute('d', navAreaD);
    if (betaPath) betaPath.setAttribute('d', betaPathD);

    // Interactive Hover Crosshair
    const svgEl = document.getElementById('telemetry-chart-svg');
    const crosshairGroup = document.getElementById('chart-crosshair-group');
    const crosshairV = document.getElementById('crosshair-v');
    const dotNav = document.getElementById('crosshair-nav-dot');
    const dotBeta = document.getElementById('crosshair-beta-dot');
    const tooltip = document.getElementById('chart-floating-tooltip');
    const tipTime = document.getElementById('tip-bar-time');
    const tipNav = document.getElementById('tip-nav-val');
    const tipBeta = document.getElementById('tip-beta-val');

    if (svgEl && !svgEl.dataset.crosshairBound) {
      svgEl.dataset.crosshairBound = 'true';

      svgEl.addEventListener('mousemove', (e: MouseEvent) => {
        const rect = svgEl.getBoundingClientRect();
        const mouseX = ((e.clientX - rect.left) / rect.width) * width;

        if (mouseX < padLeft || mouseX > width - padRight) {
          if (crosshairGroup) crosshairGroup.setAttribute('opacity', '0');
          if (tooltip) tooltip.classList.add('hidden');
          return;
        }

        // Find nearest point
        let nearestIdx = 0;
        let minDist = Infinity;
        navPoints.forEach((p, idx) => {
          const dist = Math.abs(p.x - mouseX);
          if (dist < minDist) {
            minDist = dist;
            nearestIdx = idx;
          }
        });

        const np = navPoints[nearestIdx];
        const bp = betaPoints[nearestIdx];
        const record = np.data;

        if (crosshairGroup) crosshairGroup.setAttribute('opacity', '1');
        if (crosshairV) {
          crosshairV.setAttribute('x1', np.x.toString());
          crosshairV.setAttribute('x2', np.x.toString());
        }
        if (dotNav) {
          dotNav.setAttribute('cx', np.x.toString());
          dotNav.setAttribute('cy', np.y.toString());
        }
        if (dotBeta) {
          dotBeta.setAttribute('cx', bp.x.toString());
          dotBeta.setAttribute('cy', bp.y.toString());
        }

        if (tooltip && tipTime && tipNav && tipBeta) {
          const d = new Date(Number(record.timestamp_ms));
          tipTime.textContent = `Bar #${record.bar_idx} &bull; ${d.toISOString().replace('T', ' ').substring(0, 16)} UTC`;
          tipNav.textContent = formatUsd(Number(record.nav_usd));
          tipBeta.textContent = Number(record.realized_tail_beta).toFixed(3);
          tooltip.classList.remove('hidden');
        }
      });

      svgEl.addEventListener('mouseleave', () => {
        if (crosshairGroup) crosshairGroup.setAttribute('opacity', '0');
        if (tooltip) tooltip.classList.add('hidden');
      });
    }
  }

  // ==========================================
  // SECTION 4 RENDERER (COMMANDS QUEUE TABLE)
  // ==========================================
  function renderCommandsTable(commands: any[]) {
    const tbody = document.getElementById('commands-table-body');
    if (!tbody) return;

    if (!commands || commands.length === 0) {
      tbody.innerHTML = `
        <tr class="text-slate-500">
          <td colspan="7" class="py-6 text-center text-xs">
            // NO C2 COMMANDS IN QUEUE • Command transitions dispatched from this console will appear here.
          </td>
        </tr>
      `;
      return;
    }

    const html = commands.map(cmd => {
      const state = cmd.target_state || 'UNKNOWN';
      const status = cmd.status || 'PENDING';
      const idShort = cmd.id ? `${cmd.id.substring(0, 8)}...` : '--';
      const hmacShort = cmd.hmac_signature ? `${cmd.hmac_signature.substring(0, 10)}...` : '--';

      let stateBadgeClass = 'bg-slate-800 text-slate-300';
      if (state === 'STATE_RUNNING') stateBadgeClass = 'bg-emerald-500/15 text-emerald-400 border border-emerald-500/30';
      else if (state === 'STATE_PAUSE_MAINTAIN') stateBadgeClass = 'bg-amber-500/15 text-amber-400 border border-amber-500/30';
      else if (state === 'STATE_GRACEFUL_UNWIND_FLAT') stateBadgeClass = 'bg-cyan-500/15 text-cyan-400 border border-cyan-500/30';
      else if (state === 'STATE_EMERGENCY_HALT') stateBadgeClass = 'bg-rose-500/20 text-rose-400 border border-rose-500/50';

      let statusBadge = `
        <span class="inline-flex items-center space-x-1.5 px-2 py-0.5 rounded text-[10px] font-bold bg-amber-500/15 text-amber-400 border border-amber-500/30">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
          <span>PENDING</span>
        </span>
      `;

      if (status === 'ACKNOWLEDGED') {
        statusBadge = `
          <span class="inline-flex items-center space-x-1.5 px-2 py-0.5 rounded text-[10px] font-bold bg-blue-500/15 text-blue-400 border border-blue-500/30">
            <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
            <span>ACK</span>
          </span>
        `;
      } else if (status === 'EXECUTED') {
        statusBadge = `
          <span class="inline-flex items-center space-x-1.5 px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            <span>EXECUTED</span>
          </span>
        `;
      } else if (status === 'REJECTED') {
        statusBadge = `
          <span class="inline-flex items-center space-x-1.5 px-2 py-0.5 rounded text-[10px] font-bold bg-rose-500/20 text-rose-400 border border-rose-500/40">
            <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
            <span>REJECTED</span>
          </span>
        `;
      }

      return `
        <tr class="hover:bg-slate-200/50 dark:hover:bg-slate-800/40 transition-colors">
          <td class="py-2.5 pr-3 text-cyan-600 dark:text-cyan-400 font-bold" title="${cmd.id}">
            ${idShort}
          </td>
          <td class="py-2.5 px-3 text-slate-500 text-[11px]" title="${cmd.created_at}">
            ${formatTimeAgo(cmd.created_at || cmd.issued_at_ms)}
          </td>
          <td class="py-2.5 px-3">
            <span class="px-2 py-0.5 rounded text-[10px] font-bold ${stateBadgeClass}">
              ${state}
            </span>
          </td>
          <td class="py-2.5 px-3 text-slate-700 dark:text-slate-300 max-w-xs truncate" title="${cmd.reason}">
            ${cmd.reason || '--'}
          </td>
          <td class="py-2.5 px-3 text-right font-bold text-slate-800 dark:text-slate-200">
            ${cmd.target_nav_usd ? formatUsd(Number(cmd.target_nav_usd)) : '--'}
          </td>
          <td class="py-2.5 px-3 text-center">
            ${statusBadge}
          </td>
          <td class="py-2.5 pl-3 text-right text-slate-500 text-[10px]" title="${cmd.hmac_signature}">
            ${hmacShort}
          </td>
        </tr>
      `;
    }).join('');

    tbody.innerHTML = html;
  }

  // ==========================================
  // EVENT LISTENERS & C2 MODAL HANDLING
  // ==========================================
  function setupEventListeners(accessToken: string) {
    const refreshBtn = document.getElementById('refresh-btn');
    refreshBtn?.addEventListener('click', async () => {
      await fetchAndRenderAll(accessToken, false);
    });

    // Copy AI Snapshot button
    const copySatBtn = document.getElementById('copy-sat-snapshot-btn');
    const copySatLabel = document.getElementById('copy-sat-snapshot-label');
    copySatBtn?.addEventListener('click', async () => {
      const activeVenue = getActiveVenue();
      const md = buildSatelliteMarkdownSnapshot({
        latestRow: latestTelemetryRow || {},
        historyRows: telemetryHistoryRows,
        latestCoreRow: latestCoreRow,
        recentCommands: recentCommands,
        venue: activeVenue,
      });

      const ok = await copyTextToClipboard(md);
      if (ok) {
        if (copySatLabel) copySatLabel.textContent = 'Copied!';
        setTimeout(() => {
          if (copySatLabel) copySatLabel.textContent = 'Copy AI Snapshot';
        }, 2000);
        showDiagnosticToast('[OK] Quant-Satellite AI Snapshot copied to clipboard!');
      } else {
        showDiagnosticToast('[ERROR] Failed to copy to clipboard', true);
      }
    });

    // Export JSON button
    const exportSatJsonBtn = document.getElementById('export-sat-json-btn');
    exportSatJsonBtn?.addEventListener('click', () => {
      const activeVenue = getActiveVenue();
      const auditJson = normalizeSatelliteSnapshot({
        latestRow: latestTelemetryRow || {},
        historyRows: telemetryHistoryRows,
        latestCoreRow: latestCoreRow,
        recentCommands: recentCommands,
        venue: activeVenue,
      });

      const barIdx = latestTelemetryRow?.bar_idx ?? 0;
      triggerJsonDownload(`quant_satellite_audit_bar_${barIdx}.json`, auditJson);
      showDiagnosticToast(`[OK] quant_satellite_audit_bar_${barIdx}.json downloaded!`);
    });

    // Environment Switchers (Paper / Live)
    const satPaperBtn = document.getElementById('sat-env-paper-btn');
    const satLiveBtn = document.getElementById('sat-env-live-btn');

    satPaperBtn?.addEventListener('click', async () => {
      const current = getActiveVenue();
      if (current === 'paper') return;
      setActiveVenue('paper');
      updateSatEnvButtons('paper');
      await fetchAndRenderAll(accessToken, false);
    });

    satLiveBtn?.addEventListener('click', async () => {
      const current = getActiveVenue();
      if (current === 'live') return;
      setActiveVenue('live');
      updateSatEnvButtons('live');
      await fetchAndRenderAll(accessToken, false);
    });

    window.addEventListener('quant:venue-change', async (e: Event) => {
      const customEvt = e as CustomEvent<{ venue: TradingVenue }>;
      const nextVenue = customEvt.detail?.venue;
      if (nextVenue) {
        updateSatEnvButtons(nextVenue);
        await fetchAndRenderAll(accessToken, false);
      }
    });

    // Calculator Inputs
    const coreInput = document.getElementById('core-balance-input') as HTMLInputElement | null;
    const salaryInput = document.getElementById('salary-deposit-input') as HTMLInputElement | null;
    const resetCoreLiveBtn = document.getElementById('reset-core-live-btn');

    coreInput?.addEventListener('input', () => {
      if (coreInput) coreInput.dataset.userEdited = 'true';
      updateCalculatorOutputs();
    });

    salaryInput?.addEventListener('input', () => {
      updateCalculatorOutputs();
    });

    resetCoreLiveBtn?.addEventListener('click', () => {
      if (liveAlpacaCoreNav != null && coreInput) {
        delete coreInput.dataset.userEdited;
        coreInput.value = liveAlpacaCoreNav.toFixed(2);
        updateCalculatorOutputs();
      }
    });

    // Reason length counter
    const reasonInput = document.getElementById('c2-reason-input') as HTMLInputElement | null;
    const charCount = document.getElementById('reason-char-count');
    reasonInput?.addEventListener('input', () => {
      if (charCount && reasonInput) {
        charCount.textContent = `${reasonInput.value.length} / 250`;
      }
    });

    // Feedback close button
    const fbBanner = document.getElementById('c2-feedback-banner');
    const fbClose = document.getElementById('c2-feedback-close');
    fbClose?.addEventListener('click', () => {
      fbBanner?.classList.add('hidden');
    });

    // Modal elements
    const modal = document.getElementById('c2-modal');
    const modalStateBadge = document.getElementById('modal-target-state-badge');
    const modalTargetNav = document.getElementById('modal-target-nav');
    const modalReason = document.getElementById('modal-reason');
    const modalCancelBtn = document.getElementById('modal-cancel-btn');
    const modalCloseBtn = document.getElementById('modal-close-btn');
    const modalConfirmBtn = document.getElementById('modal-confirm-btn');
    const modalConfirmSpinner = document.getElementById('modal-confirm-spinner');
    const modalConfirmLabel = document.getElementById('modal-confirm-label');

    function closeModal() {
      modal?.classList.add('hidden');
      pendingTargetState = '';
    }

    [modalCancelBtn, modalCloseBtn].forEach(b => b?.addEventListener('click', closeModal));

    // C2 Action Buttons
    const actionBtns = document.querySelectorAll('.c2-action-btn');
    actionBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const reason = reasonInput?.value.trim() || '';
        if (!reason) {
          if (reasonInput) {
            reasonInput.classList.add('border-rose-500', 'ring-2', 'ring-rose-500/30');
            reasonInput.focus();
            setTimeout(() => {
              reasonInput.classList.remove('border-rose-500', 'ring-2', 'ring-rose-500/30');
            }, 3000);
          }
          showFeedback('Please provide a Reason / Audit Note before dispatching a state transition.', 'error');
          return;
        }

        const targetState = btn.getAttribute('data-target-state') || '';
        const stateLabel = btn.getAttribute('data-state-label') || targetState;
        const stateColor = btn.getAttribute('data-state-color') || 'cyan';
        const targetNavInput = document.getElementById('c2-target-nav-input') as HTMLInputElement | null;
        const targetNavVal = targetNavInput?.value ? Number(targetNavInput.value) : null;

        pendingTargetState = targetState;

        if (modalStateBadge) {
          modalStateBadge.textContent = stateLabel;
          modalStateBadge.className = `px-2 py-0.5 rounded font-bold text-xs bg-${stateColor}-500/20 text-${stateColor}-400 border border-${stateColor}-500/40`;
        }

        if (modalTargetNav) {
          modalTargetNav.textContent = targetNavVal ? formatUsd(targetNavVal) : 'Unchanged (Current Balance)';
        }

        if (modalReason) {
          modalReason.textContent = `"${reason}"`;
        }

        modal?.classList.remove('hidden');
      });
    });

    // Confirm button in modal -> POST /api/quant/command
    modalConfirmBtn?.addEventListener('click', async () => {
      if (!pendingTargetState) return;

      const reason = reasonInput?.value.trim() || '';
      const targetNavInput = document.getElementById('c2-target-nav-input') as HTMLInputElement | null;
      const targetNavVal = targetNavInput?.value ? Number(targetNavInput.value) : null;

      // Loading state in modal
      modalConfirmSpinner?.classList.remove('hidden');
      if (modalConfirmLabel) modalConfirmLabel.textContent = 'Transmitting...';
      if (modalConfirmBtn) (modalConfirmBtn as HTMLButtonElement).disabled = true;

      try {
        const res = await fetch('/api/quant/command', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${accessToken}`,
          },
          body: JSON.stringify({
            target_state: pendingTargetState,
            reason: reason,
            target_nav_usd: targetNavVal,
          }),
        });

        const data = await res.json();

        if (!res.ok || !data.ok) {
          throw new Error(data.error || 'Failed to dispatch command');
        }

        closeModal();
        showFeedback(`Successfully dispatched ${pendingTargetState} (Command ID: ${data.command_id.substring(0, 8)}...). Written to audit log.`, 'success');

        // Clear input fields
        if (reasonInput) reasonInput.value = '';
        if (targetNavInput) targetNavInput.value = '';
        if (charCount) charCount.textContent = '0 / 250';

        // Refresh dashboard
        await fetchAndRenderAll(accessToken, false);
      } catch (err: any) {
        showFeedback(`Error dispatching C2 command: ${err.message}`, 'error');
      } finally {
        modalConfirmSpinner?.classList.add('hidden');
        if (modalConfirmLabel) modalConfirmLabel.textContent = 'Confirm & Transmit';
        if (modalConfirmBtn) (modalConfirmBtn as HTMLButtonElement).disabled = false;
      }
    });
  }

  function showFeedback(msg: string, type: 'success' | 'error') {
    const banner = document.getElementById('c2-feedback-banner');
    const msgEl = document.getElementById('c2-feedback-msg');
    if (!banner || !msgEl) return;

    msgEl.textContent = msg;
    banner.classList.remove('hidden');

    if (type === 'success') {
      banner.className = 'p-3.5 rounded-xl font-mono text-xs flex items-center justify-between bg-emerald-500/15 text-emerald-400 border border-emerald-500/40';
    } else {
      banner.className = 'p-3.5 rounded-xl font-mono text-xs flex items-center justify-between bg-rose-500/15 text-rose-400 border border-rose-500/40';
    }

    setTimeout(() => {
      banner.classList.add('hidden');
    }, 8000);
  }

  document.addEventListener('astro:page-load', loadQuantSatelliteDashboard);
</script>
