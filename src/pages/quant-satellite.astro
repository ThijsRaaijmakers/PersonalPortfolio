    const norm = normalizeTelemetryRow(latest);
    if (!norm) return;

    const nav = Number(norm.nav_usd) || 0;
    const wallet = Number(norm.wallet_balance_usd) || 0;
    const upnl = Number(norm.unrealized_pnl_usd) || 0;
    const rpnl = Number(norm.realized_pnl_usd) || 0;
