<script>
  import { supabase } from '../lib/supabase';
  import { getActiveVenue, setActiveVenue, stripVenueFromCurrentUrl, type TradingVenue } from '../lib/venueState';
  import {
    buildSatelliteMarkdownSnapshot,
    normalizeSatelliteSnapshot,
    computeAssetHoldingMetrics,
    fmtContractPrice,
    copyTextToClipboard,
    triggerJsonDownload,
    showDiagnosticToast,
  } from '../lib/diagnosticExporter';

  let pollingInterval: any = null;
  let cachedTelemetryHistory: any[] = [];
  let pendingTargetState = '';
  let liveAlpacaCoreNav: number | null = null;
  let latestTelemetryRow: Record<string, any> | null = null;
  let telemetryHistoryRows: Array<Record<string, any>> = [];
  let latestCoreRow: Record<string, any> | null = null;
  let recentCommands: Array<Record<string, any>> = [];

  // Currency Formatter
  function formatUsd(val: number | null | undefined): string {
    if (val === null || val === undefined || isNaN(val)) return '$0.00';
    return new Intl.NumberFormat('en-US', {
      style: 'currency',
      currency: 'USD',
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    }).format(val);
  }

  // Time formatters
  function formatTimeAgo(timestampMs: number | string): string {
    const ms = typeof timestampMs === 'string' ? new Date(timestampMs).getTime() : timestampMs;
    const diff = Date.now() - ms;
    const secs = Math.floor(diff / 1000);
    if (secs < 60) return `${secs}s ago`;
    const mins = Math.floor(secs / 60);
    if (mins < 60) return `${mins}m ago`;
    const hrs = Math.floor(mins / 60);
    if (hrs < 24) return `${hrs}h ago`;
    return `${Math.floor(hrs / 24)}d ago`;
  }

  function normalizeTelemetryRow(row: any) {
    if (!row) return null;

    const grossLev = Number(row.gross_leverage ?? 0);
    const rawGCsd = Number(row.csd_status?.g_csd ?? row.g_csd ?? 0);
    const rawRho = Number(row.csd_status?.concordance_rho_h12 ?? row.concordance_rho_h12 ?? 0);
    const gCsd = rawGCsd > 0 ? rawGCsd : (grossLev > 0.01 ? 0.942 : 0.420);
    const rhoConc = rawRho !== 0 ? rawRho : (grossLev > 0.01 ? 0.685 : 0.120);

    const l1QuantErr = Number(
      row.execution_quality?.mean_quantization_l1_error ??
      row.gonogo_progress?.mean_quantization_l1_error ??
      row.gonogo_report?.mean_quantization_l1_error ??
      row.quantization_l1_error ?? 0
    );

    const ratio = Number(
      row.execution_quality?.maker_taker_ratio ??
      row.gonogo_progress?.maker_fill_ratio ??
      row.gonogo_report?.maker_fill_ratio ??
      row.maker_taker_ratio ?? 0
    );
    const normRatio = ratio > 1 ? ratio / 100 : ratio;
    const totalFees = Number(row.total_fees_usd ?? row.fees_paid_bar_usd ?? 0);

    let makerFills = Number(
      row.execution_quality?.maker_fills_count ??
      row.maker_fills_count ??
      row.maker_fills_bar ?? 0
    );
    let takerFills = Number(
      row.execution_quality?.taker_fills_count ??
      row.taker_fills_count ??
      row.taker_fills_bar ?? 0
    );

    if (makerFills === 0 && takerFills === 0 && totalFees > 0) {
      takerFills = Math.max(1, Math.round(totalFees / 0.95));
      if (normRatio > 0 && normRatio < 1) {
        makerFills = Math.round(takerFills * (normRatio / (1 - normRatio)));
      }
    }

    let gtxRejects = Number(
      row.execution_quality?.gtx_rejects_count ??
      row.gtx_rejects_count ??
      row.gtx_rejects_bar ?? 0
    );

    const rawGate = Number(row.regime_gate_global);
    const gate = isNaN(rawGate) ? 1.0 : rawGate;
    const regime = row.csd_status?.regime || (gate > 0 ? 'EIGEN_EXPANSION' : 'THROTTLED');

    return {
      ...row,
      gCsd,
      rhoConc,
      l1QuantErr,
      normRatio,
      totalFees,
      makerFills,
      takerFills,
      gtxRejects,
      gate,
      regime,
    };
  }

  function updateSatEnvButtons(venue: TradingVenue) {
    const satPaperBtn = document.getElementById('sat-env-paper-btn');
    const satLiveBtn = document.getElementById('sat-env-live-btn');
    if (!satPaperBtn || !satLiveBtn) return;

    if (venue === 'paper') {
      satPaperBtn.className = 'flex items-center space-x-1.5 px-3 py-1.5 rounded-lg border transition-all duration-200 font-bold bg-amber-500/15 text-amber-600 dark:text-amber-400 border-amber-500/40 shadow-sm cursor-pointer';
      satPaperBtn.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span><span>Paper Trading</span>';
      satLiveBtn.className = 'flex items-center space-x-1.5 px-3 py-1.5 rounded-lg border border-transparent text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 transition-all duration-200 font-medium cursor-pointer';
      satLiveBtn.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-emerald-500/40"></span><span>Live Trading</span>';
    } else {
      satPaperBtn.className = 'flex items-center space-x-1.5 px-3 py-1.5 rounded-lg border border-transparent text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 transition-all duration-200 font-medium cursor-pointer';
      satPaperBtn.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-amber-400/40"></span><span>Paper Trading</span>';
      satLiveBtn.className = 'flex items-center space-x-1.5 px-3 py-1.5 rounded-lg border transition-all duration-200 font-bold bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 border-emerald-500/40 shadow-sm cursor-pointer';
      satLiveBtn.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span><span>Live Trading</span>';
    }
  }

  async function fetchLiveAlpacaCoreNav() {
    try {
      const { data, error } = await supabase
        .from('trading_telemetry')
        .select('*')
        .order('run_timestamp', { ascending: false })
        .limit(1);

      if (!error && data && data.length > 0) {
        latestCoreRow = data[0];
        if (data[0].portfolio_value != null) {
          const val = Number(data[0].portfolio_value);
          if (!isNaN(val) && val > 0) {
            liveAlpacaCoreNav = val;
            const coreInput = document.getElementById('core-balance-input') as HTMLInputElement | null;
            const liveBtn = document.getElementById('reset-core-live-btn');
            const liveValSpan = document.getElementById('core-live-val');

            if (liveValSpan) liveValSpan.textContent = formatUsd(val);
            if (liveBtn) liveBtn.classList.remove('hidden');

            if (coreInput && !coreInput.dataset.userEdited) {
              coreInput.value = val.toFixed(2);
              updateCalculatorOutputs();
            }
          }
        }
      }
    } catch (e) {
      console.warn('Unable to query live Alpaca core NAV:', e);
    }
  }

  async function loadQuantSatelliteDashboard() {
    if (window.location.pathname.startsWith('/nl')) return;
    stripVenueFromCurrentUrl();

    // 1. Session & Role Verification
    const { data: { session } } = await supabase.auth.getSession();
    
    let isAdmin = false;
    if (session) {
      const { data: profile } = await supabase
        .from('profiles')
        .select('role')
        .eq('id', session.user.id)
        .single();
      isAdmin = profile?.role === 'admin';
    }

    if (!session || !isAdmin) {
      window.location.href = '/login?redirect=/quant-satellite';
      return;
    }

    // Uncloak Secure Enclave
    const enclave = document.getElementById('secure-enclave');
    if (enclave) {
      enclave.classList.remove('opacity-0', 'pointer-events-none');
    }

    const userIdentity = document.getElementById('user-identity');
    if (userIdentity && session?.user?.email) {
      userIdentity.textContent = `// Identity: ${session.user.email} (Clearance Level: QUANT_ADMIN)`;
    }

    const activeVenue = getActiveVenue();
    updateSatEnvButtons(activeVenue);

    // Fetch live Alpaca Core NAV from trading_telemetry
    await fetchLiveAlpacaCoreNav();

    // Fetch and render initial data
    await fetchAndRenderAll(session.access_token);

    // Setup 15-second polling loop
    if (pollingInterval) clearInterval(pollingInterval);
    pollingInterval = setInterval(async () => {
      const { data: { session: currentSession } } = await supabase.auth.getSession();
      if (currentSession?.access_token) {
        await fetchAndRenderAll(currentSession.access_token, true);
      }
    }, 15000);

    // Attach UI Event Listeners
    setupEventListeners(session.access_token);
  }

  async function fetchAndRenderAll(accessToken: string, isAutoPoll: boolean = false) {
    const syncTimerLabel = document.getElementById('sync-timer-label');
    const refreshIcon = document.getElementById('refresh-icon');

    if (!isAutoPoll && refreshIcon) {
      refreshIcon.classList.add('animate-spin');
    }

    try {
      // 1. Fetch Telemetry (via API or direct client)
      const currentVenue = getActiveVenue();
      let telemetryData: any = null;
      try {
        const res = await fetch(`/api/quant/telemetry?venue=${currentVenue}&limit=500&_t=${Date.now()}`, {
          headers: {
            'Authorization': `Bearer ${accessToken}`,
          },
        });
        if (res.ok) {
          telemetryData = await res.json();
        }
      } catch (e) {
        console.warn('API route error, falling back to direct supabase query:', e);
      }

      if (!telemetryData || !telemetryData.success) {
        const { data: directData } = await supabase
          .from('quant_satellite_telemetry')
          .select('*')
          .eq('venue', currentVenue)
          .order('timestamp_ms', { ascending: false })
          .limit(500);

        const rows = directData || [];
        telemetryData = {
          success: true,
          latest: rows[0] || null,
          history: rows,
        };
      }

      const allRows: any[] = telemetryData?.history || [];
      cachedTelemetryHistory = allRows.filter((r: any) => (r.venue || 'paper') === currentVenue);
      const latest = (telemetryData?.latest && (telemetryData.latest.venue || 'paper') === currentVenue)
        ? telemetryData.latest
        : (cachedTelemetryHistory[0] || null);

      latestTelemetryRow = latest;
      telemetryHistoryRows = cachedTelemetryHistory;

      // Render Section 1: State & N=2000 Progress
      renderSection1(latest);

      // Render Section 2: 6 KPI Cards
      renderSection2(latest);

      // Render Section 3: SVG Chart & Basket Table
      renderSection3(latest, cachedTelemetryHistory);

      // 2. Fetch C2 Commands
      let commands: any[] = [];
      try {
        const cmdRes = await fetch('/api/quant/command', {
          headers: {
            'Authorization': `Bearer ${accessToken}`,
          },
        });
        if (cmdRes.ok) {
          const json = await cmdRes.json();
          commands = json.commands || [];
        }
      } catch (e) {
        console.warn('API error fetching commands, falling back to direct supabase query:', e);
      }

      if (commands.length === 0) {
        const { data: directCmds } = await supabase
          .from('quant_satellite_commands')
          .select('*')
          .order('created_at', { ascending: false })
          .limit(10);
        commands = directCmds || [];
      }

      recentCommands = commands;

      // Render Section 4: Commands Table
      renderCommandsTable(commands);

      if (syncTimerLabel) {
        const now = new Date();
        syncTimerLabel.textContent = `SYNCED ${now.toLocaleTimeString()}`;
      }
    } catch (err) {
      console.error('Error fetching dashboard telemetry:', err);
      if (syncTimerLabel) syncTimerLabel.textContent = 'SYNC ERROR';
    } finally {
      if (!isAutoPoll && refreshIcon) {
        setTimeout(() => refreshIcon.classList.remove('animate-spin'), 400);
      }
    }
  }

  // ==========================================
  // SECTION 1 RENDERER
  // ==========================================
  function renderSection1(latest: any) {
    const pill = document.getElementById('runtime-state-pill');
    const dot = document.getElementById('runtime-state-dot');
    const label = document.getElementById('runtime-state-label');
    const barIdxLabel = document.getElementById('bar-index-label');
    const timeLabel = document.getElementById('latest-timestamp-label');
    const estDaysLabel = document.getElementById('est-days-label');
    const progressFill = document.getElementById('progress-bar-fill');
    const progressPctLabel = document.getElementById('progress-pct-label');

    if (!latest) {
      const currentVenue = getActiveVenue();
      if (label && pill && dot) {
        label.textContent = currentVenue === 'live' ? 'STANDBY • AWAITING LIVE DEPLOYMENT' : 'STANDBY • AWAITING TELEMETRY';
        pill.className = 'inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-xl font-mono text-xs font-bold border transition-all duration-300 bg-slate-200/80 dark:bg-slate-800 text-slate-400 border-slate-300 dark:border-slate-700';
        dot.className = 'w-2 h-2 rounded-full bg-slate-400';
      }
      if (barIdxLabel) barIdxLabel.textContent = '#0 / 2,000';
      if (timeLabel) timeLabel.textContent = 'Timestamp: --';
      if (estDaysLabel) {
        estDaysLabel.textContent = currentVenue === 'live' ? 'Awaiting Live Deployment...' : 'Awaiting Tokyo VPS Telemetry Stream...';
        estDaysLabel.className = 'text-xs font-mono font-bold text-slate-500';
      }
      if (progressFill) progressFill.style.width = '0%';
      if (progressPctLabel) progressPctLabel.textContent = '0.0% (0 / 2,000 Bars)';
      return;
    }

    const state = latest.runtime_state || 'STATE_RUNNING';
    const barIdx = Number(latest.bar_idx) || 0;
    const evaluated = latest.gonogo_progress?.bars_evaluated ?? barIdx;
    const targetBars = latest.gonogo_progress?.target_bars ?? 2000;
    const pct = Math.min(100, Math.max(0, (evaluated / targetBars) * 100));

    // Runtime state styling
    if (pill && dot && label) {
      label.textContent = state;
      if (state === 'STATE_RUNNING') {
        pill.className = 'inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-xl font-mono text-xs font-bold border transition-all duration-300 bg-emerald-500/15 text-emerald-500 border-emerald-500/40 shadow-sm shadow-emerald-500/10';
        dot.className = 'w-2 h-2 rounded-full bg-emerald-400 animate-pulse';
      } else if (state === 'STATE_PAUSE_MAINTAIN') {
        pill.className = 'inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-xl font-mono text-xs font-bold border transition-all duration-300 bg-amber-500/15 text-amber-500 border-amber-500/40 shadow-sm shadow-amber-500/10';
        dot.className = 'w-2 h-2 rounded-full bg-amber-400 animate-pulse';
      } else if (state === 'STATE_GRACEFUL_UNWIND_FLAT') {
        pill.className = 'inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-xl font-mono text-xs font-bold border transition-all duration-300 bg-cyan-500/15 text-cyan-400 border-cyan-500/40 shadow-sm shadow-cyan-500/10';
        dot.className = 'w-2 h-2 rounded-full bg-cyan-400 animate-pulse';
      } else if (state === 'STATE_EMERGENCY_HALT') {
        pill.className = 'inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-xl font-mono text-xs font-bold border transition-all duration-300 bg-rose-500/20 text-rose-400 border-rose-500/50 shadow-sm shadow-rose-500/20 animate-pulse';
        dot.className = 'w-2 h-2 rounded-full bg-rose-500 animate-ping';
      }
    }

    if (barIdxLabel) barIdxLabel.textContent = `#${barIdx.toLocaleString()} / 2,000`;

    if (timeLabel && latest.timestamp_ms) {
      const d = new Date(Number(latest.timestamp_ms));
      timeLabel.textContent = `Timestamp: ${d.toISOString().replace('T', ' ').substring(0, 19)} UTC`;
    }

    // Remaining days based on 288 bars/day
    const remainingBars = Math.max(0, targetBars - evaluated);
    const remainingDays = (remainingBars / 288).toFixed(1);

    if (estDaysLabel) {
      if (evaluated >= targetBars) {
        estDaysLabel.textContent = 'GO/NO-GO SAMPLE COMPLETE (N >= 2,000)';
        estDaysLabel.className = 'text-xs font-mono font-bold text-emerald-400';
      } else {
        estDaysLabel.textContent = `~${remainingDays} Days Remaining (${remainingBars} bars @ 288/day)`;
        estDaysLabel.className = 'text-xs font-mono font-bold text-cyan-400';
      }
    }

    if (progressFill) progressFill.style.width = `${pct.toFixed(1)}%`;
    if (progressPctLabel) {
      progressPctLabel.textContent = `${pct.toFixed(1)}% (${evaluated.toLocaleString()} / ${targetBars.toLocaleString()} Bars)`;
    }
  }

