---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import WorkspaceNav from '../components/WorkspaceNav.astro';
import { supabase } from '../lib/supabase';

// Server-side profile check for admin clearance
const { data: { session } } = await supabase.auth.getSession();
let userEmail = '';

if (session) {
  userEmail = session.user.email || '';
  const { data: profile } = await supabase
    .from('profiles')
    .select('role')
    .eq('id', session.user.id)
    .single();

  if (profile?.role !== 'admin') {
    return Astro.redirect('/');
  }
}
---

<Layout 
  description="Autonomous Quant Satellite v2.5 Telemetry Dashboard and Tokyo VPS Command & Control Enclave." 
  title="Quant Satellite v2.5 | Autonomous Telemetry & C2 Console"
>
  <div id="secure-enclave" class="max-w-7xl mx-auto py-8 sm:py-12 space-y-8 animate-fade-in-up opacity-0 pointer-events-none transition-opacity duration-300">
    
    <!-- Breadcrumbs -->
    <Breadcrumbs 
      items={[
        { label: 'Home', href: '/' },
        { label: 'Dashboard', href: '/dashboard' },
        { label: 'Quant Satellite v2.5' }
      ]} 
    />

    <!-- Administrative Workspace Navigation -->
    <WorkspaceNav activeTab="quant-satellite" />

    <!-- Top Bar / Header Section -->
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 border-b border-slate-300 dark:border-slate-800 pb-6 min-w-0">
      <div class="space-y-1.5 min-w-0">
        <div class="flex items-center space-x-2.5 flex-wrap gap-y-1">
          <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-cyan-950/10 dark:bg-cyan-950/60 border border-cyan-500/30 font-mono text-xs text-cyan-600 dark:text-cyan-400">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>QUANT SATELLITE v2.5 &bull; TOKYO VPS C2</span>
          </div>

          <span 
            id="admin-badge" 
            class="inline-flex items-center space-x-1.5 px-2.5 py-0.5 rounded bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border border-cyan-500/30 font-mono text-[10px] font-bold tracking-wider uppercase shadow-sm shadow-cyan-500/10"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-ping"></span>
            <span>ADMIN CLEARANCE</span>
          </span>

          <span 
            id="sync-status-badge"
            class="inline-flex items-center space-x-1.5 px-2.5 py-0.5 rounded bg-slate-200/80 dark:bg-slate-800/80 text-slate-600 dark:text-slate-400 border border-slate-300 dark:border-slate-700 font-mono text-[10px]"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            <span id="sync-timer-label">LIVE 15s SYNC</span>
          </span>
        </div>

        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-slate-50 font-sans tracking-tight">
          Quant Satellite v2.5 Telemetry & C2 Cockpit
        </h1>
        <p id="user-identity" class="text-xs font-mono text-slate-500 dark:text-slate-400">
          {userEmail ? `// Identity: ${userEmail} (Clearance Level: QUANT_ADMIN)` : '// Identity: Authenticating...'}
        </p>
      </div>
      
      <!-- Right Action Controls -->
      <div class="flex flex-wrap items-center gap-3">
        <!-- Environment Filter Switcher Toggle -->
        <div class="inline-flex p-1 rounded-xl bg-slate-100/90 dark:bg-slate-950/80 border border-slate-300 dark:border-slate-800 text-xs font-mono shadow-sm">
          <button 
            id="sat-env-paper-btn" 
            type="button"
            class="flex items-center space-x-1.5 px-3 py-1.5 rounded-lg border transition-all duration-200 font-bold bg-amber-500/15 text-amber-600 dark:text-amber-400 border-amber-500/40 shadow-sm cursor-pointer"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
            <span>Paper Trading</span>
          </button>
          <button 
            id="sat-env-live-btn" 
            type="button"
            class="flex items-center space-x-1.5 px-3 py-1.5 rounded-lg border border-transparent text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 transition-all duration-200 font-medium cursor-pointer"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500/40"></span>
            <span>Live Trading</span>
          </button>
        </div>

        <!-- Diagnostic Export Pill -->
        <div class="inline-flex items-center rounded-lg border border-cyan-500/30 bg-cyan-950/10 dark:bg-cyan-950/40 p-0.5 shadow-sm">
          <button
            id="copy-sat-snapshot-btn"
            type="button"
            title="Copy structured Markdown diagnostic snapshot for AI analysis"
            class="px-3 py-1.5 rounded-md bg-cyan-500/15 hover:bg-cyan-500/25 text-cyan-700 dark:text-cyan-300 font-mono text-xs font-bold transition-colors cursor-pointer flex items-center space-x-1.5"
          >
            <svg class="w-3.5 h-3.5 text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/>
            </svg>
            <span id="copy-sat-snapshot-label">Copy AI Snapshot</span>
          </button>
          <button
            id="export-sat-json-btn"
            type="button"
            title="Download full JSON audit file"
            class="px-2.5 py-1.5 rounded-md hover:bg-slate-200/60 dark:hover:bg-slate-800/80 text-slate-600 dark:text-slate-400 font-mono text-[11px] font-semibold transition-colors cursor-pointer flex items-center space-x-1"
          >
            <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
            </svg>
            <span>JSON</span>
          </button>
        </div>

        <button 
          id="refresh-btn" 
          class="px-4 py-2 rounded-lg bg-cyan-950/20 dark:bg-cyan-950/50 hover:bg-cyan-900/30 text-cyan-600 dark:text-cyan-400 border border-cyan-500/40 font-mono text-xs font-bold transition-all flex items-center space-x-2 shadow-sm cursor-pointer"
        >
          <svg id="refresh-icon" class="w-3.5 h-3.5 text-cyan-500 transition-transform duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          <span id="refresh-label">Sync Telemetry</span>
        </button>

        <a 
          href="/trading" 
          class="px-4 py-2 rounded-lg bg-slate-100/80 dark:bg-slate-900 hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-300 dark:border-slate-800 font-mono text-xs font-semibold transition-colors flex items-center space-x-2 shadow-sm"
        >
          <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
          </svg>
          <span>Trading Desk (Core)</span>
        </a>
      </div>
    </div>

    <!-- ========================================== -->
    <!-- SECTION 1: TOP STATUS & N=2.000 PROGRESS   -->
    <!-- ========================================== -->
    <div class="rounded-2xl p-5 sm:p-6 bg-slate-50/90 dark:bg-slate-900/60 border border-slate-300 dark:border-slate-800 shadow-xl space-y-4">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <!-- Runtime State Pill -->
        <div class="flex items-center space-x-3 flex-wrap gap-y-2">
          <div class="text-xs font-mono text-slate-500 dark:text-slate-400">
            // RUNTIME STATE:
          </div>
          <div 
            id="runtime-state-pill" 
            class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-xl font-mono text-xs font-bold border transition-all duration-300 bg-slate-200/80 dark:bg-slate-800 text-slate-400 border-slate-300 dark:border-slate-700"
          >
            <span id="runtime-state-dot" class="w-2 h-2 rounded-full bg-slate-400"></span>
            <span id="runtime-state-label">INITIALIZING...</span>
          </div>

          <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-lg bg-slate-100 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 font-mono text-xs text-slate-700 dark:text-slate-300">
            <span class="text-slate-500">Bar Index:</span>
            <span id="bar-index-label" class="font-bold text-cyan-600 dark:text-cyan-400">#-- / 2,000</span>
          </div>

          <div class="text-[11px] font-mono text-slate-500">
            <span id="latest-timestamp-label">Timestamp: --</span>
          </div>
        </div>

        <!-- Estimated Days Remaining -->
        <div class="text-right">
          <div id="est-days-label" class="text-xs font-mono font-bold text-cyan-600 dark:text-cyan-400">
            Estimating Go/No-Go Window...
          </div>
          <div class="text-[10px] font-mono text-slate-500">
            Based on 288 master bars/day (5-min intervals)
          </div>
        </div>
      </div>

      <!-- N=2000 Progress Bar -->
      <div class="space-y-1.5">
        <div class="flex items-center justify-between text-xs font-mono">
          <span class="text-slate-600 dark:text-slate-400 flex items-center space-x-1.5">
            <span>N=2,000 Go/No-Go Statistical Validation Sample</span>
            <span class="text-[10px] text-slate-500">(Target: 2,000 Out-of-Sample Bars)</span>
          </span>
          <span id="progress-pct-label" class="font-bold text-cyan-600 dark:text-cyan-400">
            0.0% (0 / 2,000 Bars)
          </span>
        </div>

        <div class="w-full bg-slate-200 dark:bg-slate-950 rounded-full h-3.5 border border-slate-300 dark:border-slate-800 p-0.5 overflow-hidden">
          <div 
            id="progress-bar-fill" 
            class="h-full rounded-full bg-gradient-to-r from-cyan-500 via-emerald-400 to-cyan-400 transition-all duration-700 shadow-sm shadow-cyan-500/20"
            style="width: 0%"
          ></div>
        </div>

        <!-- Milestone Markers -->
        <div class="flex justify-between text-[10px] font-mono text-slate-500 px-0.5">
          <span>0 (Deploy)</span>
          <span>500 (25%)</span>
          <span>1,000 (Mid Checkpoint)</span>
          <span>1,500 (75%)</span>
          <span class="font-bold text-emerald-500">2,000 (Go/No-Go Decision Gate)</span>
        </div>
      </div>
    </div>

    <!-- ========================================== -->
    <!-- SECTION 2: 6 KPI TELEMETRY CARDS          -->
    <!-- ========================================== -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5 sm:gap-6">
      
      <!-- Card 1: Mark-to-Market NAV -->
      <div class="p-5 sm:p-6 rounded-2xl bg-slate-50/90 dark:bg-slate-900/60 border border-slate-300 dark:border-slate-800 shadow-xl flex flex-col justify-between space-y-4">
        <div>
          <div class="flex items-center justify-between gap-2 mb-2">
            <div class="flex items-center space-x-1.5">
              <span class="text-xs font-mono text-slate-500 uppercase tracking-wider">// MARK-TO-MARKET NAV</span>
              <div class="group relative inline-flex items-center cursor-help">
                <span class="inline-flex items-center justify-center w-3.5 h-3.5 rounded-full bg-slate-200 dark:bg-slate-800 text-[9px] font-mono font-bold text-slate-500 hover:text-cyan-400 hover:bg-slate-700 transition-colors">?</span>
                <div class="pointer-events-none absolute bottom-full left-0 mb-2 w-64 p-2.5 rounded-lg bg-slate-900/95 border border-slate-700 text-[11px] leading-relaxed text-slate-200 shadow-xl opacity-0 group-hover:opacity-100 transition-opacity z-50 font-sans font-normal normal-case">
                  Total live portfolio value in USD (Cash Wallet balance + unrealized profit/loss on open positions).
                </div>
              </div>
            </div>
            <span id="nav-badge" class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-cyan-500/15 text-cyan-600 dark:text-cyan-400 border border-cyan-500/30">
              SATELLITE MTM
            </span>
          </div>
          <div id="nav-usd-val" class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-slate-50 font-mono tracking-tight">
            $0.00
          </div>
        </div>

        <div class="space-y-2 pt-2 border-t border-slate-200 dark:border-slate-800/80 font-mono text-xs">
          <div class="flex justify-between items-center text-slate-600 dark:text-slate-400">
            <span>Wallet Balance (USDC/USDT):</span>
            <span id="wallet-balance-val" class="font-bold text-slate-900 dark:text-slate-200">$0.00</span>
          </div>
          <div class="flex justify-between items-center text-slate-600 dark:text-slate-400">
            <span class="flex items-center space-x-1">
              <span>Unrealized PnL:</span>
              <div class="group relative inline-flex items-center cursor-help">
                <span class="inline-flex items-center justify-center w-3 h-3 rounded-full bg-slate-200 dark:bg-slate-800 text-[8px] font-mono font-bold text-slate-500 hover:text-cyan-400 hover:bg-slate-700 transition-colors">?</span>
                <div class="pointer-events-none absolute bottom-full left-0 mb-1.5 w-64 p-2.5 rounded-lg bg-slate-900/95 border border-slate-700 text-[11px] leading-relaxed text-slate-200 shadow-xl opacity-0 group-hover:opacity-100 transition-opacity z-50 font-sans font-normal normal-case">
                  Unrealized PnL is the live floating profit/loss on your open basket. Realized PnL is the locked-in profit from closed trades.
                </div>
              </div>
            </span>
            <span id="unrealized-pnl-val" class="font-bold text-slate-500">$0.00</span>
          </div>
          <div class="flex justify-between items-center text-[11px] text-slate-500">
            <span>Realized PnL: <span id="realized-pnl-val" class="text-slate-400 font-bold">$0.00</span></span>
            <span>Fees: <span id="total-fees-val" class="text-slate-400 font-bold">$0.00</span></span>
          </div>
        </div>
      </div>

      <!-- Card 2: Drawdown & Tail Risk -->
      <div class="p-5 sm:p-6 rounded-2xl bg-slate-50/90 dark:bg-slate-900/60 border border-slate-300 dark:border-slate-800 shadow-xl flex flex-col justify-between space-y-4">
        <div>
          <div class="flex items-center justify-between gap-2 mb-2">
            <div class="flex items-center space-x-1.5">
              <span class="text-xs font-mono text-slate-500 uppercase tracking-wider">// DRAWDOWN &amp; TAIL RISK</span>
              <div class="group relative inline-flex items-center cursor-help">
                <span class="inline-flex items-center justify-center w-3.5 h-3.5 rounded-full bg-slate-200 dark:bg-slate-800 text-[9px] font-mono font-bold text-slate-500 hover:text-cyan-400 hover:bg-slate-700 transition-colors">?</span>
                <div class="pointer-events-none absolute bottom-full left-0 mb-2 w-64 p-2.5 rounded-lg bg-slate-900/95 border border-slate-700 text-[11px] leading-relaxed text-slate-200 shadow-xl opacity-0 group-hover:opacity-100 transition-opacity z-50 font-sans font-normal normal-case">
                  Drawdown measures decline from all-time peak NAV. Ulcer Index measures both depth and duration of interim drawdowns.
                </div>
              </div>
            </div>
            <span id="dd-badge" class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-emerald-500/15 text-emerald-500 border border-emerald-500/30">
              NOMINAL
            </span>
          </div>
          <div id="drawdown-pct-val" class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-slate-50 font-mono tracking-tight">
            0.00%
          </div>
        </div>

        <div class="space-y-2 pt-2 border-t border-slate-200 dark:border-slate-800/80 font-mono text-xs">
          <div class="flex justify-between items-center text-slate-600 dark:text-slate-400">
            <span>Ulcer Index (Quadratic Penalty):</span>
            <span id="ulcer-index-val" class="font-bold text-slate-900 dark:text-slate-200">0.00</span>
          </div>
          <div class="flex justify-between items-center text-slate-600 dark:text-slate-400">
            <span>Z-Stress Standard Score:</span>
            <span id="z-stress-val" class="font-bold text-slate-900 dark:text-slate-200">0.00</span>
          </div>
          <div class="flex justify-between items-center text-[11px] text-slate-500">
            <span>Circuit Stop Level:</span>
            <span class="text-rose-400 font-bold">-4.00% Daily Stop</span>
          </div>
        </div>
      </div>

      <!-- Card 3: Dual-Nullspace Neutrality -->
      <div class="p-5 sm:p-6 rounded-2xl bg-slate-50/90 dark:bg-slate-900/60 border border-slate-300 dark:border-slate-800 shadow-xl flex flex-col justify-between space-y-4">
        <div>
          <div class="flex items-center justify-between gap-2 mb-2">
            <div class="flex items-center space-x-1.5">
              <span class="text-xs font-mono text-slate-500 uppercase tracking-wider">// DUAL-NULLSPACE NEUTRALITY</span>
              <div class="group relative inline-flex items-center cursor-help">
                <span class="inline-flex items-center justify-center w-3.5 h-3.5 rounded-full bg-slate-200 dark:bg-slate-800 text-[9px] font-mono font-bold text-slate-500 hover:text-cyan-400 hover:bg-slate-700 transition-colors">?</span>
                <div class="pointer-events-none absolute bottom-full left-0 mb-2 w-64 p-2.5 rounded-lg bg-slate-900/95 border border-slate-700 text-[11px] leading-relaxed text-slate-200 shadow-xl opacity-0 group-hover:opacity-100 transition-opacity z-50 font-sans font-normal normal-case">
                  Measures sensitivity to market tail crashes (target &le; 0.035). By holding simultaneous Long and Short positions across coins, the portfolio remains market-neutral.
                </div>
              </div>
            </div>
            <span id="beta-badge" class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-emerald-500/15 text-emerald-500 border border-emerald-500/30">
              SAFE (&le; 0.035)
            </span>
          </div>
          <div class="flex items-baseline space-x-2">
            <div id="tail-beta-val" class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-slate-50 font-mono tracking-tight">
              0.000
            </div>
            <span class="text-xs font-mono text-slate-500">Realized Tail &beta;</span>
          </div>
        </div>

        <div class="space-y-2 pt-2 border-t border-slate-200 dark:border-slate-800/80 font-mono text-xs">
          <div class="flex justify-between items-center text-slate-600 dark:text-slate-400">
            <span>Net Dollar Exposure:</span>
            <span id="net-exposure-val" class="font-bold text-slate-900 dark:text-slate-200">$0.00</span>
          </div>
          <div class="flex justify-between items-center text-slate-600 dark:text-slate-400">
            <span>Gross Leverage:</span>
            <span id="gross-leverage-val" class="font-bold text-slate-900 dark:text-slate-200">0.00x</span>
          </div>
          <div class="flex justify-between items-center text-[11px] text-slate-500">
            <span>Projection Model:</span>
            <span class="text-cyan-400 font-bold">Orthogonal Nullspace</span>
          </div>
        </div>
      </div>

      <!-- Card 4: Layer-1 Regime & CSD Gate -->
      <div class="p-5 rounded-2xl bg-slate-50/90 dark:bg-slate-900/60 border border-slate-300 dark:border-slate-800 shadow-xl flex flex-col justify-between space-y-4">
        <div>
          <div class="flex items-center justify-between gap-2 mb-2">
            <div class="flex items-center space-x-1.5">
              <span class="text-xs font-mono text-slate-500 uppercase tracking-wider">// L1 REGIME &amp; CSD GATE</span>
              <div class="group relative inline-flex items-center cursor-help">
                <span class="inline-flex items-center justify-center w-3.5 h-3.5 rounded-full bg-slate-200 dark:bg-slate-800 text-[9px] font-mono font-bold text-slate-500 hover:text-cyan-400 hover:bg-slate-700 transition-colors">?</span>
                <div class="pointer-events-none absolute bottom-full left-0 mb-2 w-64 p-2.5 rounded-lg bg-slate-900/95 border border-slate-700 text-[11px] leading-relaxed text-slate-200 shadow-xl opacity-0 group-hover:opacity-100 transition-opacity z-50 font-sans font-normal normal-case">
                  Monitors whether there is sufficient cross-sectional dispersion (CSD) across the 6 assets, and whether the sequence AI (TCN-Mamba) and tree model (LightGBM) agree.
                </div>
              </div>
            </div>
            <span id="csd-badge" class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-emerald-500/15 text-emerald-500 border border-emerald-500/30">
              GATE OPEN
            </span>
          </div>
          <div class="flex items-baseline space-x-2">
            <div id="regime-gate-val" class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-slate-50 font-mono tracking-tight">
              1.00x
            </div>
            <span class="text-xs font-mono text-slate-500">Global Allocation Multiplier</span>
          </div>
          <!-- Progress bar -->
          <div class="h-1.5 w-full rounded-full bg-slate-200 dark:bg-slate-800 overflow-hidden mt-2">
            <div id="csd-gate-progress-bar" class="h-full bg-cyan-400 rounded-full transition-all duration-500" style="width: 100%"></div>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-2 pt-2 border-t border-slate-200 dark:border-slate-800/80 font-mono text-xs">
          <div class="space-y-0.5">
            <span class="text-slate-500 text-[10px] block">G_csd Divergence:</span>
            <span id="g-csd-val" class="font-bold text-slate-900 dark:text-slate-200">0.000</span>
          </div>
          <div class="space-y-0.5">
            <span class="text-slate-500 text-[10px] block">Concordance (ρ_H12):</span>
            <span id="rho-h12-val" class="font-bold text-slate-900 dark:text-slate-200">0.000</span>
          </div>
          <div class="space-y-0.5">
            <span class="text-slate-500 text-[10px] block">Regime Classification:</span>
            <span id="csd-regime-label" class="font-bold text-cyan-400">STANDBY</span>
          </div>
          <div class="space-y-0.5">
            <span class="text-slate-500 text-[10px] block">Quant L1 Err:</span>
            <span id="quant-l1-err-val" class="font-bold text-emerald-400">0.000 (NOMINAL)</span>
          </div>
        </div>
