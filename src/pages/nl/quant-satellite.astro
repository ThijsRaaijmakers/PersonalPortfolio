    }).join('');
  }

  // ==========================================
  // SECTION 4 RENDERER (COMMANDS QUEUE TABLE)
  // ==========================================
  async function fetchAndRenderCommands(accessToken: string) {
    let commands: any[] = [];
    try {
      const cmdRes = await fetch('/api/quant/command', {
        headers: { 'Authorization': `Bearer ${accessToken}` },
      });
      if (cmdRes.ok) {
        const json = await cmdRes.json();
        commands = json.commands || [];
      }
    } catch (e) {
      console.warn('API error fetching commands, falling back to direct supabase query:', e);
    }

    if (commands.length === 0) {
      const { data: directCmds } = await supabase
        .from('quant_satellite_commands')
        .select('*')
        .order('created_at', { ascending: false })
        .limit(10);
      commands = directCmds || [];
    }

    recentCommands = commands;
    renderCommandsTable(commands);
  }

  function renderCommandsTable(commands: any[]) {
    const tbody = document.getElementById('commands-table-body');
    if (!tbody) return;

    if (!commands || commands.length === 0) {
      tbody.innerHTML = `
        <tr class="text-slate-500">
          <td colspan="7" class="py-6 text-center text-xs">
            // NO C2 COMMANDS IN QUEUE • Command transitions dispatched from this console will appear here.
          </td>
        </tr>
      `;
      return;
    }

    const html = commands.map(cmd => {
      const state = cmd.target_state || 'UNKNOWN';
      const status = cmd.status || 'PENDING';
      const idShort = cmd.id ? `${cmd.id.substring(0, 8)}...` : '--';
      const hmacShort = cmd.hmac_signature ? `${cmd.hmac_signature.substring(0, 10)}...` : '--';

      let stateBadgeClass = 'bg-slate-800 text-slate-300';
      if (state === 'STATE_RUNNING') stateBadgeClass = 'bg-emerald-500/15 text-emerald-400 border border-emerald-500/30';
      else if (state === 'STATE_PAUSE_MAINTAIN') stateBadgeClass = 'bg-amber-500/15 text-amber-400 border border-amber-500/30';
      else if (state === 'STATE_GRACEFUL_UNWIND_FLAT') stateBadgeClass = 'bg-cyan-500/15 text-cyan-400 border border-cyan-500/30';
      else if (state === 'STATE_EMERGENCY_HALT') stateBadgeClass = 'bg-rose-500/20 text-rose-400 border border-rose-500/50';

      let statusBadge = `
        <span class="inline-flex items-center space-x-1.5 px-2 py-0.5 rounded text-[10px] font-bold bg-amber-500/15 text-amber-400 border border-amber-500/30">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
          <span>PENDING</span>
        </span>
      `;

      if (status === 'ACKNOWLEDGED') {
        statusBadge = `
          <span class="inline-flex items-center space-x-1.5 px-2 py-0.5 rounded text-[10px] font-bold bg-blue-500/15 text-blue-400 border border-blue-500/30">
            <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
            <span>ACK</span>
          </span>
        `;
      } else if (status === 'EXECUTED') {
        statusBadge = `
          <span class="inline-flex items-center space-x-1.5 px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            <span>EXECUTED</span>
          </span>
        `;
      } else if (status === 'REJECTED') {
        statusBadge = `
          <span class="inline-flex items-center space-x-1.5 px-2 py-0.5 rounded text-[10px] font-bold bg-rose-500/20 text-rose-400 border border-rose-500/40">
            <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
            <span>REJECTED</span>
          </span>
        `;
      }

      return `
        <tr class="hover:bg-slate-200/50 dark:hover:bg-slate-800/40 transition-colors">
          <td class="py-2.5 pr-3 text-cyan-600 dark:text-cyan-400 font-bold" title="${cmd.id}">
            ${idShort}
          </td>
          <td class="py-2.5 px-3 text-slate-500 text-[11px]" title="${cmd.created_at}">
            ${formatTimeAgo(cmd.created_at || cmd.issued_at_ms)}
          </td>
          <td class="py-2.5 px-3">
            <span class="px-2 py-0.5 rounded text-[10px] font-bold ${stateBadgeClass}">
              ${state}
            </span>
          </td>
          <td class="py-2.5 px-3 text-slate-700 dark:text-slate-300 max-w-xs truncate" title="${cmd.reason}">
            ${cmd.reason || '--'}
          </td>
          <td class="py-2.5 px-3 text-right font-bold text-slate-800 dark:text-slate-200">
            ${cmd.target_nav_usd ? formatUsd(Number(cmd.target_nav_usd)) : '--'}
          </td>
          <td class="py-2.5 px-3 text-center">
            ${statusBadge}
          </td>
          <td class="py-2.5 pl-3 text-right text-slate-500 text-[10px]" title="${cmd.hmac_signature}">
            ${hmacShort}
          </td>
        </tr>
      `;
    }).join('');

    tbody.innerHTML = html;
  }

  // ==========================================
  // EVENT LISTENERS & C2 MODAL HANDLING
  // ==========================================
  function setupEventListeners(accessToken: string) {
    const refreshBtn = document.getElementById('refresh-btn');
    refreshBtn?.addEventListener('click', async () => {
      await fetchAndRenderAll(accessToken, false);
    });

    // Copy AI Snapshot button
    const copySatBtn = document.getElementById('copy-sat-snapshot-btn');
    const copySatLabel = document.getElementById('copy-sat-snapshot-label');
    copySatBtn?.addEventListener('click', async () => {
      const activeVenue = getActiveVenue();
      const md = buildSatelliteMarkdownSnapshot({
        latestRow: latestTelemetryRow || {},
        historyRows: telemetryHistoryRows,
        latestCoreRow: latestCoreRow,
        recentCommands: recentCommands,
        venue: activeVenue,
        livePricesMap: liveMidPrices,
      });

      const ok = await copyTextToClipboard(md);
      if (ok) {
        if (copySatLabel) copySatLabel.textContent = 'Gekopieerd!';
        setTimeout(() => {
          if (copySatLabel) copySatLabel.textContent = 'Kopieer AI Snapshot';
        }, 2000);
        showDiagnosticToast('[OK] Quant-Satellite AI Snapshot gekopieerd naar klembord!');
      } else {
        showDiagnosticToast('[ERROR] Failed to copy to clipboard', true);
      }
    });

    // Export JSON button
    const exportSatJsonBtn = document.getElementById('export-sat-json-btn');
    exportSatJsonBtn?.addEventListener('click', () => {
      const activeVenue = getActiveVenue();
      const auditJson = normalizeSatelliteSnapshot({
        latestRow: latestTelemetryRow || {},
        historyRows: telemetryHistoryRows,
        latestCoreRow: latestCoreRow,
        recentCommands: recentCommands,
        venue: activeVenue,
        livePricesMap: liveMidPrices,
      });

      const barIdx = latestTelemetryRow?.bar_idx ?? 0;
      triggerJsonDownload(`quant_satellite_audit_bar_${barIdx}.json`, auditJson);
      showDiagnosticToast(`[OK] quant_satellite_audit_bar_${barIdx}.json downloaded!`);
    });

    // Environment Switchers (Paper / Live)
    const satPaperBtn = document.getElementById('sat-env-paper-btn');
    const satLiveBtn = document.getElementById('sat-env-live-btn');

    satPaperBtn?.addEventListener('click', async () => {
      const current = getActiveVenue();
      if (current === 'paper') return;
      isPinnedToLive = true;
      setActiveVenue('paper');
      updateSatEnvButtons('paper');
      await fetchAndRenderAll(accessToken, false);
    });

    satLiveBtn?.addEventListener('click', async () => {
      const current = getActiveVenue();
      if (current === 'live') return;
      isPinnedToLive = true;
      setActiveVenue('live');
      updateSatEnvButtons('live');
      await fetchAndRenderAll(accessToken, false);
    });

    window.addEventListener('quant:venue-change', async (e: Event) => {
      const customEvt = e as CustomEvent<{ venue: TradingVenue }>;
      const nextVenue = customEvt.detail?.venue;
      if (nextVenue) {
        isPinnedToLive = true;
        updateSatEnvButtons(nextVenue);
        await fetchAndRenderAll(accessToken, false);
      }
    });

    // Timeframe Pills (1H, 6H, 24H, 3D, 1W, ALL)
    const tfButtons = document.querySelectorAll<HTMLButtonElement>('.chart-tf-btn');
    tfButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const windowAttr = btn.getAttribute('data-chart-window') as any;
        if (!windowAttr) return;
        activeChartWindow = windowAttr;
        isDragging = false;

        tfButtons.forEach(b => {
          b.classList.remove('active', 'font-bold', 'bg-white', 'dark:bg-slate-800', 'text-cyan-600', 'dark:text-cyan-400', 'shadow-sm');
          b.classList.add('text-slate-500');
        });
        btn.classList.add('active', 'font-bold', 'bg-white', 'dark:bg-slate-800', 'text-cyan-600', 'dark:text-cyan-400', 'shadow-sm');
        btn.classList.remove('text-slate-500');

        recalcViewWindowToLive();
        renderChart(cachedTelemetryHistory);
      });
    });

    // Series Toggles
    const toggleNavBtn = document.getElementById('toggle-series-nav');
    const toggleBetaBtn = document.getElementById('toggle-series-beta');
    const toggleStopBtn = document.getElementById('toggle-series-stop');

    toggleNavBtn?.addEventListener('click', () => {
      showSeriesNav = !showSeriesNav;
      if (showSeriesNav) {
        toggleNavBtn.classList.remove('opacity-40', 'line-through');
        toggleNavBtn.classList.add('opacity-100');
      } else {
        toggleNavBtn.classList.remove('opacity-100');
        toggleNavBtn.classList.add('opacity-40', 'line-through');
      }
      renderChart(cachedTelemetryHistory);
    });

    toggleBetaBtn?.addEventListener('click', () => {
      showSeriesBeta = !showSeriesBeta;
      if (showSeriesBeta) {
        toggleBetaBtn.classList.remove('opacity-40', 'line-through');
        toggleBetaBtn.classList.add('opacity-100');
      } else {
        toggleBetaBtn.classList.remove('opacity-100');
        toggleBetaBtn.classList.add('opacity-40', 'line-through');
      }
      renderChart(cachedTelemetryHistory);
    });

    toggleStopBtn?.addEventListener('click', () => {
      showSeriesStop = !showSeriesStop;
      if (showSeriesStop) {
        toggleStopBtn.classList.remove('opacity-40', 'line-through');
        toggleStopBtn.classList.add('opacity-100');
      } else {
        toggleStopBtn.classList.remove('opacity-100');
        toggleStopBtn.classList.add('opacity-40', 'line-through');
      }
      renderChart(cachedTelemetryHistory);
    });

    // C2 Reason length counter
    const reasonInput = document.getElementById('c2-reason-input') as HTMLInputElement | null;
    const charCount = document.getElementById('reason-char-count');
    reasonInput?.addEventListener('input', () => {
      if (charCount && reasonInput) {
        charCount.textContent = `${reasonInput.value.length} / 250`;
      }
    });

    // Feedback close button
    const fbBanner = document.getElementById('c2-feedback-banner');
    const fbClose = document.getElementById('c2-feedback-close');
    fbClose?.addEventListener('click', () => {
      fbBanner?.classList.add('hidden');
    });

    // C2 Modal elements
    const modal = document.getElementById('c2-modal');
    const modalStateBadge = document.getElementById('modal-target-state-badge');
    const modalTargetNav = document.getElementById('modal-target-nav');
    const modalReason = document.getElementById('modal-reason');
    const modalCancelBtn = document.getElementById('modal-cancel-btn');
    const modalCloseBtn = document.getElementById('modal-close-btn');
    const modalConfirmBtn = document.getElementById('modal-confirm-btn');
    const modalConfirmSpinner = document.getElementById('modal-confirm-spinner');
    const modalConfirmLabel = document.getElementById('modal-confirm-label');

    function closeModal() {
      modal?.classList.add('hidden');
      pendingTargetState = '';
    }

    [modalCancelBtn, modalCloseBtn].forEach(b => b?.addEventListener('click', closeModal));

    // C2 Action Buttons
    const actionBtns = document.querySelectorAll('.c2-action-btn');
    actionBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const reason = reasonInput?.value.trim() || '';
        if (!reason) {
          if (reasonInput) {
            reasonInput.classList.add('border-rose-500', 'ring-2', 'ring-rose-500/30');
            reasonInput.focus();
            setTimeout(() => {
              reasonInput.classList.remove('border-rose-500', 'ring-2', 'ring-rose-500/30');
            }, 3000);
          }
          showFeedback('Vul een reden / auditnotitie in voordat je een statusovergang verzendt.', 'error');
          return;
        }

        const targetState = btn.getAttribute('data-target-state') || '';
        const stateLabel = btn.getAttribute('data-state-label') || targetState;
        const stateColor = btn.getAttribute('data-state-color') || 'cyan';
        const targetNavInput = document.getElementById('c2-target-nav-input') as HTMLInputElement | null;
        const targetNavVal = targetNavInput?.value ? Number(targetNavInput.value) : null;

        pendingTargetState = targetState;

        if (modalStateBadge) {
          modalStateBadge.textContent = stateLabel;
          modalStateBadge.className = `px-2 py-0.5 rounded font-bold text-xs bg-${stateColor}-500/20 text-${stateColor}-400 border border-${stateColor}-500/40`;
        }

        if (modalTargetNav) {
          modalTargetNav.textContent = targetNavVal ? formatUsd(targetNavVal) : 'Unchanged (Current Balance)';
        }

        if (modalReason) {
          modalReason.textContent = `"${reason}"`;
        }

        modal?.classList.remove('hidden');
      });
    });

    // Confirm button in C2 modal -> POST /api/quant/command
    modalConfirmBtn?.addEventListener('click', async () => {
      if (!pendingTargetState) return;

      const reason = reasonInput?.value.trim() || '';
      const targetNavInput = document.getElementById('c2-target-nav-input') as HTMLInputElement | null;
      const targetNavVal = targetNavInput?.value ? Number(targetNavInput.value) : null;

      modalConfirmSpinner?.classList.remove('hidden');
      if (modalConfirmLabel) modalConfirmLabel.textContent = 'Verzenden...';
      if (modalConfirmBtn) (modalConfirmBtn as HTMLButtonElement).disabled = true;

      try {
        const res = await fetch('/api/quant/command', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${accessToken}`,
          },
          body: JSON.stringify({
            target_state: pendingTargetState,
            reason: reason,
            target_nav_usd: targetNavVal,
          }),
        });

        const data = await res.json();

        if (!res.ok || !data.ok) {
          throw new Error(data.error || 'Failed to dispatch command');
        }

        closeModal();
        showFeedback(`Succesvol ${pendingTargetState} verzonden (Commando-ID: ${data.command_id.substring(0, 8)}...). Weggeschreven naar auditlogboek.`, 'success');

        if (reasonInput) reasonInput.value = '';
        if (targetNavInput) targetNavInput.value = '';
        if (charCount) charCount.textContent = '0 / 250';

        await fetchAndRenderAll(accessToken, false);
      } catch (err: any) {
        showFeedback(`Fout bij verzenden C2-commando: ${err.message}`, 'error');
      } finally {
        modalConfirmSpinner?.classList.add('hidden');
        if (modalConfirmLabel) modalConfirmLabel.textContent = 'Bevestigen & Verzenden';
        if (modalConfirmBtn) (modalConfirmBtn as HTMLButtonElement).disabled = false;
      }
    });

    // Multi-Partition Console Listeners
    const addPartitionBtn = document.getElementById('add-partition-btn');
    const partitionModal = document.getElementById('partition-modal');
    const partModalTitle = document.getElementById('partition-modal-title');
    const partModalAction = document.getElementById('partition-modal-action') as HTMLInputElement | null;
    const partModalId = document.getElementById('partition-modal-id') as HTMLInputElement | null;
    const partNameInput = document.getElementById('partition-name-input') as HTMLInputElement | null;
    const partRelationInput = document.getElementById('partition-relation-input') as HTMLInputElement | null;
    const partAmountLabel = document.getElementById('partition-amount-label');
    const partAmountInput = document.getElementById('partition-amount-input') as HTMLInputElement | null;
    const partFeeInput = document.getElementById('partition-fee-input') as HTMLInputElement | null;
    const partNotesInput = document.getElementById('partition-notes-input') as HTMLInputElement | null;
    const partNameGroup = document.getElementById('partition-name-group');
    const partRelationGroup = document.getElementById('partition-relation-group');
    const partFeeGroup = document.getElementById('partition-fee-group');
    const partNotesGroup = document.getElementById('partition-notes-group');

    addPartitionBtn?.addEventListener('click', () => {
      if (partModalAction) partModalAction.value = 'CREATE_PARTITION';
      if (partModalId) partModalId.value = '';
      if (partModalTitle) partModalTitle.textContent = '// ADD POOL PARTICIPANT';
      if (partNameGroup) partNameGroup.classList.remove('hidden');
      if (partRelationGroup) partRelationGroup.classList.remove('hidden');
      if (partFeeGroup) partFeeGroup.classList.remove('hidden');
      if (partNotesGroup) partNotesGroup.classList.remove('hidden');
      if (partAmountLabel) partAmountLabel.textContent = 'Initial Capital Deposit ($):';
      if (partAmountInput) {
        partAmountInput.placeholder = 'e.g., 500.00';
        partAmountInput.value = '';
        partAmountInput.closest('div')?.classList.remove('hidden');
      }
      if (partNameInput) partNameInput.value = '';
      if (partRelationInput) partRelationInput.value = '';
      if (partFeeInput) partFeeInput.value = '20.0';
      if (partNotesInput) partNotesInput.value = '';
      partitionModal?.classList.remove('hidden');
    });

    const partCloseBtn = document.getElementById('partition-modal-close-btn');
    const partCancelBtn = document.getElementById('partition-modal-cancel-btn');
    const closePartModal = () => { partitionModal?.classList.add('hidden'); };
    [partCloseBtn, partCancelBtn].forEach(b => b?.addEventListener('click', closePartModal));

    const partForm = document.getElementById('partition-form') as HTMLFormElement | null;
    const partSubmitBtn = document.getElementById('partition-modal-submit-btn');
    const partSpinner = document.getElementById('partition-modal-spinner');
    const partSubmitLabel = document.getElementById('partition-modal-submit-label');

    partForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const action = partModalAction?.value || 'CREATE_PARTITION';
      const curUnitPrice = latestValuationResult?.grossUnitPrice || 1.0;

      partSpinner?.classList.remove('hidden');
      if (partSubmitLabel) partSubmitLabel.textContent = 'Saving...';
      if (partSubmitBtn) (partSubmitBtn as HTMLButtonElement).disabled = true;

      try {
        let payload: any = { action };
        if (action === 'CREATE_PARTITION') {
          payload.participant_name = partNameInput?.value.trim();
          payload.relation_label = partRelationInput?.value.trim() || 'Investor';
          payload.initial_capital_usd = Number(partAmountInput?.value) || 0;
          payload.performance_fee_pct = Number(partFeeInput?.value) || 0;
          payload.current_unit_price = curUnitPrice;
        } else if (action === 'ADJUST_CAPITAL') {
          payload.partition_id = partModalId?.value;
          payload.delta_capital_usd = Number(partAmountInput?.value) || 0;
          payload.current_unit_price = curUnitPrice;
        } else if (action === 'UPDATE_FEE_PCT') {
          payload.partition_id = partModalId?.value;
          payload.performance_fee_pct = Number(partFeeInput?.value) || 0;
        }

        const res = await fetch('/api/quant/partitions', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${accessToken}`,
          },
          body: JSON.stringify(payload),
        });

        const json = await res.json();
        if (!res.ok || !json.ok) {
          throw new Error(json.error || 'Failed to process partition action');
        }

        closePartModal();
        showDiagnosticToast(`[OK] Partition action ${action} executed successfully!`);
        await fetchAndRenderPartitions(accessToken);
      } catch (err: any) {
        alert(`Partition Error: ${err.message}`);
      } finally {
        partSpinner?.classList.add('hidden');
        if (partSubmitLabel) partSubmitLabel.textContent = 'Confirm & Save';
        if (partSubmitBtn) (partSubmitBtn as HTMLButtonElement).disabled = false;
      }
    });

    // Table Actions (Adjust Capital, Fee%, Remove)
    const partTableBody = document.getElementById('partitions-table-body');
    partTableBody?.addEventListener('click', async (e) => {
      const target = (e.target as HTMLElement).closest('.partition-action-btn') as HTMLButtonElement | null;
      if (!target) return;
      const action = target.getAttribute('data-action');
      const id = target.getAttribute('data-id');
      const name = target.getAttribute('data-name') || 'Participant';

      if (action === 'adjust-capital' && id) {
        if (partModalAction) partModalAction.value = 'ADJUST_CAPITAL';
        if (partModalId) partModalId.value = id;
        if (partModalTitle) partModalTitle.textContent = `// ADJUST CAPITAL: ${name.toUpperCase()}`;
        if (partNameGroup) partNameGroup.classList.add('hidden');
        if (partRelationGroup) partRelationGroup.classList.add('hidden');
        if (partFeeGroup) partFeeGroup.classList.add('hidden');
        if (partNotesGroup) partNotesGroup.classList.add('hidden');
        if (partAmountLabel) partAmountLabel.textContent = 'Capital Delta ($) (+ deposit, - withdrawal):';
        if (partAmountInput) {
          partAmountInput.placeholder = 'e.g., 250.00 or -100.00';
          partAmountInput.value = '';
          partAmountInput.closest('div')?.classList.remove('hidden');
        }
        partitionModal?.classList.remove('hidden');
      } else if (action === 'update-fee' && id) {
        const curFee = target.getAttribute('data-fee') || '20.0';
        if (partModalAction) partModalAction.value = 'UPDATE_FEE_PCT';
        if (partModalId) partModalId.value = id;
        if (partModalTitle) partModalTitle.textContent = `// UPDATE FEE %: ${name.toUpperCase()}`;
        if (partNameGroup) partNameGroup.classList.add('hidden');
        if (partRelationGroup) partRelationGroup.classList.add('hidden');
        if (partFeeGroup) partFeeGroup.classList.remove('hidden');
        if (partNotesGroup) partNotesGroup.classList.add('hidden');
        if (partAmountInput) {
          partAmountInput.value = '0';
          partAmountInput.closest('div')?.classList.add('hidden');
        }
        if (partFeeInput) partFeeInput.value = curFee;
        partitionModal?.classList.remove('hidden');
      } else if (action === 'delete' && id) {
        if (!confirm(`Are you sure you want to permanently remove partition "${name}"?`)) return;
        try {
          const res = await fetch('/api/quant/partitions', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${accessToken}`,
            },
            body: JSON.stringify({
              action: 'DELETE_PARTITION',
              partition_id: id,
            }),
          });
          const json = await res.json();
          if (!res.ok || !json.ok) throw new Error(json.error || 'Failed to remove partition');
          showDiagnosticToast(`[OK] Partition "${name}" removed`);
          await fetchAndRenderPartitions(accessToken);
        } catch (err: any) {
          alert(`Error: ${err.message}`);
        }
      }
    });

    // Crystallize Accrued HWM Fees
    const crystallizeBtn = document.getElementById('crystallize-fees-btn');
    const crystallizeLabel = document.getElementById('crystallize-btn-label');

    crystallizeBtn?.addEventListener('click', async () => {
      const curUnitPrice = latestValuationResult?.grossUnitPrice || 1.0;
      const accrued = latestValuationResult?.totalAccruedFeesFromOthers || 0;

      if (accrued <= 0.005) {
        showDiagnosticToast('[INFO] No accrued HWM fees to crystallize at this time.');
        return;
      }

      if (!confirm(`Crystallize $${accrued.toFixed(2)} in accrued high-water-mark performance fees? This will allocate fee units to the Master Node and reset participant HWM thresholds.`)) {
        return;
      }

      if (crystallizeLabel) crystallizeLabel.textContent = 'Crystallizing...';
      if (crystallizeBtn) (crystallizeBtn as HTMLButtonElement).disabled = true;

      try {
        const res = await fetch('/api/quant/partitions', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${accessToken}`,
          },
          body: JSON.stringify({
            action: 'CRYSTALLIZE_FEES',
            current_unit_price: curUnitPrice,
          }),
        });

        const json = await res.json();
        if (!res.ok || !json.ok) throw new Error(json.error || 'Failed to crystallize fees');

        showDiagnosticToast(`[SUCCESS] Crystallized $${json.total_crystallized_usd.toFixed(2)} in fees! ${json.fee_units_credited.toFixed(4)} units credited to Master Node.`);
        await fetchAndRenderPartitions(accessToken);
      } catch (err: any) {
        alert(`Crystallization Error: ${err.message}`);
      } finally {
        if (crystallizeLabel) crystallizeLabel.textContent = 'Crystallize Accrued HWM Fees';
        if (crystallizeBtn) (crystallizeBtn as HTMLButtonElement).disabled = false;
      }
    });
  }

  function showFeedback(msg: string, type: 'success' | 'error') {
    const banner = document.getElementById('c2-feedback-banner');
    const msgEl = document.getElementById('c2-feedback-msg');
    if (!banner || !msgEl) return;

    msgEl.textContent = msg;
    banner.classList.remove('hidden');

    if (type === 'success') {
      banner.className = 'p-3.5 rounded-xl font-mono text-xs flex items-center justify-between bg-emerald-500/15 text-emerald-400 border border-emerald-500/40';
    } else {
      banner.className = 'p-3.5 rounded-xl font-mono text-xs flex items-center justify-between bg-rose-500/15 text-rose-400 border border-rose-500/40';
    }

    setTimeout(() => {
      banner.classList.add('hidden');
    }, 8000);
  }

  document.addEventListener('astro:page-load', loadQuantSatelliteDashboard);
</script>
