    const card5FeesVal = document.getElementById('card5-fees-val');
    const mtProgressBar = document.getElementById('maker-taker-progress-bar');

    if (!latest) {
      // Deterministic Reset to Zero-State
      if (navVal) navVal.textContent = '$0.00';
      if (walletVal) walletVal.textContent = '$0.00';
      if (upnlVal) {
        upnlVal.textContent = '$0.00';
        upnlVal.className = 'font-bold text-slate-500';
      }
      if (rpnlVal) rpnlVal.textContent = '$0.00';
      if (feesVal) feesVal.textContent = '$0.00';
      if (navBadge) {
        navBadge.textContent = 'STANDBY';
        navBadge.className = 'px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-slate-800 text-slate-400 border border-slate-700';
      }

      if (ddVal) {
        ddVal.textContent = '0.00%';
        ddVal.className = 'text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-slate-50 font-mono tracking-tight';
      }
      if (ulcerVal) ulcerVal.textContent = '0.000';
      if (zStressVal) zStressVal.textContent = '0.00';
      if (ddBadge) {
        ddBadge.textContent = 'NOMINAL RISK';
        ddBadge.className = 'px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-emerald-500/15 text-emerald-500 border border-emerald-500/30';
      }

      if (betaVal) betaVal.textContent = '0.000';
      if (netExpVal) netExpVal.textContent = '$0.00';
      if (grossLevVal) grossLevVal.textContent = '0.00x';
      if (betaBadge) {
        betaBadge.textContent = 'SAFE (<= 0.030)';
        betaBadge.className = 'px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-emerald-500/15 text-emerald-500 border border-emerald-500/30';
      }

      if (gateVal) gateVal.textContent = '0.00x';
      if (gCsdVal) gCsdVal.textContent = '0.000';
      if (rhoVal) rhoVal.textContent = '0.000';
      if (csdRegimeLabel) csdRegimeLabel.textContent = 'STANDBY';
      if (quantL1ErrVal) quantL1ErrVal.textContent = '0.000 (NOMINAL)';
      if (csdProgressBar) csdProgressBar.style.width = '0%';
      if (csdBadge) {
        csdBadge.textContent = 'STANDBY';
        csdBadge.className = 'px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-slate-800 text-slate-400 border border-slate-700';
      }

      if (mtVal) mtVal.textContent = '0.00%';
      if (mtProgressBar) mtProgressBar.style.width = '0%';
      if (makerFillsVal) makerFillsVal.textContent = '0';
      if (takerFillsVal) takerFillsVal.textContent = '0';
      if (gtxRejectsVal) gtxRejectsVal.textContent = '0 (Protected)';
      if (card5FeesVal) card5FeesVal.textContent = '$0.00';
      return;
    }

    const norm = normalizeTelemetryRow(latest);
    if (!norm) return;

    const v31 = extractV31Meta(latest, cachedTelemetryHistory);
    const nav = v31.navUsd;
    const wallet = v31.walletBalanceUsd;
    const upnl = v31.unrealizedPnlUsd;
    const rpnl = v31.realizedPnlUsd;
    const fees = v31.totalFeesUsd;

    if (navVal) navVal.textContent = formatUsd(nav);
    if (walletVal) walletVal.textContent = formatUsd(wallet);
    if (upnlVal) {
      upnlVal.textContent = formatUsd(upnl);
      upnlVal.className = upnl >= 0 ? 'font-bold text-emerald-400' : 'font-bold text-rose-400';
    }
    if (rpnlVal) rpnlVal.textContent = formatUsd(rpnl);
    if (feesVal) feesVal.textContent = formatUsd(fees);

    const netRetUsd = nav - v31.initialNavUsd;
    const netRetPct = v31.initialNavUsd > 0 ? (netRetUsd / v31.initialNavUsd) * 100 : 0;
    const retUsdEl = document.getElementById('card1-net-return-usd');
    const retPctEl = document.getElementById('card1-net-return-pct');
    if (retUsdEl) {
      retUsdEl.textContent = `${netRetUsd >= 0 ? '+' : ''}${formatUsd(netRetUsd)}`;
      retUsdEl.className = netRetUsd >= 0 ? 'font-bold text-emerald-400' : 'font-bold text-rose-400';
    }
    if (retPctEl) {
      retPctEl.textContent = `${netRetPct >= 0 ? '+' : ''}${netRetPct.toFixed(2)}%`;
      retPctEl.className = netRetPct >= 0 ? 'font-bold text-emerald-400' : 'font-bold text-rose-400';
    }

    if (navBadge) {
      navBadge.textContent = 'SATELLITE MTM';
      navBadge.className = 'px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-cyan-500/15 text-cyan-600 dark:text-cyan-400 border border-cyan-500/30';
    }

    // Card 2: Drawdown & Tail Risk
    const rawRowDdPct = Number(norm.drawdown_pct) || 0;
    const gDdRatio = v31.rawGonogoReport?.trailing_drawdown_ratio != null
      ? Number(v31.rawGonogoReport.trailing_drawdown_ratio)
      : (v31.hwmUsd > 0 ? Math.max(0, (v31.hwmUsd - nav) / v31.hwmUsd) : 0);
    const dd = Math.abs(rawRowDdPct) > 1e-6 ? rawRowDdPct : (gDdRatio > 0 ? -(gDdRatio * 100) : 0);
    const ulcer = Number(norm.gonogo_report?.ulcer_index ?? norm.gonogo_progress?.ulcer_index ?? norm.ulcer_index ?? 0);
    const zStress = Number(norm.z_stress) || 0;

    if (ddVal) {
      ddVal.textContent = `${dd.toFixed(2)}%`;
      ddVal.className = dd <= -4.0 
        ? 'text-2xl sm:text-3xl font-extrabold text-rose-500 font-mono tracking-tight' 
        : (dd < 0 ? 'text-2xl sm:text-3xl font-extrabold text-amber-400 font-mono tracking-tight' : 'text-2xl sm:text-3xl font-extrabold text-emerald-400 font-mono tracking-tight');
    }
    if (ulcerVal) ulcerVal.textContent = ulcer.toFixed(3);
    if (zStressVal) zStressVal.textContent = zStress.toFixed(2);
    if (ddBadge) {
      if (dd <= -4.0) {
        ddBadge.textContent = 'CIRCUIT BREACH';
        ddBadge.className = 'px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-rose-500/20 text-rose-400 border border-rose-500/40';
      } else if (dd <= -2.0) {
        ddBadge.textContent = 'TAIL DEFENSE';
        ddBadge.className = 'px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-amber-500/20 text-amber-400 border border-amber-500/40';
      } else {
        ddBadge.textContent = 'NOMINAL RISK';
        ddBadge.className = 'px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-emerald-500/15 text-emerald-500 border border-emerald-500/30';
      }
    }

    // Card 3: Dual-Nullspace Neutrality
    const tailBeta = Number(v31.rawGonogoReport?.realized_tail_beta ?? norm.realized_tail_beta) || 0;
    const betaLimit = v31.isV31 ? 0.030 : 0.035;
    const activeHoldings = computeAllBasketHoldings(
      latest.gonogo_report?.positions_v31 || latest.positions_lots || latest.positions || {},
      nav,
      upnl,
      liveMidPrices
    );
    const activeNetSum = activeHoldings.reduce((s, h) => s + h.qty_lots * h.mark_price, 0);
    const gNetExp = v31.rawGonogoReport?.net_dollar_exposure_usd != null ? Number(v31.rawGonogoReport.net_dollar_exposure_usd) : null;
    const rowNetExp = norm.net_dollar_exposure != null ? Number(norm.net_dollar_exposure) : null;
    const netExp =
      gNetExp != null && (Math.abs(gNetExp) > 1e-6 || activeHoldings.length === 0)
        ? gNetExp
        : Math.abs(activeNetSum) > 1e-6
          ? activeNetSum
          : (rowNetExp || 0);
    const grossLev = Number(v31.rawGonogoReport?.gross_leverage ?? norm.gross_leverage) || 0;

    if (betaVal) betaVal.textContent = tailBeta.toFixed(3);
    if (netExpVal) netExpVal.textContent = formatUsd(netExp);
    if (grossLevVal) grossLevVal.textContent = `${grossLev.toFixed(2)}x`;

    if (betaBadge) {
      if (Math.abs(tailBeta) <= betaLimit) {
        betaBadge.textContent = `SAFE (<= ${betaLimit.toFixed(3)})`;
        betaBadge.className = 'px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-emerald-500/15 text-emerald-500 border border-emerald-500/30';
      } else {
        betaBadge.textContent = `BETA BREACH (> ${betaLimit.toFixed(3)})`;
        betaBadge.className = 'px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-rose-500/20 text-rose-400 border border-rose-500/50';
      }
    }

    // Card 4: Layer-1 Regime & CSD Gate
    const gate = norm.gate;
    if (gateVal) gateVal.textContent = `${gate.toFixed(2)}x`;
    if (gCsdVal) gCsdVal.textContent = norm.gCsd.toFixed(3);
    if (rhoVal) rhoVal.textContent = norm.rhoConc.toFixed(3);
    if (csdRegimeLabel) csdRegimeLabel.textContent = norm.regime;
    if (quantL1ErrVal) quantL1ErrVal.textContent = norm.l1QuantErr === 0 ? '0.000 (NOMINAL)' : norm.l1QuantErr.toFixed(3);
    if (csdProgressBar) csdProgressBar.style.width = `${Math.min(100, Math.max(0, gate * 100))}%`;

    if (csdBadge) {
      if (gate >= 0.8) {
        csdBadge.textContent = 'GATE OPEN (1.0x)';
        csdBadge.className = 'px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-emerald-500/15 text-emerald-500 border border-emerald-500/30';
      } else if (gate > 0) {
