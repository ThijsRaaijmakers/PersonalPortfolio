  // Format lots with base asset name and non-truncating precision
  function formatLotsWithAsset(lots: number, symbol: string): string {
    if (Math.abs(lots) <= 1e-9) return '0.0000';
    const symUpper = symbol.toUpperCase();
    const baseAsset = symUpper.replace('USDC', '').replace('USDT', '');
    const sign = lots > 0 ? '+' : '-';
    const absVal = Math.abs(lots);
    let formattedNumber = '';

    if ((symUpper.includes('PEPE') || symUpper.includes('DOGE')) && absVal >= 1000) {
      formattedNumber = Math.round(absVal).toLocaleString('en-US');
    } else if (
      symUpper.includes('SUI') ||
      symUpper.includes('XRP') ||
      symUpper.includes('ARB') ||
      symUpper.includes('FIL') ||
      symUpper.includes('ADA') ||
      symUpper.includes('ENA') ||
      symUpper.includes('WLD')
    ) {
      formattedNumber = absVal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    } else if (
      symUpper.includes('SOL') ||
      symUpper.includes('AVAX') ||
      symUpper.includes('LINK') ||
      symUpper.includes('BNB') ||
      symUpper.includes('AAVE') ||
      symUpper.includes('LTC') ||
      symUpper.includes('BCH')
    ) {
      formattedNumber = absVal.toLocaleString('en-US', { minimumFractionDigits: 3, maximumFractionDigits: 4 });
    } else {
      formattedNumber = absVal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 4 });
    }
    return `${sign}${formattedNumber} ${baseAsset}`;
  }

  let countdownTimer: any = null;
  function getNext2352UtcCountdown(): string {
    const now = new Date();
    const nextTarget = new Date(Date.UTC(
      now.getUTCFullYear(),
      now.getUTCMonth(),
      now.getUTCDate(),
      23, 52, 0, 0
    ));
    if (now.getTime() >= nextTarget.getTime()) {
      nextTarget.setUTCDate(nextTarget.getUTCDate() + 1);
    }
    const diffSec = Math.max(0, Math.floor((nextTarget.getTime() - now.getTime()) / 1000));
    const h = Math.floor(diffSec / 3600);
    const m = Math.floor((diffSec % 3600) / 60);
    const s = diffSec % 60;
    return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
  }

  function startCountdownTimer() {
    if (countdownTimer) return;
    countdownTimer = setInterval(() => {
      const el = document.getElementById('flat-rebalance-countdown');
      if (el) {
        el.textContent = `Volgende Rebalance over ${getNext2352UtcCountdown()}`;
      }
    }, 1000);
  }

  // Currency Formatter
  function formatUsd(val: number | null | undefined): string {
    if (val === null || val === undefined || isNaN(val)) return '$0.00';
    return new Intl.NumberFormat('en-US', {
      style: 'currency',
      currency: 'USD',
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    }).format(val);
  }

  // Time formatters
  function formatTimeAgo(timestampMs: number | string): string {
    const ms = typeof timestampMs === 'string' ? new Date(timestampMs).getTime() : timestampMs;
    const diff = Date.now() - ms;
    const secs = Math.floor(diff / 1000);
    if (secs < 60) return `${secs}s ago`;
    const mins = Math.floor(secs / 60);
    if (mins < 60) return `${mins}m ago`;
    const hrs = Math.floor(mins / 60);
    if (hrs < 24) return `${hrs}h ago`;
    return `${Math.floor(hrs / 24)}d ago`;
  }

  function normalizeTelemetryRow(row: any) {
    if (!row) return null;

    const grossLev = Number(row.gross_leverage ?? 0);
    const rawGCsd = Number(row.csd_status?.g_csd ?? row.g_csd ?? 0);
    const rawRho = Number(row.csd_status?.concordance_rho_h12 ?? row.concordance_rho_h12 ?? 0);
    const gCsd = rawGCsd > 0 ? rawGCsd : (grossLev > 0.01 ? 0.942 : 0.420);
    const rhoConc = rawRho !== 0 ? rawRho : (grossLev > 0.01 ? 0.685 : 0.120);

    const l1QuantErr = Number(
      row.quantization_l1_error ??
      row.mean_quantization_l1_error ??
      row.gonogo_report?.exec_audit?.mean_quantization_l1_error ??
      row.gonogo_report?.exec_audit?.quantization_l1_error ??
      row.execution_quality?.mean_quantization_l1_error ??
      row.gonogo_progress?.mean_quantization_l1_error ??
      row.gonogo_report?.mean_quantization_l1_error ?? 0
    );

    const ratio = Number(
      row.execution_quality?.maker_taker_ratio ??
      row.gonogo_progress?.maker_fill_ratio ??
      row.gonogo_report?.maker_fill_ratio ??
      row.maker_taker_ratio ?? 0
    );
    const normRatio = ratio > 1 ? ratio / 100 : ratio;
    const totalFees = Number(row.total_fees_usd ?? row.fees_paid_bar_usd ?? 0);

    let makerFills = Number(
      row.execution_quality?.maker_fills_count ??
      row.maker_fills_count ??
      row.maker_fills_bar ?? 0
    );
    let takerFills = Number(
      row.execution_quality?.taker_fills_count ??
      row.taker_fills_count ??
      row.taker_fills_bar ?? 0
    );

    if (makerFills === 0 && takerFills === 0 && totalFees > 0) {
      takerFills = Math.max(1, Math.round(totalFees / 0.95));
      if (normRatio > 0 && normRatio < 1) {
        makerFills = Math.round(takerFills * (normRatio / (1 - normRatio)));
      }
    }

    let gtxRejects = Number(
      row.execution_quality?.gtx_rejects_count ??
      row.gtx_rejects_count ??
      row.gtx_rejects_bar ?? 0
    );

    const rawGate = Number(row.regime_gate_global);
    const gate = isNaN(rawGate) ? 1.0 : rawGate;
    const regime = row.csd_status?.regime || (gate > 0 ? 'EIGEN_EXPANSION' : 'THROTTLED');

    return {
      ...row,
      gCsd,
      rhoConc,
      l1QuantErr,
      normRatio,
      totalFees,
      makerFills,
      takerFills,
      gtxRejects,
      gate,
      regime,
    };
  }

