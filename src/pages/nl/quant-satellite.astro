  function renderSection3(latest: any, history: any[], livePricesMap?: Record<string, number>) {
    const v31 = extractV31Meta(latest, history);
    const positions = latest?.gonogo_report?.positions_v31 || latest?.positions_lots || latest?.positions || {};
