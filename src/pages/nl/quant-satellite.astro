    if (timeLabel && latest.timestamp_ms) {
      const d = new Date(Number(latest.timestamp_ms));
      timeLabel.textContent = `Timestamp: ${d.toISOString().replace('T', ' ').substring(0, 19)} UTC`;
    }

    if (v31.isV31) {
      const targetRebalances = 30;
      const rebalancesCompleted = v31.execAudit.rebalances_completed;
      const pct = Math.min(100, Math.max(0, (rebalancesCompleted / targetRebalances) * 100));
      const estDaysRemaining = Math.max(0, targetRebalances - rebalancesCompleted);

      const trailingDdRatio = v31.hwmUsd > 0 ? Math.max(0, (v31.hwmUsd - v31.navUsd) / v31.hwmUsd) : 0;
      const maxDdRatio = computeHistoricalMaxDrawdownRatio(cachedTelemetryHistory, v31.initialNavUsd, trailingDdRatio);
      const absTailBeta = Math.abs(Number(latest.realized_tail_beta ?? v31.rawGonogoReport?.realized_tail_beta ?? 0));
      const gatesPass =
        v31.execAudit.avg_implied_rt_cost_bps <= 5.50 &&
        absTailBeta <= 0.030 &&
        maxDdRatio <= 0.12;

      if (barIdxTitle) barIdxTitle.textContent = 'Heartbeat:';
      if (barIdxLabel) barIdxLabel.textContent = `#${barIdx.toLocaleString()} (15s)`;
