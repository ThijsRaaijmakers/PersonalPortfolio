  const TELEMETRY_SCALAR_COLS =
    'bar_idx,timestamp_ms,created_at,venue,runtime_state,nav_usd,wallet_balance_usd,unrealized_pnl_usd,realized_pnl_usd,total_fees_usd,drawdown_pct,gross_leverage,net_dollar_exposure,realized_tail_beta,z_stress,regime_gate_global,maker_taker_ratio';
  const MAX_HISTORY_ROWS = 50000;

  function normalizeAndSortTelemetryRows(rows: any[]): any[] {
    const map = new Map<string | number, any>();
    for (const r of rows) {
      if (!r) continue;
      const key = r.bar_idx != null ? Number(r.bar_idx) : Number(r.timestamp_ms || 0);
      const existing = map.get(key);
      if (!existing || (!existing.gonogo_report && r.gonogo_report)) {
        map.set(key, r);
      }
    }
    return Array.from(map.values()).sort((a, b) => {
      const dt = Number(a?.timestamp_ms || 0) - Number(b?.timestamp_ms || 0);
      if (dt !== 0) return dt;
      return Number(a?.bar_idx || 0) - Number(b?.bar_idx || 0);
    });
  }

  // Paginated telemetry fetcher (descending from newest + delta merge on auto-poll)
  async function fetchAllTelemetryHistory(
    venue: TradingVenue,
    isIncrementalPoll = false
  ): Promise<any[]> {
    const { data: latestRowData } = await supabase
      .from('quant_satellite_telemetry')
      .select('*')
      .eq('venue', venue)
      .order('timestamp_ms', { ascending: false })
      .order('bar_idx', { ascending: false })
      .limit(1)
      .maybeSingle();

    const chunkSize = 1000;

    if (isIncrementalPoll && cachedHistoryVenue === venue && cachedTelemetryHistory.length > 0) {
      const lastLoadedTs = Number(
        cachedTelemetryHistory[cachedTelemetryHistory.length - 1]?.timestamp_ms || 0
      );
      const sinceTs = Math.max(0, lastLoadedTs - 60_000);
      const deltaRows: any[] = [];
      let from = 0;

      while (from < 10_000) {
        const { data, error } = await supabase
          .from('quant_satellite_telemetry')
          .select(TELEMETRY_SCALAR_COLS)
          .eq('venue', venue)
          .gt('timestamp_ms', sinceTs)
          .order('timestamp_ms', { ascending: false })
          .order('bar_idx', { ascending: false })
          .range(from, from + chunkSize - 1);

        if (error || !data || data.length === 0) break;
        deltaRows.push(...data);
        if (data.length < chunkSize) break;
        from += chunkSize;
      }

      const merged = [...cachedTelemetryHistory, ...deltaRows];
      if (latestRowData) merged.push(latestRowData);
      return normalizeAndSortTelemetryRows(merged);
    }

    const allRows: any[] = [];
    let from = 0;

    while (allRows.length < MAX_HISTORY_ROWS) {
      const { data, error } = await supabase
        .from('quant_satellite_telemetry')
        .select(TELEMETRY_SCALAR_COLS)
        .eq('venue', venue)
        .order('timestamp_ms', { ascending: false })
        .order('bar_idx', { ascending: false })
        .range(from, from + chunkSize - 1);

      if (error || !data || data.length === 0) break;
      allRows.push(...data);
      if (data.length < chunkSize) break;
      from += chunkSize;
    }

    if (latestRowData) allRows.push(latestRowData);
    return normalizeAndSortTelemetryRows(allRows);
  }

  async function loadQuantSatelliteDashboard() {
    if (!window.location.pathname.startsWith('/nl')) return;
    stripVenueFromCurrentUrl();

    // 1. Session & Role Verification
    const { data: { session } } = await supabase.auth.getSession();
    
    let isAdmin = false;
    if (session) {
      const { data: profile } = await supabase
        .from('profiles')
        .select('role')
        .eq('id', session.user.id)
        .single();
      isAdmin = profile?.role === 'admin';
    }

    if (!session || !isAdmin) {
      window.location.href = '/login?redirect=/quant-satellite';
      return;
    }

    // Uncloak Secure Enclave
    const enclave = document.getElementById('secure-enclave');
    if (enclave) {
      enclave.classList.remove('opacity-0', 'pointer-events-none');
    }

    const userIdentity = document.getElementById('user-identity');
    if (userIdentity && session?.user?.email) {
      userIdentity.textContent = `// Identity: ${session.user.email} (Clearance Level: QUANT_ADMIN)`;
    }

    const activeVenue = getActiveVenue();
    updateSatEnvButtons(activeVenue);

    // Initialize Realtime Triangle Connections
    initBinanceWebSocket();
    initSupabaseRealtime(session.access_token);
    setupChartInteractions();

    // Fetch and render initial data
    await fetchAndRenderAll(session.access_token);

    // Setup 15-second polling fallback loop
    if (pollingInterval) clearInterval(pollingInterval);
    pollingInterval = setInterval(async () => {
      const { data: { session: currentSession } } = await supabase.auth.getSession();
      if (currentSession?.access_token) {
        await fetchAndRenderAll(currentSession.access_token, true);
      }
    }, 15000);

    // Attach UI Event Listeners
    setupEventListeners(session.access_token);
  }

  async function fetchAndRenderAll(accessToken: string, isAutoPoll: boolean = false) {
    const syncTimerLabel = document.getElementById('sync-timer-label');
    const refreshIcon = document.getElementById('refresh-icon');

    if (!isAutoPoll && refreshIcon) {
      refreshIcon.classList.add('animate-spin');
    }

    try {
      const currentVenue = getActiveVenue();

      // 1. Paginated Telemetry Fetching (>10,000+ bars support, descending-first then sorted)
      let allRows: any[] = await fetchAllTelemetryHistory(currentVenue, isAutoPoll);

      // Fallback to API endpoint if client query returns empty
      if (allRows.length === 0) {
        try {
          const res = await fetch(`/api/quant/telemetry?venue=${currentVenue}&limit=25000&fields=chart&_t=${Date.now()}`, {
            headers: { 'Authorization': `Bearer ${accessToken}` },
          });
          if (res.ok) {
            const json = await res.json();
            if (json.history && Array.isArray(json.history)) {
              const combined = json.latest ? [...json.history, json.latest] : [...json.history];
              allRows = normalizeAndSortTelemetryRows(combined);
            }
          }
        } catch (e) {
          console.warn('API route fallback error:', e);
        }
      }

      cachedTelemetryHistory = allRows;
      cachedHistoryVenue = currentVenue;
      const latest = allRows.length > 0 ? allRows[allRows.length - 1] : null;

      latestTelemetryRow = latest;
      telemetryHistoryRows = cachedTelemetryHistory;

      // Render Section 1: State & N=2000 Progress
      renderSection1(latest);

      // Render Section 2: 6 KPI Cards
      renderSection2(latest);

      // Initial Binance Prices (REST fallback if WS not yet ready)
      if (Object.keys(liveMidPrices).length === 0) {
        liveMidPrices = await fetchLiveBinanceFuturesPrices();
      }

      // Re-calibrate chart view window if pinned to live
      if (isPinnedToLive) {
        recalcViewWindowToLive();
      }

      // Render Section 3: SVG Chart & Basket Table
      renderSection3(latest, cachedTelemetryHistory, liveMidPrices);

      // 2. Fetch & Render Multi-Partition Sub-Ledger
      await fetchAndRenderPartitions(accessToken);

      // 3. Fetch C2 Commands Queue
      await fetchAndRenderCommands(accessToken);

      if (syncTimerLabel) {
        const now = new Date();
        syncTimerLabel.textContent = `SYNCED ${now.toLocaleTimeString()}`;
      }
    } catch (err) {
      console.error('Error fetching dashboard telemetry:', err);
      if (syncTimerLabel) syncTimerLabel.textContent = 'SYNC ERROR';
    } finally {
      if (!isAutoPoll && refreshIcon) {
        setTimeout(() => refreshIcon.classList.remove('animate-spin'), 400);
      }
    }
  }

  function computeHistoricalMaxDrawdownRatio(history: any[], initialNav: number, trailingDdRatio: number): number {
    let runningPeak = initialNav > 0 && Math.abs(initialNav - 1e5) >= 0.01 ? initialNav : 0;
    let maxDd = 0;
    for (const r of history) {
      const hn = Number(r?.nav_usd) || 0;
      if (hn <= 0 || Math.abs(hn - 1e5) < 0.01) continue;
      if (hn > runningPeak) runningPeak = hn;
      if (runningPeak > 0) {
        const dd = Math.max(0, (runningPeak - hn) / runningPeak);
        if (dd > maxDd) maxDd = dd;
      }
    }
    return Math.max(maxDd, trailingDdRatio);
  }

  // ==========================================
  // SECTION 1 RENDERER
