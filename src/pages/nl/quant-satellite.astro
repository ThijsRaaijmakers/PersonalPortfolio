      if (progressSub) progressSub.textContent = '(Doel: 30 Guarded Hybride Rebalances)';
      if (rateSubLabel) rateSubLabel.textContent = '1 rebalance/dag om 23:52 UTC • 30-Rebalance Live Paper Audit';

      if (milestonesEl) {
        milestonesEl.innerHTML = `
          <span>0 (Deploy)</span>
          <span>7 (23%)</span>
          <span>15 (Midden Audit)</span>
          <span>22 (73%)</span>
          <span class="font-bold text-emerald-500">30 Rebalances (Go/No-Go Beslispunt)</span>
        `;
      }

      if (auditBadge) {
        if (rebalancesCompleted < 30) {
          auditBadge.textContent = `AUDITING (${rebalancesCompleted}/30)`;
          auditBadge.className = 'inline-flex items-center px-2.5 py-1 rounded-lg font-mono text-[11px] font-bold bg-amber-500/15 text-amber-500 border border-amber-500/40';
        } else if (gatesPass) {
          auditBadge.textContent = 'GO — AUDIT PASSED';
          auditBadge.className = 'inline-flex items-center px-2.5 py-1 rounded-lg font-mono text-[11px] font-bold bg-emerald-500/15 text-emerald-400 border border-emerald-500/40';
        } else {
          auditBadge.textContent = 'NO-GO — GATE BREACH';
          auditBadge.className = 'inline-flex items-center px-2.5 py-1 rounded-lg font-mono text-[11px] font-bold bg-rose-500/20 text-rose-400 border border-rose-500/50';
        }
      }

      if (estDaysLabel) {
        if (rebalancesCompleted < 30) {
          estDaysLabel.textContent = `~${estDaysRemaining}d resterend (${rebalancesCompleted} / 30 Rebalances)`;
          estDaysLabel.className = 'text-xs font-mono font-bold text-cyan-400';
        } else if (gatesPass) {
          estDaysLabel.textContent = 'GO — 30-DAGEN PAPER AUDIT GESLAAGD (ALLE GATES GROEN)';
          estDaysLabel.className = 'text-xs font-mono font-bold text-emerald-400';
        } else {
          estDaysLabel.textContent = 'NO-GO — EEN OF MEER RISICO-/KOSTENDREMPELS OVERSCHREDEN';
          estDaysLabel.className = 'text-xs font-mono font-bold text-rose-400';
        }
      }

      if (progressFill) progressFill.style.width = `${pct.toFixed(1)}%`;
      if (progressPctLabel) {
        progressPctLabel.textContent = `30-Dagen Live Paper Audit: ${rebalancesCompleted} / 30 Rebalances (${pct.toFixed(1)}%) • Nog ${estDaysRemaining}d • Doel <= 5.50 bps RT & |β| <= 0.030`;
      }
    } else {
      const evaluated = latest.gonogo_progress?.bars_evaluated ?? barIdx;
      const targetBars = latest.gonogo_progress?.target_bars ?? 2000;
      const pct = Math.min(100, Math.max(0, (evaluated / targetBars) * 100));
      const remainingBars = Math.max(0, targetBars - evaluated);
      const remainingDays = (remainingBars / 288).toFixed(1);

      if (barIdxTitle) barIdxTitle.textContent = 'Bar Index:';
      if (barIdxLabel) barIdxLabel.textContent = `#${barIdx.toLocaleString()} / 2,000`;
      if (progressTitle) progressTitle.textContent = 'N=2,000 Go/No-Go Statistische Validatieset';
      if (progressSub) progressSub.textContent = '(Doel: 2.000 Out-of-Sample Bars)';
      if (rateSubLabel) rateSubLabel.textContent = 'Gebaseerd op 288 master bars/dag (5-min intervallen)';

      if (auditBadge) {
        auditBadge.textContent = evaluated >= targetBars ? 'SAMPLE COMPLEET' : `EVALUEREN (${evaluated}/${targetBars})`;
        auditBadge.className = evaluated >= targetBars
          ? 'inline-flex items-center px-2.5 py-1 rounded-lg font-mono text-[11px] font-bold bg-emerald-500/15 text-emerald-400 border border-emerald-500/40'
          : 'inline-flex items-center px-2.5 py-1 rounded-lg font-mono text-[11px] font-bold bg-amber-500/15 text-amber-500 border border-amber-500/40';
      }

      if (estDaysLabel) {
        if (evaluated >= targetBars) {
          estDaysLabel.textContent = 'GO/NO-GO SAMPLE COMPLEET (N >= 2,000)';
          estDaysLabel.className = 'text-xs font-mono font-bold text-emerald-400';
        } else {
          estDaysLabel.textContent = `~${remainingDays} Dagen Resterend (${remainingBars} bars @ 288/dag)`;
          estDaysLabel.className = 'text-xs font-mono font-bold text-cyan-400';
        }
      }

      if (progressFill) progressFill.style.width = `${pct.toFixed(1)}%`;
      if (progressPctLabel) {
        progressPctLabel.textContent = `${pct.toFixed(1)}% (${evaluated.toLocaleString()} / ${targetBars.toLocaleString()} Bars)`;
      }
    }
  }

