  function lowerBoundByTs(rows: any[], targetTs: number): number {
    let lo = 0;
    let hi = rows.length;
    while (lo < hi) {
      const mid = (lo + hi) >> 1;
      if (Number(rows[mid]?.timestamp_ms || 0) < targetTs) {
        lo = mid + 1;
      } else {
        hi = mid;
      }
    }
    return lo;
  }

  function upperBoundByTs(rows: any[], targetTs: number): number {
    let lo = 0;
    let hi = rows.length;
    while (lo < hi) {
      const mid = (lo + hi) >> 1;
      if (Number(rows[mid]?.timestamp_ms || 0) <= targetTs) {
        lo = mid + 1;
      } else {
        hi = mid;
      }
    }
    return lo;
  }

  function formatDurationSpan(spanMs: number): string {
    if (spanMs <= 0) return '0m';
    const totalMins = Math.round(spanMs / 60_000);
    if (totalMins < 60) return `${totalMins}m`;
    const totalHours = spanMs / 3_600_000;
    if (totalHours < 48) return `${totalHours.toFixed(1)}h`;
    const days = Math.floor(totalHours / 24);
    const remHours = Math.round(totalHours % 24);
    return remHours > 0 ? `${days}d ${remHours}h` : `${days}d`;
  }

  function formatAxisTimeUtc(tsMs: number, spanMs: number, includeDateEdge: boolean): string {
    const d = new Date(tsMs);
    if (isNaN(d.getTime())) return '--';
    const iso = d.toISOString();
    const mmdd = iso.substring(5, 10);
    const hhmm = iso.substring(11, 16);
    if (spanMs > 30 * 3_600_000 || includeDateEdge) {
      return `${mmdd} ${hhmm}`;
    }
    return hhmm;
  }

  // Min-Max time-bucket downsampling preserving exact viewport boundaries, peaks & troughs
  function downsampleBarsMinMax(bars: any[], numBuckets = 400): any[] {
    if (bars.length <= 800) return bars;
    const n = bars.length;
    const minTs = Number(bars[0]?.timestamp_ms || 0);
    const maxTs = Number(bars[n - 1]?.timestamp_ms || 0);
    const tsSpan = maxTs - minTs;

    const bucketStats = new Map<
      number,
      { firstIdx: number; lastIdx: number; minIdx: number; minVal: number; maxIdx: number; maxVal: number }
    >();

    for (let i = 0; i < n; i++) {
      const b =
        tsSpan > 0
          ? Math.min(numBuckets - 1, Math.floor(((Number(bars[i]?.timestamp_ms || 0) - minTs) / tsSpan) * numBuckets))
          : Math.min(numBuckets - 1, Math.floor((i / n) * numBuckets));
      const nav = Number(bars[i]?.nav_usd) || 0;
      const cur = bucketStats.get(b);
      if (!cur) {
        bucketStats.set(b, {
          firstIdx: i,
          lastIdx: i,
          minIdx: i,
          minVal: nav,
          maxIdx: i,
          maxVal: nav,
        });
      } else {
        cur.lastIdx = i;
        if (nav < cur.minVal) {
          cur.minVal = nav;
          cur.minIdx = i;
        }
        if (nav > cur.maxVal) {
          cur.maxVal = nav;
          cur.maxIdx = i;
        }
      }
    }

    const keepIndices = new Set<number>([0, n - 1]);
    for (const stat of bucketStats.values()) {
      keepIndices.add(stat.firstIdx);
      keepIndices.add(stat.minIdx);
      keepIndices.add(stat.maxIdx);
      keepIndices.add(stat.lastIdx);
    }

    const sortedIdx = Array.from(keepIndices).sort((a, b) => a - b);
    return sortedIdx.map((idx) => bars[idx]);
  }

  // Recalibrate chart window using true timestamp_ms calendar durations
  function recalcViewWindowToLive() {
    const total = cachedTelemetryHistory.length;
    if (total === 0) {
      viewStartIdx = 0;
      viewEndIdx = -1;
      isPinnedToLive = true;
      updateJumpToLiveBtn();
      return;
    }

    if (activeChartWindow === 'all') {
      viewStartIdx = 0;
      viewEndIdx = total - 1;
      isPinnedToLive = true;
      updateJumpToLiveBtn();
      return;
    }

    const durationMs = TIMEFRAME_MS_MAP[activeChartWindow];
    const firstTs = Number(cachedTelemetryHistory[0]?.timestamp_ms || 0);
    const latestTs = Number(cachedTelemetryHistory[total - 1]?.timestamp_ms || 0);
    const cutoffMs = latestTs - durationMs;

    if (firstTs >= cutoffMs) {
      viewStartIdx = 0;
      viewEndIdx = total - 1;
    } else {
      const startIdx = lowerBoundByTs(cachedTelemetryHistory, cutoffMs);
      viewStartIdx = Math.max(0, Math.min(total - 1, startIdx));
      viewEndIdx = total - 1;
    }

    isPinnedToLive = true;
    updateJumpToLiveBtn();
  }

  function updateJumpToLiveBtn() {
    const jumpBtn = document.getElementById('chart-jump-live-btn');
    if (!jumpBtn) return;
    if (!isPinnedToLive && cachedTelemetryHistory.length > 0) {
      jumpBtn.classList.remove('hidden');
    } else {
      jumpBtn.classList.add('hidden');
    }
  }

  function renderChart(history: any[]) {
    const emptyState = document.getElementById('chart-empty-state');
    const navArea = document.getElementById('chart-nav-area');
    const navPath = document.getElementById('chart-nav-path');
    const betaPath = document.getElementById('chart-beta-path');
    const gridLines = document.getElementById('chart-grid-lines');
    const yLabels = document.getElementById('chart-y-labels');
    const xLabels = document.getElementById('chart-x-labels');
    const highLowGuides = document.getElementById('chart-high-low-guides');
    const betaThresholdLine = document.getElementById('chart-beta-threshold-line');
    const betaThresholdLabel = document.getElementById('chart-beta-threshold-label');
    const stopToggleLabel = document.getElementById('toggle-series-stop-label');
    const chartSubtitle = document.getElementById('chart-subtitle');
    const periodReturnEl = document.getElementById('chart-period-return');
    const periodStatsEl = document.getElementById('chart-period-stats');

    if (!history || history.length === 0) {
      if (emptyState) emptyState.classList.remove('hidden');
      if (navArea) navArea.setAttribute('d', '');
      if (navPath) navPath.setAttribute('d', '');
      if (betaPath) betaPath.setAttribute('d', '');
      if (gridLines) gridLines.innerHTML = '';
      if (yLabels) yLabels.innerHTML = '';
      if (xLabels) xLabels.innerHTML = '';
      if (highLowGuides) highLowGuides.innerHTML = '';
      if (periodReturnEl) periodReturnEl.textContent = '+$0.00 (+0.00%)';
      if (periodStatsEl) periodStatsEl.textContent = 'Periode Hoogste: -- • Periode Laagste: -- • Bars in Beeld: 0';
      return;
    }

    if (emptyState) emptyState.classList.add('hidden');

    // Inclusive slice [viewStartIdx .. viewEndIdx] clamped safely
    const safeEnd = viewEndIdx >= 0 ? Math.min(history.length - 1, viewEndIdx) : history.length - 1;
    const safeStart = Math.max(0, Math.min(safeEnd, viewStartIdx));
    let visibleBars = history.slice(safeStart, safeEnd + 1);

    if (visibleBars.length === 0) {
      visibleBars = history.slice(-1);
    }

    const v31Chart = extractV31Meta(latestTelemetryRow, history);
    const minTs = Number(visibleBars[0]?.timestamp_ms || 0);
    const maxTs = Number(visibleBars[visibleBars.length - 1]?.timestamp_ms || minTs);
    const tsSpan = Math.max(maxTs - minTs, 1);
    const spanStr = formatDurationSpan(maxTs - minTs);

    // Compute exact Period Return & High/Low over full un-downsampled visible slice
    const firstNav = Number(visibleBars[0]?.nav_usd) || v31Chart.initialNavUsd;
    const lastNav = Number(visibleBars[visibleBars.length - 1]?.nav_usd) || firstNav;
    const deltaNav = lastNav - firstNav;
    const deltaPct = firstNav > 0 ? (deltaNav / firstNav) * 100 : 0;

    let periodMinNav = Infinity;
    let periodMaxNav = -Infinity;
    let maxObservedBeta = 0.045;
    for (const d of visibleBars) {
      const nv = Number(d.nav_usd) || 0;
      if (nv < periodMinNav) periodMinNav = nv;
      if (nv > periodMaxNav) periodMaxNav = nv;
      const tb = Number(d.realized_tail_beta) || 0;
      if (tb > maxObservedBeta) maxObservedBeta = tb;
    }
    if (!Number.isFinite(periodMinNav)) periodMinNav = firstNav;
    if (!Number.isFinite(periodMaxNav)) periodMaxNav = firstNav;

    // Update Subtitle & Period Stats
    if (chartSubtitle) {
      chartSubtitle.textContent = `// MULTI-BAR TELEMETRIE (${visibleBars.length.toLocaleString()} BARS IN BEELD • SPAN: ${spanStr} • TOTAAL GELADEN: ${history.length.toLocaleString()})`;
    }

    if (periodReturnEl) {
      const sign = deltaNav >= 0 ? '+' : '-';
      periodReturnEl.textContent = `${sign}${formatUsd(Math.abs(deltaNav))} (${deltaNav >= 0 ? '+' : ''}${deltaPct.toFixed(2)}%)`;
      periodReturnEl.className = deltaNav >= 0
        ? 'px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/30'
        : 'px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-rose-500/10 text-rose-400 border border-rose-500/30';
    }

    if (periodStatsEl) {
      periodStatsEl.textContent = `Periode Hoogste: ${formatUsd(periodMaxNav)} • Periode Laagste: ${formatUsd(periodMinNav)} • Bars in Beeld: ${visibleBars.length.toLocaleString()} • Span: ${spanStr}`;
    }

    // Min-Max downsampling for smooth 60fps rendering when viewport exceeds 800 rows
    const renderBars = downsampleBarsMinMax(visibleBars, 400);

    // Canvas layout dimensions
    const width = 1100;
    const height = 340;
    const padLeft = 65;
    const padRight = 65;
    const padTop = 30;
    const padBottom = 35;
    const chartW = width - padLeft - padRight;
    const chartH = height - padTop - padBottom;

    // NAV min & max with margin
    let minNav = periodMinNav;
    let maxNav = periodMaxNav;
    if (minNav === maxNav) {
      minNav *= 0.98;
      maxNav *= 1.02;
    }
    const navMargin = (maxNav - minNav) * 0.08 || 100;
    minNav = Math.max(0, minNav - navMargin);
    maxNav = maxNav + navMargin;

    // Beta min & max
    const minBeta = 0.0;
    const maxBeta = maxObservedBeta;

    // Time-proportional X coordinate scaling (prevents gaps / varying bar frequencies from warping time)
    const scaleXByTs = (ts: number) => {
      if (renderBars.length <= 1 || maxTs <= minTs) return padLeft + chartW / 2;
      return padLeft + ((ts - minTs) / tsSpan) * chartW;
    };

    const scaleYNav = (val: number) => {
      return padTop + chartH - ((val - minNav) / (maxNav - minNav)) * chartH;
    };

    const scaleYBeta = (val: number) => {
      return padTop + chartH - ((val - minBeta) / (maxBeta - minBeta)) * chartH;
    };

    // Draw Horizontal Grid Lines, Y-Axis Labels & Time-Proportional X-Axis Ticks
    if (gridLines && yLabels) {
      let gridHtml = '';
      let labelHtml = '';
      let xLabelHtml = '';

      for (let i = 0; i <= 4; i++) {
        const frac = i / 4;
        const y = padTop + chartH * (1 - frac);
        const navVal = minNav + frac * (maxNav - minNav);
        const betaVal = minBeta + frac * (maxBeta - minBeta);

        gridHtml += `<line x1="${padLeft}" y1="${y}" x2="${width - padRight}" y2="${y}" />`;
        if (showSeriesNav) {
          labelHtml += `<text x="${padLeft - 8}" y="${y + 3}" text-anchor="end">${formatUsd(navVal)}</text>`;
        }
        if (showSeriesBeta) {
          labelHtml += `<text x="${width - padRight + 8}" y="${y + 3}" text-anchor="start" fill="#fbbf24">${betaVal.toFixed(3)}</text>`;
        }

        if (maxTs > minTs) {
          const tickTs = minTs + frac * tsSpan;
          const x = padLeft + frac * chartW;
          const anchor = i === 0 ? 'start' : i === 4 ? 'end' : 'middle';
          gridHtml += `<line x1="${x.toFixed(1)}" y1="${padTop}" x2="${x.toFixed(1)}" y2="${padTop + chartH}" />`;
          xLabelHtml += `<text x="${x.toFixed(1)}" y="${padTop + chartH + 16}" text-anchor="${anchor}">${formatAxisTimeUtc(tickTs, maxTs - minTs, i === 0 || i === 4)} UTC</text>`;
        }
      }

      gridLines.innerHTML = gridHtml;
      yLabels.innerHTML = labelHtml;
      if (xLabels) xLabels.innerHTML = xLabelHtml;
    }

    // Draw High / Low Guide Lines
    if (highLowGuides) {
      if (showSeriesNav && renderBars.length > 0) {
        const yHigh = scaleYNav(periodMaxNav);
        const yLow = scaleYNav(periodMinNav);
        highLowGuides.innerHTML = `
          <line x1="${padLeft}" y1="${yHigh}" x2="${width - padRight}" y2="${yHigh}" stroke="#34d399" stroke-width="0.75" stroke-dasharray="3,3" opacity="0.6" />
          <text x="${width - padRight - 6}" y="${yHigh - 4}" fill="#34d399" font-size="9" font-family="monospace" text-anchor="end">HIGH: ${formatUsd(periodMaxNav)}</text>
          <line x1="${padLeft}" y1="${yLow}" x2="${width - padRight}" y2="${yLow}" stroke="#f87171" stroke-width="0.75" stroke-dasharray="3,3" opacity="0.6" />
          <text x="${width - padRight - 6}" y="${yLow + 11}" fill="#f87171" font-size="9" font-family="monospace" text-anchor="end">LOW: ${formatUsd(periodMinNav)}</text>
        `;
      } else {
        highLowGuides.innerHTML = '';
      }
    }

    // Beta threshold reference line (0.030 Stop in v3.1, 0.035 legacy)
    const betaStopLimit = v31Chart.isV31 || history.length === 0 ? 0.030 : 0.035;
    const thresholdY = scaleYBeta(betaStopLimit);
    if (betaThresholdLine) {
      if (showSeriesStop) {
        betaThresholdLine.setAttribute('y1', thresholdY.toString());
        betaThresholdLine.setAttribute('y2', thresholdY.toString());
        betaThresholdLine.setAttribute('x1', padLeft.toString());
        betaThresholdLine.setAttribute('x2', (width - padRight).toString());
        betaThresholdLine.style.display = '';
      } else {
        betaThresholdLine.style.display = 'none';
      }
    }
    if (betaThresholdLabel) {
      betaThresholdLabel.textContent = `β STOP: ${betaStopLimit.toFixed(3)}`;
      if (showSeriesStop) {
        betaThresholdLabel.setAttribute('y', (thresholdY - 4).toString());
        betaThresholdLabel.setAttribute('x', (width - padRight - 5).toString());
        betaThresholdLabel.style.display = '';
      } else {
        betaThresholdLabel.style.display = 'none';
      }
    }
    if (stopToggleLabel) {
      stopToggleLabel.textContent = `≤ ${betaStopLimit.toFixed(3)} Stop`;
    }

    // Build Curve Points & Paths using time-proportional X scale
    const navPoints = renderBars.map((d) => ({
      x: scaleXByTs(Number(d.timestamp_ms || 0)),
      y: scaleYNav(Number(d.nav_usd) || 0),
      data: d,
    }));

    const betaPoints = renderBars.map((d) => ({
      x: scaleXByTs(Number(d.timestamp_ms || 0)),
      y: scaleYBeta(Number(d.realized_tail_beta) || 0),
    }));

    lastVisiblePoints = {
      navPoints,
      betaPoints,
      firstNav,
    };

    const navPathD = navPoints.map((p, i) => `${i === 0 ? 'M' : 'L'} ${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join(' ');
    const betaPathD = betaPoints.map((p, i) => `${i === 0 ? 'M' : 'L'} ${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join(' ');

    const baselineY = padTop + chartH;
    const navAreaD = navPoints.length > 0
      ? `${navPathD} L ${navPoints[navPoints.length - 1].x.toFixed(1)} ${baselineY} L ${navPoints[0].x.toFixed(1)} ${baselineY} Z`
      : '';

    if (navPath) {
      navPath.setAttribute('d', showSeriesNav ? navPathD : '');
      navPath.style.display = showSeriesNav ? '' : 'none';
    }
    if (navArea) {
      navArea.setAttribute('d', showSeriesNav ? navAreaD : '');
      navArea.style.display = showSeriesNav ? '' : 'none';
    }
    if (betaPath) {
      betaPath.setAttribute('d', showSeriesBeta ? betaPathD : '');
      betaPath.style.display = showSeriesBeta ? '' : 'none';
    }
  }

  // TradingView Time-Proportional Drag-to-Pan and Mouse Wheel Zoom
  function setupChartInteractions() {
    const svgEl = document.getElementById('telemetry-chart-svg');
    if (!svgEl || svgEl.dataset.interactionsBound) return;
    svgEl.dataset.interactionsBound = 'true';

    const width = 1100;
    const padLeft = 65;
    const padRight = 65;
    const chartW = width - padLeft - padRight;

    const getSvgX = (clientX: number) => {
      const rect = svgEl.getBoundingClientRect();
      return ((clientX - rect.left) / rect.width) * width;
    };

    const onPointerDown = (e: MouseEvent | TouchEvent) => {
      if (cachedTelemetryHistory.length <= 1) return;
      const clientX = 'touches' in e ? e.touches[0].clientX : (e as MouseEvent).clientX;
      const svgX = getSvgX(clientX);
      if (svgX < padLeft || svgX > width - padRight) return;

      const curEnd = viewEndIdx >= 0 ? Math.min(cachedTelemetryHistory.length - 1, viewEndIdx) : cachedTelemetryHistory.length - 1;
      const curStart = Math.max(0, Math.min(curEnd, viewStartIdx));

      isDragging = true;
      dragStartX = clientX;
      dragStartMinTs = Number(cachedTelemetryHistory[curStart]?.timestamp_ms || 0);
      dragStartMaxTs = Number(cachedTelemetryHistory[curEnd]?.timestamp_ms || dragStartMinTs);
      svgEl.style.cursor = 'grabbing';
    };

    const onPointerMove = (e: MouseEvent | TouchEvent) => {
      const clientX = 'touches' in e ? e.touches[0].clientX : (e as MouseEvent).clientX;

      if (isDragging && cachedTelemetryHistory.length > 1) {
        const deltaX = clientX - dragStartX;
        const rect = svgEl.getBoundingClientRect();
        const deltaRatio = deltaX / Math.max(1, rect.width);
        const visibleSpanMs = Math.max(60_000, dragStartMaxTs - dragStartMinTs);
        const shiftMs = deltaRatio * visibleSpanMs;

        const globalMinTs = Number(cachedTelemetryHistory[0]?.timestamp_ms || 0);
        const globalMaxTs = Number(cachedTelemetryHistory[cachedTelemetryHistory.length - 1]?.timestamp_ms || 0);

        let newMinTs = dragStartMinTs - shiftMs;
        let newMaxTs = dragStartMaxTs - shiftMs;

        if (newMinTs < globalMinTs) {
          newMinTs = globalMinTs;
          newMaxTs = Math.min(globalMaxTs, globalMinTs + visibleSpanMs);
        }
        if (newMaxTs > globalMaxTs) {
          newMaxTs = globalMaxTs;
          newMinTs = Math.max(globalMinTs, globalMaxTs - visibleSpanMs);
        }

        let newStart = Math.max(0, Math.min(cachedTelemetryHistory.length - 1, lowerBoundByTs(cachedTelemetryHistory, newMinTs)));
        let newEnd = Math.max(newStart, Math.min(cachedTelemetryHistory.length - 1, upperBoundByTs(cachedTelemetryHistory, newMaxTs) - 1));
        if (newEnd === newStart && newStart > 0) newStart--;

        viewStartIdx = newStart;
        viewEndIdx = newEnd;
        isPinnedToLive = viewEndIdx >= cachedTelemetryHistory.length - 1;
        updateJumpToLiveBtn();
        renderChart(cachedTelemetryHistory);
        return;
      }

      handleChartHover(clientX);
    };

    const onPointerUp = () => {
      if (isDragging) {
        isDragging = false;
        svgEl.style.cursor = 'crosshair';
      }
    };

    const onWheel = (e: WheelEvent) => {
      e.preventDefault();
      if (cachedTelemetryHistory.length <= 5) return;

      const globalMinTs = Number(cachedTelemetryHistory[0]?.timestamp_ms || 0);
      const globalMaxTs = Number(cachedTelemetryHistory[cachedTelemetryHistory.length - 1]?.timestamp_ms || 0);
      const globalSpanMs = Math.max(60_000, globalMaxTs - globalMinTs);

      const curEnd = viewEndIdx >= 0 ? Math.min(cachedTelemetryHistory.length - 1, viewEndIdx) : cachedTelemetryHistory.length - 1;
      const curStart = Math.max(0, Math.min(curEnd, viewStartIdx));
      const curMinTs = Number(cachedTelemetryHistory[curStart]?.timestamp_ms || globalMinTs);
      const curMaxTs = Number(cachedTelemetryHistory[curEnd]?.timestamp_ms || globalMaxTs);
      const curSpanMs = Math.max(60_000, curMaxTs - curMinTs);

      const zoomFactor = e.deltaY > 0 ? 1.25 : 0.8;
      const minZoomMs = Math.min(globalSpanMs, 5 * 60_000);
      const newSpanMs = Math.max(minZoomMs, Math.min(globalSpanMs, curSpanMs * zoomFactor));

      const svgX = getSvgX(e.clientX);
      const frac = Math.max(0, Math.min(1, (svgX - padLeft) / chartW));
      const centerTs = curMinTs + frac * curSpanMs;

      let newMinTs = centerTs - frac * newSpanMs;
      let newMaxTs = newMinTs + newSpanMs;

      if (newMinTs < globalMinTs) {
        newMinTs = globalMinTs;
        newMaxTs = Math.min(globalMaxTs, newMinTs + newSpanMs);
      }
      if (newMaxTs > globalMaxTs) {
        newMaxTs = globalMaxTs;
        newMinTs = Math.max(globalMinTs, newMaxTs - newSpanMs);
      }

      let newStart = Math.max(0, Math.min(cachedTelemetryHistory.length - 1, lowerBoundByTs(cachedTelemetryHistory, newMinTs)));
      let newEnd = Math.max(newStart, Math.min(cachedTelemetryHistory.length - 1, upperBoundByTs(cachedTelemetryHistory, newMaxTs) - 1));
      if (newEnd === newStart && newStart > 0) newStart--;

      viewStartIdx = newStart;
      viewEndIdx = newEnd;
      isPinnedToLive = viewEndIdx >= cachedTelemetryHistory.length - 1;
      updateJumpToLiveBtn();
      renderChart(cachedTelemetryHistory);
    };

    svgEl.addEventListener('mousedown', onPointerDown);
    svgEl.addEventListener('touchstart', onPointerDown, { passive: true });

    window.addEventListener('mousemove', onPointerMove);
    window.addEventListener('touchmove', onPointerMove, { passive: true });

    window.addEventListener('mouseup', onPointerUp);
    window.addEventListener('touchend', onPointerUp);

    svgEl.addEventListener('wheel', onWheel, { passive: false });

    const jumpBtn = document.getElementById('chart-jump-live-btn');
    jumpBtn?.addEventListener('click', () => {
      recalcViewWindowToLive();
      renderChart(cachedTelemetryHistory);
    });
  }

  function handleChartHover(clientX: number) {
    const svgEl = document.getElementById('telemetry-chart-svg');
    const crosshairGroup = document.getElementById('chart-crosshair-group');
    const crosshairV = document.getElementById('crosshair-v');
    const dotNav = document.getElementById('crosshair-nav-dot');
    const dotBeta = document.getElementById('crosshair-beta-dot');
    const hud = document.getElementById('chart-crosshair-hud');
    const tipMeta = document.getElementById('tip-bar-meta');
    const tipNav = document.getElementById('tip-nav-val');
    const tipBeta = document.getElementById('tip-beta-val');
    const tipLev = document.getElementById('tip-lev-val');

    if (!svgEl || !lastVisiblePoints || lastVisiblePoints.navPoints.length === 0) {
      if (crosshairGroup) crosshairGroup.setAttribute('opacity', '0');
      if (hud) hud.classList.add('hidden');
      return;
    }

    const rect = svgEl.getBoundingClientRect();
    const width = 1100;
    const padLeft = 65;
    const padRight = 65;
    const mouseX = ((clientX - rect.left) / rect.width) * width;

    if (mouseX < padLeft || mouseX > width - padRight) {
      if (crosshairGroup) crosshairGroup.setAttribute('opacity', '0');
      if (hud) hud.classList.add('hidden');
      return;
    }

    const { navPoints: pts, betaPoints: bpts, firstNav: startNav } = lastVisiblePoints;
    let nearestIdx = 0;
    let minDist = Infinity;
    for (let i = 0; i < pts.length; i++) {
      const dist = Math.abs(pts[i].x - mouseX);
      if (dist < minDist) {
        minDist = dist;
        nearestIdx = i;
      }
    }

    const np = pts[nearestIdx];
    const bp = bpts[nearestIdx];
    const record = np.data;

    if (crosshairGroup) crosshairGroup.setAttribute('opacity', '1');
    if (crosshairV) {
      crosshairV.setAttribute('x1', np.x.toString());
      crosshairV.setAttribute('x2', np.x.toString());
    }
    if (dotNav) {
      if (showSeriesNav) {
        dotNav.setAttribute('cx', np.x.toString());
        dotNav.setAttribute('cy', np.y.toString());
        dotNav.style.display = '';
      } else {
        dotNav.style.display = 'none';
      }
    }
    if (dotBeta) {
      if (showSeriesBeta) {
        dotBeta.setAttribute('cx', bp.x.toString());
        dotBeta.setAttribute('cy', bp.y.toString());
        dotBeta.style.display = '';
      } else {
        dotBeta.style.display = 'none';
      }
    }

    if (hud && tipMeta && tipNav && tipBeta && tipLev) {
      const d = new Date(Number(record.timestamp_ms));
      const timeStr = isNaN(d.getTime()) ? '--' : d.toISOString().replace('T', ' ').substring(0, 19);
      tipMeta.textContent = `Bar #${record.bar_idx} • ${timeStr} UTC`;

      const bNav = Number(record.nav_usd) || 0;
      const diffVsStart = bNav - startNav;
      const signVsStart = diffVsStart >= 0 ? '+' : '-';
      tipNav.textContent = `${formatUsd(bNav)} (${signVsStart}${formatUsd(Math.abs(diffVsStart))})`;

      const bBeta = Number(record.realized_tail_beta) || 0;
      tipBeta.textContent = `${bBeta >= 0 ? '+' : ''}${bBeta.toFixed(4)}`;

      const bLev = Number(record.gross_leverage ?? 0);
      tipLev.textContent = `${bLev.toFixed(2)}x`;

      hud.classList.remove('hidden');
    }
  }

  // ==========================================
  // REAL-TIME CONNECTIVITY TRIANGLE
  // ==========================================
  function initBinanceWebSocket() {
    if (typeof window === 'undefined') return;
    if (binanceWs) {
      try { binanceWs.close(); } catch {}
      binanceWs = null;
    }
    if (wsReconnectTimer) {
      clearTimeout(wsReconnectTimer);
      wsReconnectTimer = null;
    }

    const badge = document.getElementById('binance-ws-badge');
    const label = document.getElementById('binance-ws-label');

    try {
      const v31Positions = latestTelemetryRow?.gonogo_report?.positions_v31;
      const activePositionSymbols = (Array.isArray(v31Positions) ? v31Positions : [])
        .map((p: any) => String(p?.symbol || '').toUpperCase())
        .filter(Boolean);
      const allStreamSymbols = Array.from(new Set([...V31_TRADABLE_SYMBOLS, ...activePositionSymbols]));
      const streamQuery = allStreamSymbols.map((s) => `${s.toLowerCase()}@bookTicker`).join('/');
      const streamUrl = `wss://fstream.binance.com/stream?streams=${streamQuery}`;
      binanceWs = new WebSocket(streamUrl);

      binanceWs.onopen = () => {
        if (badge && label) {
          badge.className = 'inline-flex items-center space-x-1.5 px-2.5 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 font-mono text-[10px] font-bold shadow-sm';
          badge.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span><span id="binance-ws-label">BINANCE CLOB WS: LIVE (&lt;50ms)</span>';
        }
      };

      binanceWs.onmessage = (event) => {
        try {
          const payload = JSON.parse(event.data);
          const d = payload?.data;
          if (d && d.s && d.b && d.a) {
            const mid = (parseFloat(d.b) + parseFloat(d.a)) / 2;
            if (!isNaN(mid) && mid > 0) {
              liveMidPrices[d.s.toUpperCase()] = mid;
              scheduleThrottledUpdate();
            }
          }
        } catch {}
      };

      binanceWs.onerror = () => handleWsDisconnect();
      binanceWs.onclose = () => handleWsDisconnect();
    } catch {
      handleWsDisconnect();
    }
  }

  function handleWsDisconnect() {
    const badge = document.getElementById('binance-ws-badge');
    if (badge) {
      badge.className = 'inline-flex items-center space-x-1.5 px-2.5 py-0.5 rounded bg-amber-500/10 text-amber-500 border border-amber-500/30 font-mono text-[10px] font-bold shadow-sm';
      badge.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span><span id="binance-ws-label">BINANCE CLOB WS: RECONNECTING...</span>';
    }
    if (!wsReconnectTimer) {
      wsReconnectTimer = setTimeout(() => {
        wsReconnectTimer = null;
        initBinanceWebSocket();
      }, 4000);
    }
  }

  function scheduleThrottledUpdate() {
    const now = Date.now();
    if (now - lastTickTime >= 150) {
      lastTickTime = now;
      fastTick();
    } else if (!tickPending) {
      tickPending = true;
      setTimeout(() => {
        tickPending = false;
        lastTickTime = Date.now();
        fastTick();
      }, 150 - (now - lastTickTime));
    }
  }

  function fastTick() {
    if (!latestTelemetryRow) return;

    const v31 = extractV31Meta(latestTelemetryRow, cachedTelemetryHistory);
    const positions = latestTelemetryRow.gonogo_report?.positions_v31 || latestTelemetryRow.positions_lots || latestTelemetryRow.positions || {};
    const ledgerUpnl = v31.unrealizedPnlUsd;
    const walletBalance = v31.walletBalanceUsd;
    const navUsdInitial = v31.navUsd;

    // Recompute basket holdings with liveMidPrices
    const holdings = computeAllBasketHoldings(positions, navUsdInitial, ledgerUpnl, liveMidPrices);

    let totalGrossExposure = 0;
    let totalBasketUpnl = 0;

    for (const h of holdings) {
      totalGrossExposure += Math.abs(h.notional_usd);
      totalBasketUpnl += h.upnl_usd;
    }

    const effectiveUpnl = (holdings.length > 0 && Math.abs(totalBasketUpnl) > 0.001) ? totalBasketUpnl : ledgerUpnl;
    const liveNav = walletBalance + effectiveUpnl;

    // Update Card 1: NAV and Unrealized PnL
    const navVal = document.getElementById('nav-usd-val');
    const upnlVal = document.getElementById('unrealized-pnl-val');
    if (navVal) navVal.textContent = formatUsd(liveNav);
    if (upnlVal) {
      upnlVal.textContent = `${effectiveUpnl >= 0 ? '+' : ''}${formatUsd(effectiveUpnl)}`;
      upnlVal.className = effectiveUpnl >= 0 ? 'font-bold text-emerald-400' : 'font-bold text-rose-400';
    }

    // Update Card 1 Net Return ($ and %)
    const liveNetReturnUsd = liveNav - v31.initialNavUsd;
    const liveNetReturnPct = v31.initialNavUsd > 0 ? (liveNetReturnUsd / v31.initialNavUsd) * 100 : 0;
    const retUsdEl = document.getElementById('card1-net-return-usd');
    const retPctEl = document.getElementById('card1-net-return-pct');
    if (retUsdEl) {
      retUsdEl.textContent = `${liveNetReturnUsd >= 0 ? '+' : ''}${formatUsd(liveNetReturnUsd)}`;
      retUsdEl.className = liveNetReturnUsd >= 0 ? 'font-bold text-emerald-400' : 'font-bold text-rose-400';
    }
    if (retPctEl) {
      retPctEl.textContent = `${liveNetReturnPct >= 0 ? '+' : ''}${liveNetReturnPct.toFixed(2)}%`;
      retPctEl.className = liveNetReturnPct >= 0 ? 'font-bold text-emerald-400' : 'font-bold text-rose-400';
    }

    // Update Holdings Table
    renderBasketTable(positions, liveNav, effectiveUpnl, liveMidPrices);

    // Update Card 6 & Multi-Partition Ledger
    updatePoolSubLedger(liveNav, v31.initialNavUsd);
  }

  function initSupabaseRealtime(accessToken: string) {
    if (realtimeChannel) {
      try { supabase.removeChannel(realtimeChannel); } catch {}
      realtimeChannel = null;
    }

    const vpsBadge = document.getElementById('vps-realtime-badge');

    realtimeChannel = supabase
      .channel('quant-telemetry-triangle')
      .on('postgres_changes', { event: '*', schema: 'public', table: 'quant_satellite_telemetry' }, (payload) => {
        const row = payload.new as any;
        if (row && (row.venue || 'paper') === getActiveVenue()) {
          latestTelemetryRow = row;
          const idx = cachedTelemetryHistory.findIndex(r =>
            (row.id != null && r.id === row.id) ||
            (row.bar_idx != null && r.bar_idx === row.bar_idx) ||
            (r.bar_idx === row.bar_idx && r.timestamp_ms === row.timestamp_ms)
          );
          if (idx >= 0) {
            cachedTelemetryHistory[idx] = row;
          } else {
            cachedTelemetryHistory.push(row);
          }
          cachedTelemetryHistory = normalizeAndSortTelemetryRows(cachedTelemetryHistory);
          telemetryHistoryRows = cachedTelemetryHistory;

          renderSection1(latestTelemetryRow);
          renderSection2(latestTelemetryRow);

          if (isPinnedToLive) {
            recalcViewWindowToLive();
          }
          renderSection3(latestTelemetryRow, cachedTelemetryHistory, liveMidPrices);
          updatePoolSubLedger();
        }
      })
      .on('postgres_changes', { event: '*', schema: 'public', table: 'quant_satellite_commands' }, async () => {
        await fetchAndRenderCommands(accessToken);
      })
      .on('postgres_changes', { event: '*', schema: 'public', table: 'quant_pool_partitions' }, async () => {
        await fetchAndRenderPartitions(accessToken);
      })
      .subscribe((status) => {
        if (status === 'SUBSCRIBED') {
          if (vpsBadge) {
            vpsBadge.className = 'inline-flex items-center space-x-1.5 px-2.5 py-0.5 rounded bg-cyan-500/10 text-cyan-400 border border-cyan-500/30 font-mono text-[10px] font-bold shadow-sm';
            vpsBadge.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span><span id="vps-realtime-label">TOKYO VPS REALTIME: CONNECTED</span>';
          }
        } else {
          if (vpsBadge) {
            vpsBadge.className = 'inline-flex items-center space-x-1.5 px-2.5 py-0.5 rounded bg-slate-200/80 dark:bg-slate-800/80 text-slate-500 border border-slate-300 dark:border-slate-700 font-mono text-[10px] font-bold shadow-sm';
            vpsBadge.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span><span id="vps-realtime-label">TOKYO VPS: CONNECTING...</span>';
          }
        }
      });
  }

  // ==========================================
  // MULTI-PARTITION & HWM SUB-LEDGER
  // ==========================================
  async function fetchAndRenderPartitions(accessToken: string) {
    try {
      const res = await fetch('/api/quant/partitions', {
        headers: {
          'Authorization': `Bearer ${accessToken}`,
        },
      });
      if (res.ok) {
        const json = await res.json();
        if (json.ok && Array.isArray(json.partitions)) {
          currentPartitions = json.partitions;
          updatePoolSubLedger();
        }
      }
    } catch (e) {
      console.warn('Error fetching pool partitions:', e);
    }
  }

  function updatePoolSubLedger(liveNavOverride?: number, initialBaselineOverride?: number) {
    if (currentPartitions.length === 0) return;

    const v31 = extractV31Meta(latestTelemetryRow, cachedTelemetryHistory);
    const liveNav = liveNavOverride !== undefined
      ? liveNavOverride
      : v31.navUsd;

    const initialBaseline = initialBaselineOverride !== undefined
      ? initialBaselineOverride
      : v31.initialNavUsd;

    const valResult = computePoolPartitionValuations(currentPartitions, liveNav, initialBaseline);
    latestValuationResult = valResult;

    // Update Card 6 Metrics
    const unitPriceEl = document.getElementById('pool-gross-unit-price');
    const partitionsCountEl = document.getElementById('pool-active-partitions-count');
    const thijsFeesEl = document.getElementById('pool-thijs-accrued-fees');
    const totalNetValEl = document.getElementById('pool-total-net-val');
    const masterShareEl = document.getElementById('pool-master-share-pct');

    if (unitPriceEl) {
      unitPriceEl.textContent = `$${valResult.grossUnitPrice.toFixed(4)}`;
    }
    if (partitionsCountEl) {
      const activeCount = valResult.valuations.filter(v => v.status === 'ACTIVE').length;
      partitionsCountEl.textContent = `${activeCount} ACTIVE ${activeCount === 1 ? 'NODE' : 'NODES'}`;
    }
    if (thijsFeesEl) {
      thijsFeesEl.textContent = `+$${valResult.totalAccruedFeesFromOthers.toFixed(2)}`;
    }
    if (totalNetValEl) {
      totalNetValEl.textContent = formatUsd(valResult.totalNetPoolUsd);
    }
    if (masterShareEl) {
      const masterVal = valResult.valuations.find(v => v.is_master);
      masterShareEl.textContent = `${(masterVal?.pool_share_pct || 100).toFixed(1)}%`;
    }

    // Update Section 5 Table & Footer
    renderPartitionsTable(valResult);
  }

  function renderPartitionsTable(valResult: PoolValuationResult) {
    const tbody = document.getElementById('partitions-table-body');
    const footerUnits = document.getElementById('pool-footer-total-units');
    const footerGross = document.getElementById('pool-footer-gross-nav');
    const footerNet = document.getElementById('pool-footer-net-equity');
    const footerFees = document.getElementById('pool-footer-total-fees');

    if (footerUnits) footerUnits.textContent = valResult.totalUnits.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (footerGross) footerGross.textContent = formatUsd(valResult.totalGrossUsd);
    if (footerNet) footerNet.textContent = formatUsd(valResult.totalNetPoolUsd);
    if (footerFees) footerFees.textContent = `+$${valResult.totalAccruedFeesFromOthers.toFixed(2)}`;

    if (!tbody) return;

    if (valResult.valuations.length === 0) {
      tbody.innerHTML = `
        <tr class="text-slate-500">
          <td colspan="10" class="py-4 text-center text-xs">
            No active pool partitions found. Click "+ Add Participant" to initialize.
          </td>
        </tr>
      `;
      return;
    }

    tbody.innerHTML = valResult.valuations.map(val => {
      const isMaster = val.is_master;
      const roleBadge = isMaster
        ? '<span class="px-1.5 py-0.5 rounded text-[9px] font-bold bg-cyan-500/15 text-cyan-400 border border-cyan-500/30">MASTER NODE</span>'
        : `<span class="px-1.5 py-0.5 rounded text-[9px] font-bold bg-slate-800 text-slate-300 border border-slate-700">${val.relation_label || 'PARTICIPANT'}</span>`;

      const roiColor = val.net_roi_pct > 0.005 ? 'text-emerald-400' : (val.net_roi_pct < -0.005 ? 'text-rose-400' : 'text-slate-400');
      const roiSign = val.net_roi_pct > 0.005 ? '+' : '';
      const feeDisplay = isMaster ? '<span class="text-slate-500">0.0% (Exempt)</span>' : `${val.performance_fee_pct.toFixed(1)}%`;
      const accruedDisplay = isMaster
        ? `<span class="text-emerald-400 font-bold">+$${valResult.totalAccruedFeesFromOthers.toFixed(2)} (Claim)</span>`
        : (val.accrued_fee_usd > 0.005 ? `<span class="text-amber-400 font-bold">+$${val.accrued_fee_usd.toFixed(2)}</span>` : '<span class="text-slate-500">$0.00</span>');

      const actionsHtml = `
        <div class="flex items-center justify-center space-x-1.5">
          <button
            type="button"
            data-action="adjust-capital"
            data-id="${val.id}"
            data-name="${val.participant_name}"
            title="Deposit or withdraw capital"
            class="partition-action-btn px-2 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 text-[10px] font-semibold border border-slate-700 transition-colors cursor-pointer"
          >
            Adjust
          </button>
          ${!isMaster ? `
            <button
              type="button"
              data-action="update-fee"
              data-id="${val.id}"
              data-name="${val.participant_name}"
              data-fee="${val.performance_fee_pct}"
              title="Update performance fee percentage"
              class="partition-action-btn px-2 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 text-[10px] font-semibold border border-slate-700 transition-colors cursor-pointer"
            >
              Fee%
            </button>
            <button
              type="button"
              data-action="delete"
              data-id="${val.id}"
              data-name="${val.participant_name}"
              title="Remove participant partition"
              class="partition-action-btn px-2 py-1 rounded bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 text-[10px] font-semibold border border-rose-500/30 transition-colors cursor-pointer"
            >
              &times;
            </button>
          ` : ''}
        </div>
      `;

      return `
        <tr class="hover:bg-slate-200/50 dark:hover:bg-slate-800/40 transition-colors">
          <td class="py-2.5 pr-3">
            <div class="flex items-center space-x-2">
              <span class="font-bold text-slate-900 dark:text-slate-100">${val.participant_name}</span>
              ${roleBadge}
            </div>
            ${val.notes ? `<div class="text-[10px] text-slate-500 truncate max-w-xs">${val.notes}</div>` : ''}
          </td>
          <td class="py-2.5 px-3 text-right text-slate-700 dark:text-slate-300">
            ${val.units_owned.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
          </td>
          <td class="py-2.5 px-3 text-right text-slate-700 dark:text-slate-300">
            ${formatUsd(val.net_invested_usd)}
          </td>
          <td class="py-2.5 px-3 text-right font-bold text-slate-900 dark:text-slate-100">
            ${formatUsd(val.net_value_usd)}
          </td>
          <td class="py-2.5 px-3 text-right text-cyan-600 dark:text-cyan-400 font-semibold">
            ${val.pool_share_pct.toFixed(2)}%
          </td>
          <td class="py-2.5 px-3 text-right font-bold ${roiColor}">
            ${roiSign}${val.net_roi_pct.toFixed(2)}%
          </td>
          <td class="py-2.5 px-3 text-right text-slate-400">
            $${val.high_water_mark_unit_price.toFixed(4)}
          </td>
          <td class="py-2.5 px-3 text-right text-slate-300">
