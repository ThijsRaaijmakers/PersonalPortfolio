---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Wachtwoord Bijwerken | Beveiligingsherstel"
  description="Stel een nieuw wachtwoord in voor je account."
>
  <div class="max-w-md w-full mx-auto py-8 sm:py-12 animate-fade-in-up">
    
    <!-- Header -->
    <div class="space-y-3 text-center mb-6 sm:mb-8">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-cyan-950/10 dark:bg-cyan-950/60 border border-cyan-500/30 font-mono text-xs text-cyan-600 dark:text-cyan-400">
        <span class="w-2 h-2 rounded-full bg-cyan-500 dark:bg-cyan-400 animate-pulse"></span>
        <span>BEVEILIGDE TERMINAL &bull; TOEGANGSCODES</span>
      </div>

      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-slate-50 font-sans tracking-tight">
        Wachtwoord Bijwerken
      </h1>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 font-mono">
        Voer je nieuwe toegangswachtwoord hieronder in.
      </p>
    </div>

    <!-- Card Container -->
    <div class="p-5 sm:p-8 rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 shadow-xl space-y-6 w-full max-w-full">
      
      <!-- Error Message Container -->
      <p id="update-error" class="hidden p-3 rounded-lg bg-red-500/10 border border-red-500/30 text-red-600 dark:text-red-400 font-mono text-xs leading-relaxed"></p>
      
      <!-- Success Message Container -->
      <p id="update-success" class="hidden p-3 rounded-lg bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 font-mono text-xs leading-relaxed"></p>

      <!-- Update Password Form -->
      <form id="update-password-form" class="space-y-5 font-mono text-xs">
        <div class="space-y-2">
          <label for="new-password" class="block text-slate-700 dark:text-slate-300 font-medium">
            &gt; Nieuw Wachtwoord
          </label>
          <div class="relative">
            <input 
              type="password" 
              id="new-password" 
              name="newPassword" 
              required
              autocomplete="new-password"
              placeholder="••••••••••••"
              class="w-full px-4 py-2.5 pr-10 rounded-lg bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 text-slate-900 dark:text-slate-100 placeholder-slate-400 dark:placeholder-slate-600 focus:outline-none focus:border-cyan-500 transition-colors"
            />
            <button 
              type="button" 
              class="toggle-password absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 focus:outline-none cursor-pointer p-1"
              aria-label="Wachtwoord zichtbaarheid wijzigen"
              data-target="new-password"
            >
              <svg class="w-4 h-4 password-eye-svg" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
              </svg>
            </button>
          </div>
        </div>

        <button 
          type="submit" 
          class="w-full py-3 rounded-lg bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold transition-all shadow-lg shadow-cyan-500/20 cursor-pointer flex items-center justify-center space-x-2"
        >
          <span>Toegangscodes Bijwerken</span>
          <span>&rarr;</span>
        </button>
      </form>

    </div>

  </div>
</Layout>

<script>
  import { updatePasswordAfterReset } from '../../lib/auth';

  function initUpdatePassword() {
    const updateForm = document.getElementById('update-password-form') as HTMLFormElement | null;
    const newPasswordInput = document.getElementById('new-password') as HTMLInputElement | null;
    const updateError = document.getElementById('update-error');
    const updateSuccess = document.getElementById('update-success');

    const EYE_NORMAL = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>`;
    const EYE_SLASHED = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858-5.908a10.025 10.025 0 013.122-.863c4.478 0 8.268 2.943 9.542 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21M3 3l18 18"></path>`;

    function clearMessages() {
      if (updateError) {
        updateError.textContent = '';
        updateError.classList.add('hidden');
      }
      if (updateSuccess) {
        updateSuccess.textContent = '';
        updateSuccess.classList.add('hidden');
      }
    }

    function showError(msg: string) {
      if (!updateError) return;
      updateError.textContent = `[FOUT]: ${msg}`;
      updateError.classList.remove('hidden');
    }

    function showSuccess(msg: string) {
      if (!updateSuccess) return;
      updateSuccess.textContent = `[SUCCES]: ${msg}`;
      updateSuccess.classList.remove('hidden');
    }

    document.querySelectorAll('.toggle-password').forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        if (!targetId) return;
        const input = document.getElementById(targetId) as HTMLInputElement | null;
        const svg = btn.querySelector('.password-eye-svg');
        if (!input || !svg) return;

        if (input.type === 'password') {
          input.type = 'text';
          svg.innerHTML = EYE_SLASHED;
        } else {
          input.type = 'password';
          svg.innerHTML = EYE_NORMAL;
        }
      });
    });

    updateForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearMessages();

      const newPassword = newPasswordInput?.value;
      if (!newPassword || newPassword.length < 6) {
        showError('Wachtwoord moet ten minste 6 tekens lang zijn.');
        return;
      }

      const { error } = await updatePasswordAfterReset(newPassword);

      if (error) {
        showError(error.message);
      } else {
        showSuccess('Wachtwoord succesvol bijgewerkt! Doorsturen naar profiel...');
        setTimeout(() => {
          window.location.href = '/nl/profile';
        }, 1500);
      }
    });
  }

  document.addEventListener('astro:page-load', initUpdatePassword);
</script>
