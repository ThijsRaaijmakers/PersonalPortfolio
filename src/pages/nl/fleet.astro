---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
---

<Layout description="Uitgebreid doorzoekbaar archief van alle FleetPort voertuigrecords." title="Auto Archief | FleetPort Logistics">
  <div id="secure-enclave" class="max-w-7xl mx-auto py-8 sm:py-12 space-y-8 animate-fade-in-up opacity-0 pointer-events-none transition-opacity duration-300">
    
    <!-- Breadcrumbs -->
    <Breadcrumbs 
      items={[
        { label: 'Home', href: '/nl' },
        { label: 'Dashboard', href: '/nl/dashboard' },
        { label: 'Auto Archief' }
      ]} 
    />

    <!-- Header Section -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-300 dark:border-slate-800 pb-6">
      <div class="space-y-1">
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-cyan-950/10 dark:bg-cyan-950/60 border border-cyan-500/30 font-mono text-xs text-cyan-600 dark:text-cyan-400">
          <span class="w-2 h-2 rounded-full bg-cyan-500 animate-pulse"></span>
          <span>DATABASE ARCHIEF &bull; DOORZOEKBARE REPOSITORY</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-slate-50 font-sans tracking-tight">
          Auto Archief
        </h1>
      </div>

      <a 
        href="/nl/dashboard"
        class="group inline-flex items-center space-x-2 px-4 py-2 rounded-lg bg-slate-100/80 dark:bg-slate-950 hover:bg-slate-200/80 dark:hover:bg-slate-900 text-slate-700 dark:text-slate-300 border border-slate-300 dark:border-slate-800 font-mono text-xs font-semibold transition-colors w-fit shadow-sm"
      >
        <svg class="w-4 h-4 text-cyan-500 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        <span>Terug naar Dashboard</span>
      </a>
    </div>

    <!-- Search Controls, Filter & Sort -->
    <div class="space-y-4 font-mono">
      <div class="flex flex-col sm:flex-row gap-3">
        <div class="relative flex-1">
          <input 
            type="text" 
            id="fleet-search" 
            placeholder="Zoek op merk, model, brandstof of kenteken..."
            class="w-full px-5 py-4 rounded-xl bg-slate-100/80 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 text-slate-900 dark:text-slate-100 placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:border-cyan-500 shadow-sm text-sm transition-colors"
          />
          <div class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
          </div>
        </div>

        <select 
          id="fleet-sort" 
          class="px-4 py-4 rounded-xl bg-slate-100/80 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 text-slate-900 dark:text-slate-100 font-mono text-xs focus:outline-none focus:border-cyan-500 shadow-sm transition-colors cursor-pointer"
        >
          <option value="date-desc">Datum (Nieuwste)</option>
          <option value="date-asc">Datum (Oudste)</option>
          <option value="hp-desc">Vermogen (Hoog naar Laag)</option>
          <option value="hp-asc">Vermogen (Laag naar Hoog)</option>
          <option value="price-desc">Waarde (Hoog naar Laag)</option>
          <option value="price-asc">Waarde (Laag naar Hoog)</option>
        </select>
      </div>

      <!-- Quick Filter Tags (Dynamically Populated) -->
      <div class="flex flex-wrap items-center gap-2 pt-1" id="quick-tags-container"></div>

      <div class="flex items-center justify-between text-xs text-slate-500 dark:text-slate-400 px-1">
        <span id="result-count">Archiefitems laden...</span>
        <span>Alle geregistreerde voertuigen</span>
      </div>
    </div>

    <!-- Loading State -->
    <div id="fleet-loading" class="py-12 text-center font-mono text-xs text-slate-500 dark:text-slate-400">
      <div class="inline-flex items-center space-x-2">
        <span class="w-2.5 h-2.5 rounded-full bg-cyan-500 animate-ping"></span>
        <span>VOERTUIGARCHIEF_OPVRAGEN...</span>
      </div>
    </div>

    <!-- Error State -->
    <div id="fleet-error" class="hidden p-4 rounded-xl bg-red-500/10 border border-red-500/30 text-red-600 dark:text-red-400 font-mono text-xs"></div>

    <!-- Fleet Grid Container -->
    <div id="fleet-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 max-h-[700px] overflow-y-auto pr-2 overflow-x-hidden [&::-webkit-scrollbar]:w-2 [&::-webkit-scrollbar-track]:bg-transparent [&::-webkit-scrollbar-thumb]:bg-slate-300 dark:[&::-webkit-scrollbar-thumb]:bg-slate-700 [&::-webkit-scrollbar-thumb]:rounded-full hidden"></div>

  </div>
</Layout>

<script>
  import { supabase } from '../../lib/supabase';
  import { getSession, checkIsAdmin } from '../../lib/auth';
  import { formatDate, formatPrice, formatEngineCapacity, formatVehicleTitle } from '../../lib/formatters';

  const ENABLE_GUEST_VIEW = false;

  async function loadFleetArchive() {
    const loadingEl = document.getElementById('fleet-loading');
    const errorEl = document.getElementById('fleet-error');
    const gridEl = document.getElementById('fleet-grid');
    const searchInput = document.getElementById('fleet-search') as HTMLInputElement;
    const sortSelect = document.getElementById('fleet-sort') as HTMLSelectElement;
    const resultCount = document.getElementById('result-count');
    const tagsContainer = document.getElementById('quick-tags-container');

    // 1. Session & Role Check
    const { session } = await getSession();
    const isAdmin = session ? await checkIsAdmin(session.user) : false;

    if (!session || !isAdmin) {
      if (!ENABLE_GUEST_VIEW) {
        window.location.href = '/nl';
        return;
      }
    }

    // Uncloak UI after confirming admin session
    document.getElementById('secure-enclave')?.classList.remove('opacity-0', 'pointer-events-none');

    // 2. Fetch Shifts from shifts table
    const { data: shifts, error } = await supabase
      .from('shifts')
      .select('*')
      .order('shift_date', { ascending: false });

    if (error) {
      if (loadingEl) loadingEl.classList.add('hidden');
      if (errorEl) {
        errorEl.textContent = `[FOUT]: ${error.message}`;
        errorEl.classList.remove('hidden');
      }
      return;
    }

    if (!shifts || shifts.length === 0) {
      if (loadingEl) loadingEl.classList.add('hidden');
      if (resultCount) resultCount.textContent = '0 voertuigen getoond';
      if (errorEl) {
        errorEl.textContent = '[OPMERKING]: Geen voertuigen gevonden in het archief.';
        errorEl.classList.remove('hidden');
      }
      return;
    }

    // 3. Dynamically Generate Quick Filter Tags (Translated)
    const tagsSet = new Set<string>();

    shifts.forEach(shift => {
      if (shift.vehicle_fuel) {
        const rawFuel = shift.vehicle_fuel.trim();
        const lowerFuel = rawFuel.toLowerCase();
        if (lowerFuel.includes('elektr')) {
          tagsSet.add('Elektrisch');
        } else if (lowerFuel.includes('benzine') || lowerFuel.includes('petrol')) {
          tagsSet.add('Benzine');
        } else if (lowerFuel.includes('diesel')) {
          tagsSet.add('Diesel');
        } else if (lowerFuel.includes('hybrid') || lowerFuel.includes('hybride')) {
          tagsSet.add('Hybride');
        } else {
          tagsSet.add(rawFuel);
        }
      }

      if (shift.rdw_power_hp && shift.rdw_power_hp > 200) {
        tagsSet.add('Hoge Prestaties');
      }

      if (shift.rdw_cylinders === 0 || (shift.vehicle_fuel && shift.vehicle_fuel.toLowerCase().includes('elektr'))) {
        tagsSet.add('Nul Uitstoot');
      }

      if (shift.rdw_capacity_cc && shift.rdw_capacity_cc >= 2500) {
        tagsSet.add('Grote Inhoud');
      }
    });

    const dynamicTags = Array.from(tagsSet);
    if (tagsContainer && dynamicTags.length > 0) {
      tagsContainer.innerHTML = `
        <span class="text-xs text-slate-400 font-semibold mr-1">// Snelle Filters:</span>
        ${dynamicTags.map(tag => `
          <button 
            type="button" 
            class="quick-tag-btn px-3 py-1 rounded-lg text-xs font-mono border border-slate-300 dark:border-slate-800 bg-slate-100/80 dark:bg-slate-900/60 text-slate-700 dark:text-slate-300 hover:border-cyan-500/50 transition-all cursor-pointer" 
            data-tag="${tag}"
          >${tag}</button>
        `).join('')}
      `;
    }

    // 4. Render Vehicle Cards
    if (gridEl) {
      gridEl.innerHTML = shifts.map((shift, idx) => {
        const make = shift.vehicle_make || '';
        const model = shift.vehicle_model || '';
        const plate = shift.vehicle_license_plate || '';
        const fuel = shift.vehicle_fuel || '';
        const buildYear = shift.vehicle_build_year ? shift.vehicle_build_year.toString() : '';
        const lowerFuel = fuel.toLowerCase();
        
        const extraKeywords: string[] = [];
        if (lowerFuel.includes('elektr')) extraKeywords.push('elektrisch', 'nul uitstoot', 'ev', 'electric', 'zero emission');
        if (lowerFuel.includes('benzine')) extraKeywords.push('benzine', 'petrol');
        if (lowerFuel.includes('diesel')) extraKeywords.push('diesel');
        if (lowerFuel.includes('hybrid')) extraKeywords.push('hybride', 'hybrid');
        if ((shift.rdw_power_hp || 0) > 200) extraKeywords.push('hoge prestaties', 'high performance');
        if ((shift.rdw_capacity_cc || 0) >= 2500) extraKeywords.push('grote inhoud', 'large capacity');

        const fullTitle = formatVehicleTitle(shift.vehicle_build_year, shift.vehicle_make, shift.vehicle_model);
        const searchTag = `${buildYear} ${make} ${model} ${fullTitle} ${plate} ${fuel} ${extraKeywords.join(' ')}`.toLowerCase();

        const hp = shift.rdw_power_hp ? `${shift.rdw_power_hp} HP` : 'N/V';
        const cyl = shift.rdw_cylinders !== null && shift.rdw_cylinders !== undefined ? `${shift.rdw_cylinders} Cil` : '0 / EV';
        const cap = formatEngineCapacity(shift.rdw_capacity_cc);
        const formattedPrice = formatPrice(shift.rdw_catalog_price);
        const formattedShiftDate = formatDate(shift.shift_date);

        return `
          <div 
            class="animate-fade-in-up vehicle-card p-5 rounded-2xl bg-slate-50/90 dark:bg-slate-900/70 border border-slate-300 dark:border-slate-800 shadow-md shadow-slate-200/70 dark:shadow-none space-y-4 font-mono transition-all hover:border-cyan-500/40"
            style="animation-delay: ${idx * 50}ms; animation-fill-mode: both;"
            data-search="${searchTag}"
            data-date="${shift.shift_date}"
            data-hp="${shift.rdw_power_hp || 0}"
            data-price="${shift.rdw_catalog_price || 0}"
          >
            <div class="flex items-center justify-between border-b border-slate-300 dark:border-slate-800 pb-3">
              <span class="px-2.5 py-1 rounded bg-cyan-950/40 border border-cyan-500/30 text-cyan-600 dark:text-cyan-400 font-bold text-xs">
                ${plate}
              </span>
              <span class="text-[11px] text-slate-500 dark:text-slate-400">
                ${formattedShiftDate}
              </span>
            </div>

            <div class="space-y-1">
              <span class="text-xs text-slate-400 uppercase tracking-wider block">${make || 'Merk Onbekend'}</span>
              <h3 class="text-base font-bold text-slate-900 dark:text-slate-100 truncate">
                ${fullTitle || 'Model Onbekend'}
              </h3>
            </div>

            <div class="grid grid-cols-4 gap-2 pt-2 border-t border-slate-300 dark:border-slate-800/80 text-[11px] text-slate-600 dark:text-slate-300">
              <div>
                <span class="text-slate-400 block text-[10px]">VERMOGEN</span>
                <span class="font-semibold text-slate-800 dark:text-slate-200">${hp}</span>
              </div>
              <div>
                <span class="text-slate-400 block text-[10px]">CILINDERS</span>
                <span class="font-semibold text-slate-800 dark:text-slate-200">${cyl}</span>
              </div>
              <div>
                <span class="text-slate-400 block text-[10px]">INHOUD</span>
                <span class="font-semibold text-slate-800 dark:text-slate-200">${cap}</span>
              </div>
              <div>
                <span class="text-slate-400 block text-[10px]">WAARDE</span>
                <span class="font-semibold text-slate-800 dark:text-slate-200 truncate block">${formattedPrice}</span>
              </div>
            </div>

            <div class="pt-2 flex items-center justify-between text-xs">
              ${isAdmin ? `
                <a 
                  href="/nl/shift?date=${shift.shift_date}" 
                  class="group text-cyan-600 dark:text-cyan-400 hover:underline font-bold text-[11px] flex items-center space-x-1"
                >
                  <span>Bekijk Dienstdatum (${formattedShiftDate})</span>
                  <svg class="w-3.5 h-3.5 text-cyan-500 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7"/>
                  </svg>
                </a>
              ` : `
                <span 
                  class="text-slate-400 font-semibold text-[11px] flex items-center space-x-1 cursor-not-allowed opacity-75"
                >
                  <span>Bekijk Dienstdatum (${formattedShiftDate})</span>
                </span>
              `}
            </div>
          </div>
        `;
      }).join('');
    }

    if (resultCount) {
      resultCount.textContent = `${shifts.length} voertuig${shifts.length === 1 ? '' : 'en'} getoond`;
    }

    loadingEl?.classList.add('hidden');
    gridEl?.classList.remove('hidden');

    // 5. Sorting Logic
    const sortCards = () => {
      if (!gridEl || !sortSelect) return;
      const cards = Array.from(gridEl.querySelectorAll<HTMLElement>('.vehicle-card'));
      const sortValue = sortSelect.value;

      cards.sort((a, b) => {
        const dateA = a.getAttribute('data-date') || '';
        const dateB = b.getAttribute('data-date') || '';
        const hpA = parseFloat(a.getAttribute('data-hp') || '0');
        const hpB = parseFloat(b.getAttribute('data-hp') || '0');
        const priceA = parseFloat(a.getAttribute('data-price') || '0');
        const priceB = parseFloat(b.getAttribute('data-price') || '0');

        switch (sortValue) {
          case 'date-desc':
            return dateB.localeCompare(dateA);
          case 'date-asc':
            return dateA.localeCompare(dateB);
          case 'hp-desc':
            return hpB - hpA;
          case 'hp-asc':
            return (hpA === 0 ? Infinity : hpA) - (hpB === 0 ? Infinity : hpB);
          case 'price-desc':
            return priceB - priceA;
          case 'price-asc':
            return (priceA === 0 ? Infinity : priceA) - (priceB === 0 ? Infinity : priceB);
          default:
            return 0;
        }
      });

      cards.forEach(card => gridEl.appendChild(card));
    };

    if (sortSelect) {
      sortSelect.addEventListener('change', sortCards);
    }

    // 6. Search Filtering Logic
    const tagButtons = document.querySelectorAll<HTMLButtonElement>('.quick-tag-btn');

    function updateActiveTagUI(activeKeyword: string) {
      tagButtons.forEach(btn => {
        const tagValue = (btn.getAttribute('data-tag') || '').toLowerCase();
        if (activeKeyword && tagValue === activeKeyword.toLowerCase()) {
          btn.classList.add('bg-cyan-500/20', 'text-cyan-600', 'dark:text-cyan-400', 'border-cyan-500', 'font-bold');
          btn.classList.remove('bg-slate-100/80', 'dark:bg-slate-900/60', 'text-slate-700', 'dark:text-slate-300', 'border-slate-300', 'dark:border-slate-800');
        } else {
          btn.classList.remove('bg-cyan-500/20', 'text-cyan-600', 'dark:text-cyan-400', 'border-cyan-500', 'font-bold');
          btn.classList.add('bg-slate-100/80', 'dark:bg-slate-900/60', 'text-slate-700', 'dark:text-slate-300', 'border-slate-300', 'dark:border-slate-800');
        }
      });
    }

    const filterGrid = () => {
      const query = searchInput ? searchInput.value.trim().toLowerCase() : '';
      const cards = document.querySelectorAll('.vehicle-card');
      let visibleCount = 0;

      cards.forEach(card => {
        const searchAttr = card.getAttribute('data-search') || '';
        if (!query || searchAttr.includes(query)) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (resultCount) {
        resultCount.textContent = `${visibleCount} voertuig${visibleCount === 1 ? '' : 'en'} getoond`;
      }

      updateActiveTagUI(query);
    };

    if (searchInput) {
      searchInput.addEventListener('input', filterGrid);
    }

    tagButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const tag = btn.getAttribute('data-tag') || '';
        const currentQuery = searchInput.value.trim();

        if (currentQuery.toLowerCase() === tag.toLowerCase()) {
          searchInput.value = '';
        } else {
          searchInput.value = tag;
        }

        filterGrid();
      });
    });
  }

  loadFleetArchive();
</script>
