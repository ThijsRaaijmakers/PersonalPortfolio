---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { supabase } from '../../lib/supabase';

// Perform server-side profiles check for admin authorization
const { data: { session } } = await supabase.auth.getSession();
let isAdmin = false;
let userEmail = '';

if (session) {
  userEmail = session.user.email || '';
  const { data: profile } = await supabase
    .from('profiles')
    .select('role')
    .eq('id', session.user.id)
    .single();

  if (profile?.role === 'admin') {
    isAdmin = true;
  }
}
---

<Layout description="Beveiligd FleetPort logistiek- en rittenoverzicht." title="Dashboard | FleetPort Logistics">
  <div id="secure-enclave" class="max-w-7xl mx-auto py-8 sm:py-12 space-y-8 animate-fade-in-up opacity-0 pointer-events-none transition-opacity duration-300">
    
    <!-- Breadcrumbs -->
    <Breadcrumbs 
      items={[
        { label: 'Home', href: '/nl' },
        { label: 'Dashboard' }
      ]} 
    />

    <!-- Top Bar / Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-300 dark:border-slate-800 pb-6">
      <div class="space-y-1.5">
        <div class="flex items-center space-x-2.5 flex-wrap gap-y-1">
          <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-cyan-950/10 dark:bg-cyan-950/60 border border-cyan-500/30 font-mono text-xs text-cyan-600 dark:text-cyan-400">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>BEHEER &bull; BEVEILIGDE CONSOLE</span>
          </div>

          <!-- Terminal-Styled ADMIN Badge (Visual Feedback for Admin Users) -->
          <span 
            id="admin-badge" 
            class={`${isAdmin ? '' : 'hidden '}inline-flex items-center space-x-1.5 px-2.5 py-0.5 rounded bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border border-cyan-500/30 font-mono text-[10px] font-bold tracking-wider uppercase shadow-sm shadow-cyan-500/10`}
          >
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-ping"></span>
            <span>ADMIN</span>
          </span>
        </div>

        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-slate-50 font-sans tracking-tight">
          FleetPort Operationeel Dashboard
        </h1>
        <p id="user-identity" class="text-xs font-mono text-slate-500 dark:text-slate-400">
          {userEmail ? `// Identiteit: ${userEmail}` : ''}
        </p>
      </div>
      
      <div class="flex flex-wrap items-center gap-3">
        <a 
          href="/nl/map" 
          class="group px-4 py-2 rounded-lg bg-cyan-950/20 dark:bg-cyan-950/40 hover:bg-cyan-900/30 text-cyan-600 dark:text-cyan-400 border border-cyan-500/30 font-mono text-xs font-semibold transition-colors flex items-center space-x-2 shadow-sm"
        >
          <svg class="w-3.5 h-3.5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
          </svg>
          <span>Telemetrie Kaart</span>
        </a>
        <a 
          href="/nl/fleet" 
          class="group px-4 py-2 rounded-lg bg-slate-100/80 dark:bg-slate-950 hover:bg-slate-200/80 dark:hover:bg-slate-900 text-slate-700 dark:text-slate-300 border border-slate-300 dark:border-slate-800 font-mono text-xs font-semibold transition-colors flex items-center space-x-2 shadow-sm"
        >
          <svg class="w-3.5 h-3.5 text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/>
          </svg>
          <span>Doorzoek Auto Archief</span>
        </a>
        <button 
          id="sort-dashboard-btn" 
          class="px-4 py-2 rounded-lg bg-slate-100/80 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 text-xs font-mono text-slate-700 dark:text-slate-300 font-semibold shadow-sm transition-colors hover:bg-slate-200/80 dark:hover:bg-slate-900 cursor-pointer flex items-center space-x-2"
        >
          <svg class="w-3.5 h-3.5 text-slate-500 dark:text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"/>
          </svg>
          <span>Sortering: Nieuwste Eerst</span>
        </button>

        <!-- Admin Only Navigation Link pointing to /nl/admin -->
        <a 
          id="admin-logs-btn"
          href="/nl/admin" 
          class={`${isAdmin ? '' : 'hidden '}px-4 py-2 rounded-lg bg-cyan-950/20 dark:bg-cyan-950/60 hover:bg-cyan-900/30 text-cyan-600 dark:text-cyan-400 border border-cyan-500/30 font-mono text-xs font-semibold transition-colors flex items-center space-x-2 shadow-sm`}
        >
          <svg class="w-3.5 h-3.5 text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          <span>Beheerderspaneel</span>
        </a>

        <!-- Admin Only Button pointing to /nl/add-shift -->
        <a 
          id="add-shift-btn"
          href="/nl/add-shift" 
          class={`${isAdmin ? '' : 'hidden '}px-4 py-2 rounded-lg bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold font-mono text-xs transition-all shadow-md shadow-cyan-500/20 flex items-center space-x-2`}
        >
          <span>+ Nieuwe Dienst Verwerken</span>
        </a>
      </div>
    </div>

    <!-- Metrics Overview Grid (Mobile: 2 cols, Desktop: 5 cols) -->
    <div id="metrics-grid" class="grid grid-cols-2 lg:grid-cols-5 gap-4">
      <div class="p-4 sm:p-5 rounded-xl bg-slate-50/90 dark:bg-slate-900/60 border border-slate-300 dark:border-slate-800 shadow-md shadow-slate-200/70 dark:shadow-none space-y-1 font-mono">
        <span class="text-xs text-slate-500 dark:text-slate-400 block truncate">// Totaal Aantal Diensten</span>
        <span id="metric-total" class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-slate-100 tracking-tight truncate block">...</span>
      </div>
      <div class="p-4 sm:p-5 rounded-xl bg-slate-50/90 dark:bg-slate-900/60 border border-slate-300 dark:border-slate-800 shadow-md shadow-slate-200/70 dark:shadow-none space-y-1 font-mono">
        <span class="text-xs text-slate-500 dark:text-slate-400 block truncate">// Unieke Voertuigen</span>
        <span id="metric-vehicles" class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-slate-100 tracking-tight truncate block">...</span>
      </div>
      <div class="p-4 sm:p-5 rounded-xl bg-slate-50/90 dark:bg-slate-900/60 border border-slate-300 dark:border-slate-800 shadow-md shadow-slate-200/70 dark:shadow-none space-y-1 font-mono">
        <span class="text-xs text-slate-500 dark:text-slate-400 block truncate">// Unieke Modellen</span>
        <span id="metric-models" class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-slate-100 tracking-tight truncate block">...</span>
      </div>
      <div class="p-4 sm:p-5 rounded-xl bg-slate-50/90 dark:bg-slate-900/60 border border-slate-300 dark:border-slate-800 shadow-md shadow-slate-200/70 dark:shadow-none space-y-1 font-mono">
        <span class="text-xs text-slate-500 dark:text-slate-400 block truncate">// Gemiddeld Vermogen</span>
        <span id="metric-hp" class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-slate-100 tracking-tight truncate block">...</span>
      </div>
      <div class="p-4 sm:p-5 rounded-xl bg-slate-50/90 dark:bg-slate-900/60 border border-slate-300 dark:border-slate-800 shadow-md shadow-slate-200/70 dark:shadow-none space-y-1 font-mono col-span-2 sm:col-span-1">
        <span class="text-xs text-slate-500 dark:text-slate-400 block truncate">// Totale Autowaarde</span>
        <span id="metric-fleet-value" class="text-xl sm:text-2xl font-bold text-cyan-600 dark:text-cyan-400 tracking-tight truncate block">...</span>
      </div>
    </div>

    <!-- Shifts List Container -->
    <div class="rounded-2xl bg-slate-50/90 dark:bg-slate-900/60 border border-slate-300 dark:border-slate-800 shadow-xl overflow-hidden">
      <div class="p-4 sm:p-6 border-b border-slate-300 dark:border-slate-800 flex items-center justify-between">
        <h2 class="font-mono text-sm font-bold text-slate-900 dark:text-slate-100">
          // Dagelijks Dienstregister
        </h2>
        <span id="table-count" class="font-mono text-xs text-slate-500 dark:text-slate-400">Laden van gegevens...</span>
      </div>

      <!-- Table Header (12-column grid) -->
      <div class="hidden sm:grid sm:grid-cols-12 gap-3 p-4 font-mono text-xs font-semibold bg-slate-100/80 dark:bg-slate-950/80 text-slate-500 dark:text-slate-400 border-b border-slate-300 dark:border-slate-800">
        <div class="sm:col-span-2">Datum Dienst</div>
        <div class="sm:col-span-2">Ritten Geregistreerd</div>
        <div class="sm:col-span-5">Voertuigmodellen</div>
        <div class="sm:col-span-1">Totaal PK</div>
        <div class="sm:col-span-2 text-right">Actie</div>
      </div>

      <!-- Rows Container -->
      <div id="shifts-rows-container" class="divide-y divide-slate-300 dark:divide-slate-800/60 font-mono text-xs max-h-[500px] overflow-y-auto overflow-x-hidden [&::-webkit-scrollbar]:w-2 [&::-webkit-scrollbar-track]:bg-transparent [&::-webkit-scrollbar-thumb]:bg-slate-300 dark:[&::-webkit-scrollbar-thumb]:bg-slate-700 [&::-webkit-scrollbar-thumb]:rounded-full">
        <div class="p-8 text-center text-slate-400">Databasegegeven ophalen...</div>
      </div>
    </div>

  </div>
</Layout>

<script>
  import { supabase } from '../../lib/supabase';
  import { formatDate, formatPrice, formatVehicleTitle } from '../../lib/formatters';

  const ENABLE_GUEST_VIEW = false;

  async function loadDashboard() {
    // 1. Enforce Session & Role Check
    const { data: { session } } = await supabase.auth.getSession();
    
    let isAdmin = false;
    if (session) {
      const { data: profile } = await supabase
        .from('profiles')
        .select('role')
        .eq('id', session.user.id)
        .single();
      isAdmin = profile?.role === 'admin';
    }

    if (!session || !isAdmin) {
      if (!ENABLE_GUEST_VIEW) {
        window.location.href = '/nl';
        return;
      }
    }

    // Uncloak UI after confirming admin session
    document.getElementById('secure-enclave')?.classList.remove('opacity-0', 'pointer-events-none');

    const userIdentity = document.getElementById('user-identity');
    if (userIdentity && session?.user?.email) {
      userIdentity.textContent = `// Identiteit: ${session.user.email}`;
    }

    // Toggle Admin Badge & Navigation Links based on profiles role
    const adminBadge = document.getElementById('admin-badge');
    const adminLogsBtn = document.getElementById('admin-logs-btn');
    const addShiftBtn = document.getElementById('add-shift-btn');

    if (adminBadge) {
      adminBadge.classList.toggle('hidden', !isAdmin);
    }
    if (adminLogsBtn) {
      adminLogsBtn.classList.toggle('hidden', !isAdmin);
    }
    if (addShiftBtn) {
      addShiftBtn.classList.toggle('hidden', !isAdmin);
    }

    // 3. Fetch Shifts from shifts table
    const { data: shifts, error } = await supabase
      .from('shifts')
      .select('*')
      .order('shift_date', { ascending: false });

    const rowsContainer = document.getElementById('shifts-rows-container');
    const tableCount = document.getElementById('table-count');

    if (error) {
      if (rowsContainer) rowsContainer.innerHTML = `<div class="p-6 text-center text-red-500">[FOUT]: ${error.message}</div>`;
      return;
    }

    if (!shifts || shifts.length === 0) {
      if (rowsContainer) rowsContainer.innerHTML = `<div class="p-8 text-center text-slate-500">Nog geen diensten geregistreerd.</div>`;
      if (tableCount) tableCount.textContent = `0 items gevonden`;
      
      document.getElementById('metric-total')!.textContent = '0';
      document.getElementById('metric-vehicles')!.textContent = '0';
      document.getElementById('metric-models')!.textContent = '0';
      document.getElementById('metric-hp')!.textContent = '0 PK';
      document.getElementById('metric-fleet-value')!.textContent = '€0';
      return;
    }

    // Group shifts by shift_date
    const grouped = shifts.reduce((acc: any, shift: any) => {
      const dateKey = shift.shift_date;
      if (!acc[dateKey]) {
        acc[dateKey] = [];
      }
      acc[dateKey].push(shift);
      return acc;
    }, {});

    let sortedDates = Object.keys(grouped).sort((a, b) => b.localeCompare(a));
    let isAscending = false;

    const sortBtn = document.getElementById('sort-dashboard-btn');
    if (sortBtn) {
      sortBtn.addEventListener('click', () => {
        isAscending = !isAscending;
        sortedDates.sort((a, b) => isAscending ? a.localeCompare(b) : b.localeCompare(a));
        sortBtn.textContent = isAscending ? 'Sortering: Oudste Eerst' : 'Sortering: Nieuwste Eerst';
        renderRows();
      });
    }

    function calculateOverallMetrics() {
      const totalShifts = new Set(shifts.map((s: any) => s.shift_date)).size;
      const uniqueVehicles = new Set(shifts.map((s: any) => s.vehicle_license_plate)).size;
      const uniqueModels = new Set(shifts.map((s: any) => `${s.vehicle_make} ${s.vehicle_model}`)).size;

      const hpValues = shifts.map((s: any) => s.rdw_power_hp).filter((hp: any) => typeof hp === 'number' && hp > 0);
      const avgHp = hpValues.length > 0 
        ? Math.round(hpValues.reduce((sum: number, val: number) => sum + val, 0) / hpValues.length)
        : 0;

      const totalValue = shifts.reduce((sum: number, s: any) => sum + (s.rdw_catalog_price || 0), 0);

      document.getElementById('metric-total')!.textContent = totalShifts.toString();
      document.getElementById('metric-vehicles')!.textContent = uniqueVehicles.toString();
      document.getElementById('metric-models')!.textContent = uniqueModels.toString();
      document.getElementById('metric-hp')!.textContent = `${avgHp} PK`;
      document.getElementById('metric-fleet-value')!.textContent = formatPrice(totalValue);
    }

    function renderRows() {
      if (!rowsContainer) return;
      if (tableCount) tableCount.textContent = `${sortedDates.length} dienstdata (${shifts.length} ritten totaal)`;

      const html = sortedDates.map((dateStr, index) => {
        const dayShifts = grouped[dateStr];
        const ridesCount = dayShifts.length;
        const formattedShiftDate = formatDate(dateStr);

        const modelsList = dayShifts.map((s: any) => 
          formatVehicleTitle(s.vehicle_build_year, s.vehicle_make, s.vehicle_model)
        ).join(', ');

        const combinedHp = dayShifts.reduce((sum: number, s: any) => sum + (s.rdw_power_hp || 0), 0);

        return `
          <div class="animate-fade-in-up grid grid-cols-1 sm:grid-cols-12 gap-3 p-4 items-center hover:bg-slate-100/50 dark:hover:bg-slate-900/40 transition-colors" style="animation-delay: ${index * 50}ms; animation-fill-mode: both;">
            <div class="sm:col-span-2 font-bold text-slate-900 dark:text-slate-100 flex items-center justify-between sm:justify-start">
              <span>${formattedShiftDate}</span>
              <span class="sm:hidden text-xs text-slate-400 font-normal">${ridesCount} rit(ten)</span>
            </div>
            
            <div class="hidden sm:block sm:col-span-2 font-medium text-slate-600 dark:text-slate-300">
              <span class="px-2 py-0.5 rounded-full bg-slate-200/60 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-mono text-[11px]">
                ${ridesCount} ${ridesCount === 1 ? 'rit' : 'ritten'}
              </span>
            </div>

            <div class="sm:col-span-5 text-slate-700 dark:text-slate-300 truncate" title="${modelsList}">
              <span class="sm:hidden text-slate-500 font-mono text-[10px] block">// Voertuigen:</span>
              ${modelsList}
            </div>

            <div class="sm:col-span-1 font-mono text-cyan-600 dark:text-cyan-400 font-semibold">
              <span class="sm:hidden text-slate-500 text-[10px] font-normal block">// Totaal PK:</span>
              ${combinedHp ? `${combinedHp} PK` : 'N/A'}
            </div>

            <div class="sm:col-span-2 text-left sm:text-right pt-2 sm:pt-0 border-t sm:border-t-0 border-slate-200 dark:border-slate-800/40">
              <a 
                href="/nl/shift?date=${dateStr}" 
                class="group inline-flex items-center space-x-1.5 px-3 py-1.5 rounded-md bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-600 dark:text-cyan-400 font-mono text-xs transition-colors border border-cyan-500/30"
              >
                <span>Bekijk Daglog</span>
                <svg class="w-3.5 h-3.5 text-cyan-500 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
          </div>
        `;
      }).join('');

      rowsContainer.innerHTML = html;
    }

    calculateOverallMetrics();
    renderRows();
  }

  loadDashboard();
</script>
