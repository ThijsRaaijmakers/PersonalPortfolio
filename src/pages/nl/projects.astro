---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Projecten | Binnenkort beschikbaar"
  description="Overzicht van software- en AI-projecten door Thijs."
>
  <div class="space-y-8 max-w-4xl mx-auto py-12 text-center animate-fade-in-up">
    <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-cyan-950/10 dark:bg-cyan-950/60 border border-cyan-500/30 font-mono text-xs text-cyan-600 dark:text-cyan-400">
      <span class="w-2 h-2 rounded-full bg-cyan-500 animate-pulse"></span>
      <span>PROJECTEN &bull; NL</span>
    </div>

    <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-slate-50 font-sans tracking-tight">
      Projecten
    </h1>

    <div class="p-8 rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 shadow-xl space-y-4 max-w-md mx-auto">
      <p class="text-sm font-mono text-slate-600 dark:text-slate-300">
        Binnenkort beschikbaar
      </p>
      <p class="text-xs text-slate-500 dark:text-slate-400">
        De Nederlandstalige projectenpagina wordt momenteel bijgewerkt. Bekijk de Engelstalige versie voor het volledige overzicht.
      </p>
      <a 
        href="/projects" 
        class="inline-block px-4 py-2 rounded-lg bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-mono text-xs font-bold transition-all shadow-md"
      >
        Bekijk Engelstalige Projecten &rarr;
      </a>
    </div>
  </div>
</Layout>
