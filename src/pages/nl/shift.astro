---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
---

<Layout description="Dienst details logboek en voertuig telemetrie." title="Dienst Details | FleetPort Tracker">
  <!-- Include Leaflet CDN in Head -->
  <link 
    rel="stylesheet" 
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" 
    integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" 
    crossorigin="" 
  />

  <div class="max-w-6xl mx-auto py-8 sm:py-12 space-y-8 animate-fade-in-up">
    
    <!-- Breadcrumbs Wrapper -->
    <div id="breadcrumbs-wrapper">
      <Breadcrumbs 
        items={[
          { label: 'Home', href: '/nl' },
          { label: 'Dashboard', href: '/nl/dashboard' },
          { label: 'Dienst' },
          { label: 'Details' }
        ]} 
      />
    </div>

    <!-- Header Section with Back Button -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-300 dark:border-slate-800 pb-6">
      <div class="space-y-2">
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-cyan-950/10 dark:bg-cyan-950/60 border border-cyan-500/30 font-mono text-xs text-cyan-600 dark:text-cyan-400">
          <span class="w-2 h-2 rounded-full bg-cyan-500 animate-pulse"></span>
          <span>DIENST LOGBOEK ENTRY &bull; <span id="header-date">Laden...</span></span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-slate-50 font-sans tracking-tight">
          Dienst Details &amp; Route Telemetrie
        </h1>
      </div>

      <button 
        onclick="window.history.length > 2 ? window.history.back() : window.location.href='/nl/dashboard'"
        class="inline-flex items-center space-x-2 px-4 py-2 rounded-lg bg-slate-100/80 dark:bg-slate-950 hover:bg-slate-200/80 dark:hover:bg-slate-900 text-slate-700 dark:text-slate-300 border border-slate-300 dark:border-slate-800 font-mono text-xs font-semibold transition-colors w-fit shadow-sm cursor-pointer"
      >
        <span>&larr; Ga Terug</span>
      </button>
    </div>

    <!-- Loading State -->
    <div id="shift-loading" class="py-12 text-center font-mono text-xs text-slate-500 dark:text-slate-400">
      <div class="inline-flex items-center space-x-2">
        <span class="w-2.5 h-2.5 rounded-full bg-cyan-500 animate-ping"></span>
        <span>TELEMETRIE_LADEN...</span>
      </div>
    </div>

    <!-- Access Denied State (For Non-Admins) -->
    <div id="shift-access-denied" class="hidden p-8 sm:p-12 rounded-2xl bg-slate-50/90 dark:bg-slate-900/60 border border-slate-300 dark:border-slate-800 text-center space-y-4 shadow-xl font-mono">
      <div class="w-12 h-12 rounded-full bg-red-500/10 border border-red-500/30 text-red-500 flex items-center justify-center mx-auto">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
        </svg>
      </div>
      <h2 class="text-base sm:text-lg font-bold text-slate-900 dark:text-slate-100 max-w-lg mx-auto leading-snug">
        Toegang Geweigerd: Je hebt geen toestemming om gedetailleerde dienstroutes te bekijken.
      </h2>
      <p class="text-xs text-slate-500 dark:text-slate-400 max-w-md mx-auto">
        Logistieke, locatie- en planningsgegevens zijn strikt voorbehouden aan geautoriseerde beheerdersaccounts.
      </p>
      <div class="pt-2">
        <button 
          onclick="window.history.length > 2 ? window.history.back() : window.location.href='/nl/dashboard'"
          class="inline-flex items-center space-x-2 px-4 py-2 rounded-lg bg-slate-100/80 dark:bg-slate-950 text-slate-700 dark:text-slate-300 font-semibold text-xs transition-colors hover:bg-slate-200/80 dark:hover:bg-slate-900 cursor-pointer"
        >
          <span>&larr; Ga Terug</span>
        </button>
      </div>
    </div>

    <!-- Error State -->
    <div id="shift-error" class="hidden p-4 rounded-xl bg-red-500/10 border border-red-500/30 text-red-600 dark:text-red-400 font-mono text-xs"></div>

    <!-- Content Container (Only rendered if Admin) -->
    <div id="shift-content" class="hidden space-y-8">
      
      <!-- Summary Card Header -->
      <div id="summary-card" class="p-6 rounded-2xl bg-slate-50/90 dark:bg-slate-900/60 border border-slate-300 dark:border-slate-800 shadow-md shadow-slate-200/70 dark:shadow-none font-mono">
        <h2 class="text-xs uppercase tracking-wider font-bold text-cyan-600 dark:text-cyan-400 mb-4 border-b border-slate-300 dark:border-slate-800 pb-2">
          // Dienst Samenvatting
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          <div class="space-y-1">
            <span class="text-slate-500 dark:text-slate-400 text-xs block">Totaal Aantal Ritten</span>
            <span id="summary-total-rides" class="text-2xl font-bold text-slate-900 dark:text-slate-100">-</span>
          </div>
          <div class="space-y-1">
            <span class="text-slate-500 dark:text-slate-400 text-xs block">Gecombineerd Vermogen</span>
            <span id="summary-combined-hp" class="text-2xl font-bold text-slate-900 dark:text-slate-100">-</span>
          </div>
          <div class="space-y-1">
            <span class="text-slate-500 dark:text-slate-400 text-xs block">Motor Verdeling (EV / ICE)</span>
            <span id="summary-ev-ice" class="text-2xl font-bold text-emerald-600 dark:text-emerald-400">-</span>
          </div>
        </div>
      </div>

      <!-- Daily Operations Telemetry Map Container -->
      <div class="w-full h-[400px] rounded-2xl bg-slate-900 border border-slate-300 dark:border-slate-800 shadow-xl overflow-hidden relative z-0 mb-8" id="daily-map"></div>

      <!-- Rides List -->
      <div class="space-y-6">
        <h2 class="text-lg font-bold text-slate-900 dark:text-slate-100 font-mono flex items-center space-x-2">
          <span class="text-cyan-600 dark:text-cyan-400">&gt;</span>
          <span>Geregistreerde Voertuigritten</span>
        </h2>
        <div id="rides-container" class="space-y-6"></div>
      </div>

    </div>

  </div>
</Layout>

<!-- Leaflet Client Integration -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<script>
  import { supabase } from '../../lib/supabase';
  import { getSession, checkIsAdmin } from '../../lib/auth';
  import { formatDate, formatPrice, formatEngineCapacity, formatVehicleTitle } from '../../lib/formatters';

  declare const L: any;

  async function loadShiftDetail() {
    const loadingEl = document.getElementById('shift-loading');
    const errorEl = document.getElementById('shift-error');
    const contentEl = document.getElementById('shift-content');
    const accessDeniedEl = document.getElementById('shift-access-denied');
    const headerDateEl = document.getElementById('header-date');

    // 1. Session & Access Control Verification
    const { session } = await getSession();
    if (!session) {
      window.location.href = '/nl/login';
      return;
    }

    const isAdmin = await checkIsAdmin(session.user);
    if (!isAdmin) {
      if (loadingEl) loadingEl.classList.add('hidden');
      if (accessDeniedEl) accessDeniedEl.classList.remove('hidden');
      return; // Bypass database query entirely for non-admins
    }

    // Extract shift date from query parameters
    const params = new URLSearchParams(window.location.search);
    const shiftDate = params.get('date');

    if (!shiftDate) {
      if (loadingEl) loadingEl.classList.add('hidden');
      if (errorEl) {
        errorEl.textContent = '[FOUT]: Geen dienstdatum opgegeven in URL parameters.';
        errorEl.classList.remove('hidden');
      }
      return;
    }

    // Update Header and Breadcrumbs to reflect extracted date using formatDate
    const formattedShiftDate = formatDate(shiftDate);
    if (headerDateEl) headerDateEl.textContent = formattedShiftDate;
    
    const breadcrumbLast = document.querySelector('#breadcrumbs-wrapper nav span:last-child');
    if (breadcrumbLast) breadcrumbLast.textContent = formattedShiftDate;

    // 2. Fetch Rides for Shift Date (Admin Authorized)
    const { data: rides, error } = await supabase
      .from('shifts')
      .select('*')
      .eq('shift_date', shiftDate)
      .order('created_at', { ascending: true });

    if (error) {
      if (loadingEl) loadingEl.classList.add('hidden');
      if (errorEl) {
        errorEl.textContent = `[FOUT]: ${error.message}`;
        errorEl.classList.remove('hidden');
      }
      return;
    }

    if (!rides || rides.length === 0) {
      if (loadingEl) loadingEl.classList.add('hidden');
      if (errorEl) {
        errorEl.textContent = `[OPMERKING]: Geen ritten gevonden voor ${formattedShiftDate}.`;
        errorEl.classList.remove('hidden');
      }
      return;
    }

    // 3. Populate Summary Metrics
    const totalRides = rides.length;
    const combinedHp = rides.reduce((sum, r) => sum + (r.rdw_power_hp || 0), 0);

    const evCount = rides.filter((ride: any) => {
      const fuelStr = ride.vehicle_fuel ? ride.vehicle_fuel.toLowerCase() : '';
      return fuelStr.includes('elektr') || ride.rdw_cylinders === 0 || ride.rdw_cylinders === null;
    }).length;
    const iceCount = totalRides - evCount;

    document.getElementById('summary-total-rides')!.textContent = totalRides.toString();
    document.getElementById('summary-combined-hp')!.textContent = `${combinedHp} HP`;
    document.getElementById('summary-ev-ice')!.textContent = `${evCount} EV / ${iceCount} ICE`;

    // 4. Render Ride Cards
    const container = document.getElementById('rides-container');
    if (container) {
      container.innerHTML = rides.map((ride, idx) => {
        const hp = ride.rdw_power_hp ? `${ride.rdw_power_hp} HP` : 'N/V';
        const cyl = ride.rdw_cylinders !== null && ride.rdw_cylinders !== undefined ? `${ride.rdw_cylinders} Cil` : '0 / EV';
        const cc = formatEngineCapacity(ride.rdw_capacity_cc);
        const price = formatPrice(ride.rdw_catalog_price);

        const pickupLocation = [ride.pickup_name, ride.pickup_address, ride.pickup_postal_city].filter(Boolean).join(', ');
        const dropoffLocation = [ride.dropoff_name, ride.dropoff_address, ride.dropoff_postal_city].filter(Boolean).join(', ');

        const fullVehicleTitle = formatVehicleTitle(ride.vehicle_build_year, ride.vehicle_make, ride.vehicle_model);

        const mapsOrigin = encodeURIComponent([ride.pickup_address, ride.pickup_postal_city].filter(Boolean).join(', ') || ride.pickup_name || '');
        const mapsDest = encodeURIComponent([ride.dropoff_address, ride.dropoff_postal_city].filter(Boolean).join(', ') || ride.dropoff_name || '');
        const googleMapsUrl = `https://www.google.com/maps/dir/?api=1&origin=${mapsOrigin}&destination=${mapsDest}`;

        return `
          <div class="p-6 rounded-2xl bg-slate-50/90 dark:bg-slate-900/70 border border-slate-300 dark:border-slate-800 shadow-md shadow-slate-200/70 dark:shadow-none space-y-6 font-mono">
            <!-- Ride Header -->
            <div class="flex flex-wrap items-center justify-between gap-4 border-b border-slate-300 dark:border-slate-800 pb-4">
              <div class="flex items-center space-x-3">
                <span class="px-3 py-1 rounded bg-cyan-950/40 border border-cyan-500/30 text-cyan-600 dark:text-cyan-400 font-bold text-sm">
                  ${ride.vehicle_license_plate}
                </span>
                <span class="text-slate-900 dark:text-slate-100 font-bold text-sm">
                  ${fullVehicleTitle || 'Onbekend Voertuig'}
                </span>
              </div>
              <div class="flex items-center space-x-3">
                <span class="text-xs text-slate-500 dark:text-slate-400">
                  Rit #${idx + 1} &bull; Venster: ${ride.pickup_window || 'N/V'}
                </span>
                <button 
                  data-ride-id="${ride.id}"
                  class="btn-delete-ride px-3 py-1 rounded border border-red-500/30 text-red-500 hover:bg-red-500/10 dark:hover:bg-red-500/20 font-bold text-xs transition-colors cursor-pointer flex items-center space-x-1"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                  </svg>
                  <span>Record Verwijderen</span>
                </button>
              </div>
            </div>

            <!-- Details Grid: Specs & Spatial -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs">
              
              <!-- Vehicle & RDW Specs Card -->
              <div class="p-4 rounded-xl bg-slate-100/60 dark:bg-slate-950/60 border border-slate-300 dark:border-slate-800/80 space-y-3">
                <div class="text-cyan-600 dark:text-cyan-400 font-bold text-xs uppercase tracking-wider border-b border-slate-300 dark:border-slate-800 pb-1">
                  // Voertuig &amp; RDW Specificaties
                </div>
                <div class="grid grid-cols-2 gap-2 text-slate-700 dark:text-slate-300">
                  <div><span class="text-slate-400 block">Voertuig:</span> ${fullVehicleTitle || 'N/V'}</div>
                  <div><span class="text-slate-400 block">Brandstof:</span> ${ride.vehicle_fuel || 'N/V'}</div>
                  <div><span class="text-slate-400 block">Kleur:</span> ${ride.vehicle_color || 'N/V'}</div>
                  <div><span class="text-slate-400 block">Vermogen:</span> ${hp}</div>
                  <div><span class="text-slate-400 block">Cilinders:</span> ${cyl}</div>
                  <div><span class="text-slate-400 block">Cilinderinhoud:</span> ${cc}</div>
                  <div><span class="text-slate-400 block">Catalogusprijs:</span> ${price}</div>
                </div>
              </div>

              <!-- Spatial Logistics & Route Card -->
              <div class="p-4 rounded-xl bg-slate-100/60 dark:bg-slate-950/60 border border-slate-300 dark:border-slate-800/80 space-y-3 flex flex-col justify-between">
                <div class="space-y-3">
                  <div class="text-cyan-600 dark:text-cyan-400 font-bold text-xs uppercase tracking-wider border-b border-slate-300 dark:border-slate-800 pb-1">
                    // Logistieke Route
                  </div>
                  <div class="space-y-2 text-slate-700 dark:text-slate-300">
                    <div>
                      <span class="text-cyan-500 font-bold block">Ophaallocatie:</span>
                      <span>${pickupLocation || 'N/V'}</span>
                    </div>
                    <div>
                      <span class="text-emerald-500 font-bold block">Afleverlocatie:</span>
                      <span>${dropoffLocation || 'N/V'}</span>
                    </div>
                  </div>
                </div>

                <div class="pt-2">
                  <a 
                    href="${googleMapsUrl}" 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="w-full sm:w-auto inline-flex items-center justify-center space-x-2 px-4 py-2 rounded-lg bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold text-xs transition-all shadow-md shadow-cyan-500/20"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                    <span>Open Route in Google Maps</span>
                    <span>&rarr;</span>
                  </a>
                </div>
              </div>

            </div>
          </div>
        `;
      }).join('');
    }

    // 5. Attach Deletion Event Listeners
    const deleteButtons = document.querySelectorAll('.btn-delete-ride');
    deleteButtons.forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const rideId = target.getAttribute('data-ride-id');
        if (!rideId) return;

        const confirmed = window.confirm("Weet je zeker dat je deze rit wilt verwijderen?");
        if (!confirmed) return;

        target.disabled = true;
        target.innerHTML = `<span>Verwijderen...</span>`;

        const { error: deleteError } = await supabase
          .from('shifts')
          .delete()
          .eq('id', rideId);

        if (deleteError) {
          alert(`Fout bij verwijderen record: ${deleteError.message}`);
          target.disabled = false;
          target.innerHTML = `<span>Record Verwijderen</span>`;
          return;
        }

        if (rides.length <= 1) {
          window.location.href = '/nl/dashboard';
        } else {
          window.location.reload();
        }
      });
    });

    loadingEl?.classList.add('hidden');
    contentEl?.classList.remove('hidden');

    // 6. Initialize Daily Operations Telemetry Map
    const mapEl = document.getElementById('daily-map');
    if (mapEl && typeof L !== 'undefined' && rides && rides.length > 0) {
      const map = L.map('daily-map', {
        center: [52.1326, 5.2913],
        zoom: 7.5,
        zoomControl: true
      });

      const lightTileUrl = 'https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Base/MapServer/tile/{z}/{y}/{x}';
      const darkTileUrl = 'https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}';

      const isDark = document.documentElement.classList.contains('dark');
      const initialTileUrl = isDark ? darkTileUrl : lightTileUrl;

      const tileLayer = L.tileLayer(initialTileUrl, {
        attribution: 'Tiles &copy; Esri &mdash; Esri, DeLorme, NAVTEQ',
        maxZoom: 16
      }).addTo(map);

      const observer = new MutationObserver(() => {
        const darkNow = document.documentElement.classList.contains('dark');
        tileLayer.setUrl(darkNow ? darkTileUrl : lightTileUrl);
      });
      observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

      const bounds = L.latLngBounds([]);

      rides.forEach((shift) => {
        // Draw precalculated route geometry if present
        if (Array.isArray(shift.route_geometry) && shift.route_geometry.length > 0) {
          L.polyline(shift.route_geometry, {
            color: '#06b6d4',
            weight: 3,
            opacity: 0.8
          }).addTo(map);
        }

        // Add Pickup & Dropoff Circle Markers and Extend Bounds
        const pLat = shift.pickup_lat;
        const pLng = shift.pickup_lng;
        const dLat = shift.dropoff_lat;
        const dLng = shift.dropoff_lng;

        if (typeof pLat === 'number' && typeof pLng === 'number') {
          const pickupPt: [number, number] = [pLat, pLng];
          bounds.extend(pickupPt);
          const pMarker = L.circleMarker(pickupPt, {
            radius: 4,
            color: '#06b6d4',
            fillColor: '#06b6d4',
            fillOpacity: 0.8,
            weight: 1
          }).addTo(map);

          pMarker.bindPopup(`
            <div class="font-mono text-xs space-y-1 text-slate-900">
              <div class="font-bold text-cyan-700">// OPHAALLOCATIE</div>
              <div><strong>Adres:</strong> ${shift.pickup_address || shift.pickup_postal_city || 'N/V'}</div>
              <div><strong>Voertuig:</strong> ${shift.vehicle_make || ''} ${shift.vehicle_model || ''}</div>
            </div>
          `);
        }

        if (typeof dLat === 'number' && typeof dLng === 'number') {
          const dropoffPt: [number, number] = [dLat, dLng];
          bounds.extend(dropoffPt);
          const dMarker = L.circleMarker(dropoffPt, {
            radius: 4,
            color: '#10b981',
            fillColor: '#10b981',
            fillOpacity: 0.8,
            weight: 1
          }).addTo(map);

          dMarker.bindPopup(`
            <div class="font-mono text-xs space-y-1 text-slate-900">
              <div class="font-bold text-emerald-700">// AFLEVERLOCATIE</div>
              <div><strong>Adres:</strong> ${shift.dropoff_address || shift.dropoff_postal_city || 'N/V'}</div>
              <div><strong>Voertuig:</strong> ${shift.vehicle_make || ''} ${shift.vehicle_model || ''}</div>
            </div>
          `);
        }
      });

      if (bounds.isValid()) {
        map.fitBounds(bounds, { padding: [40, 40] });
      }
    }
  }

  document.addEventListener('astro:page-load', loadShiftDetail);
</script>
