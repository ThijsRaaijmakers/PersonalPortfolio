---
import Layout from '../../layouts/Layout.astro';

const projects = [
  {
    slug: "car-hiker-tracker",
    title: "FleetPort Car Hiker Tracker",
    category: "Web Application & Automation",
    description: "Automated vehicle delivery tracking system integrating RDW open data API for real-time vehicle specs and deterministic regex email parsing for shift logging.",
    metrics: ["RDW Open Data API", "Regex Shift Parsing", "Real-time Vehicle Specs", "Supabase Backend"],
    tags: ["Astro", "Tailwind CSS", "Supabase", "RDW API"],
    status: "Active System",
    date: "2024"
  }
];
---

<Layout
  title="Projects Gallery | Thijs - Software & AI"
  description="Explore software engineering, automation, and cybersecurity projects by Thijs."
>
  <div class="space-y-10">
    
    <!-- Gallery Header -->
    <div class="space-y-4 border-b border-slate-200/80 dark:border-slate-800/80 pb-8 transition-colors">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-cyan-950/10 dark:bg-cyan-950/50 border border-cyan-500/30 text-cyan-600 dark:text-cyan-400 font-mono text-xs">
        <span class="text-cyan-500">///</span>
        <span>INDEX / PROJECTS</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 dark:text-slate-50 font-sans">
        Projects &amp; Software Engineering
      </h1>

      <p class="text-slate-600 dark:text-slate-300 max-w-2xl text-sm sm:text-base leading-relaxed">
        Featured technical implementations and software systems combining web development, API integrations, and automated data processing.
      </p>
    </div>

    <!-- Filter / Stats Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-4 rounded-xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800/80 font-mono text-xs text-slate-600 dark:text-slate-400">
      <div class="flex items-center space-x-2">
        <span class="text-cyan-600 dark:text-cyan-400">&gt;</span>
        <span>TOTAL_PROJECTS: <strong class="text-slate-900 dark:text-slate-200">{projects.length}</strong></span>
      </div>
      <div class="flex flex-wrap gap-2 text-[11px]">
        <span class="px-2.5 py-1 rounded bg-cyan-950/10 dark:bg-cyan-950 border border-cyan-500/30 text-cyan-600 dark:text-cyan-400 font-semibold">All</span>
        <span class="px-2 py-1 rounded bg-slate-100 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-400">Web &amp; Automation</span>
      </div>
    </div>

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 gap-6">
      {projects.map((project) => (
        <article class="p-6 sm:p-8 rounded-xl bg-white dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800 hover:border-cyan-500/40 hover:-translate-y-0.5 hover:shadow-[0_0_20px_rgba(6,182,212,0.1)] transition-all duration-300 flex flex-col justify-between group">
          <div class="space-y-4">
            
            <div class="flex flex-wrap justify-between items-center text-xs font-mono gap-2">
              <span class="text-cyan-600 dark:text-cyan-400 tracking-wider uppercase font-semibold">{project.category}</span>
              <div class="flex items-center space-x-2">
                <span class="text-slate-500 dark:text-slate-400">{project.date}</span>
                <span class="px-2 py-0.5 rounded bg-cyan-950/10 dark:bg-cyan-950/80 border border-cyan-500/30 text-cyan-700 dark:text-cyan-300 text-[10px]">
                  {project.status}
                </span>
              </div>
            </div>

            <h2 class="text-2xl font-bold text-slate-900 dark:text-slate-100 group-hover:text-cyan-600 dark:group-hover:text-cyan-300 transition-colors font-sans">
              <a href={`/projects/${project.slug}`}>
                {project.title}
              </a>
            </h2>

            <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed font-sans max-w-3xl">
              {project.description}
            </p>

            <!-- Key metrics / specs -->
            <div class="py-3 px-4 rounded bg-slate-50 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800/80 font-mono text-[11px] text-slate-600 dark:text-slate-400 space-y-1.5">
              <div class="text-[10px] text-slate-500 uppercase tracking-wider">Key Specifications:</div>
              <div class="flex flex-wrap gap-x-4 gap-y-1.5">
                {project.metrics.map((metric) => (
                  <span class="flex items-center space-x-1">
                    <span class="text-cyan-500/80">#</span>
                    <span class="text-slate-800 dark:text-slate-300">{metric}</span>
                  </span>
                ))}
              </div>
            </div>

          </div>

          <div class="pt-6 mt-6 border-t border-slate-200/80 dark:border-slate-800/60 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div class="flex flex-wrap gap-1.5">
              {project.tags.map((tag) => (
                <span class="px-2.5 py-1 rounded font-mono text-xs bg-slate-100 dark:bg-slate-950 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-800">
                  {tag}
                </span>
              ))}
            </div>
            
            <a 
              href={`/projects/${project.slug}`}
              class="px-4 py-2 rounded bg-slate-900 text-white dark:bg-slate-800 dark:text-cyan-400 group-hover:bg-cyan-500 group-hover:text-slate-950 font-mono text-xs font-semibold transition-all inline-flex items-center space-x-1"
            >
              <span>View Details</span>
              <span>&rarr;</span>
            </a>
          </div>
        </article>
      ))}
    </div>

  </div>
</Layout>
