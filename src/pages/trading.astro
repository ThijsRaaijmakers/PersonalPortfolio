  function renderEquityChart(history: any[], error?: string | null) {
    const portPath = document.getElementById('portfolio-path');
    const portArea = document.getElementById('portfolio-area');
    const bmPath = document.getElementById('benchmark-path');
    const gridLines = document.getElementById('chart-grid-lines');
    const yLabels = document.getElementById('chart-y-labels');
    const xLabelsContainer = document.getElementById('chart-x-labels');

    if (!portPath || !portArea || !bmPath) return;

    if (error) {
      if (gridLines) gridLines.innerHTML = '';
      if (yLabels) yLabels.innerHTML = '';
      if (xLabelsContainer) xLabelsContainer.innerHTML = '<span class="text-rose-500 font-bold">Error loading equity chart</span>';
      portPath.setAttribute('d', '');
      portArea.setAttribute('points', '');
      bmPath.setAttribute('d', '');
      return;
    }

    if (!history || history.length === 0) {
      if (gridLines) gridLines.innerHTML = '';
      if (yLabels) yLabels.innerHTML = '';
      if (xLabelsContainer) xLabelsContainer.innerHTML = '<span>No live production sessions recorded yet. Real capital executions will appear here automatically.</span>';
      portPath.setAttribute('d', '');
      portArea.setAttribute('points', '');
      bmPath.setAttribute('d', '');
      return;
    }

    const width = 800;
    const height = 240;
    const padX = 20;
    const padY = 30;

    const baseValue = Number(history[0]?.portfolio_value) || 100000;
    const dataPoints = history.map((h, i) => {
      const pv = Number(h.portfolio_value);
      const bm = baseValue * (1 + (i * 0.0035));
      return { date: h.run_timestamp, pv, bm };
    });

    const allValues = dataPoints.flatMap(d => [d.pv, d.bm]);
    const minVal = Math.min(...allValues) * 0.995;
    const maxVal = Math.max(...allValues) * 1.005;

    const scaleX = (idx: number) => {
      if (dataPoints.length === 1) return width / 2;
      return padX + (idx / (dataPoints.length - 1)) * (width - 2 * padX);
    };

    const scaleY = (val: number) => {
      if (maxVal === minVal) return height / 2;
      return height - padY - ((val - minVal) / (maxVal - minVal)) * (height - 2 * padY);
    };

    const pvPoints = dataPoints.map((d, i) => ({ x: scaleX(i), y: scaleY(d.pv) }));
    const bmPoints = dataPoints.map((d, i) => ({ x: scaleX(i), y: scaleY(d.bm) }));

    const pvD = pvPoints.map((pt, i) => `${i === 0 ? 'M' : 'L'} ${pt.x.toFixed(1)} ${pt.y.toFixed(1)}`).join(' ');
    const bmD = bmPoints.map((pt, i) => `${i === 0 ? 'M' : 'L'} ${pt.x.toFixed(1)} ${pt.y.toFixed(1)}`).join(' ');

    portPath.setAttribute('d', pvD);
    bmPath.setAttribute('d', bmD);

    const areaD = `${pvPoints[0].x.toFixed(1)},${(height - padY).toFixed(1)} ` +
      pvPoints.map(p => `${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' ') +
      ` ${pvPoints[pvPoints.length - 1].x.toFixed(1)},${(height - padY).toFixed(1)}`;
    portArea.setAttribute('points', areaD);

    if (gridLines && yLabels) {
      let gridHtml = '';
      let labelHtml = '';
      const steps = 4;
      for (let s = 0; s <= steps; s++) {
        const val = minVal + (s / steps) * (maxVal - minVal);
        const y = scaleY(val);
        gridHtml += `<line x1="${padX}" y1="${y}" x2="${width - padX}" y2="${y}" />`;
        labelHtml += `<text x="${padX}" y="${y - 4}">${formatDollar(val)}</text>`;
      }
      gridLines.innerHTML = gridHtml;
      yLabels.innerHTML = labelHtml;
    }

    if (xLabelsContainer && dataPoints.length > 0) {
      const firstDate = new Date(dataPoints[0].date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
      const lastDate = new Date(dataPoints[dataPoints.length - 1].date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
      xLabelsContainer.innerHTML = `
        <span>Start: ${firstDate}</span>
        <span class="text-cyan-500 font-bold">${dataPoints.length} Runs Recorded</span>
        <span>Latest: ${lastDate}</span>
      `;
    }

    const container = document.getElementById('chart-container');
    const crossLine = document.getElementById('crosshair-line');
    const crossPt = document.getElementById('crosshair-point');
    const tooltip = document.getElementById('chart-tooltip');
    const tooltipDate = document.getElementById('tooltip-date');
    const tooltipVal = document.getElementById('tooltip-val');
    const tooltipBm = document.getElementById('tooltip-bm');
    const tooltipAlpha = document.getElementById('tooltip-alpha');

    if (container && crossLine && crossPt && tooltip && tooltipDate && tooltipVal && tooltipBm && tooltipAlpha) {
      container.onmousemove = (e) => {
        const rect = container.getBoundingClientRect();
        const mouseX = e.clientX - rect.left;
        const normalizedX = (mouseX / rect.width) * width;

        let nearestIdx = 0;
        let minDiff = Infinity;
        pvPoints.forEach((pt, idx) => {
          const diff = Math.abs(pt.x - normalizedX);
          if (diff < minDiff) {
            minDiff = diff;
            nearestIdx = idx;
          }
        });

        const targetPt = pvPoints[nearestIdx];
        const pointData = dataPoints[nearestIdx];

        crossLine.setAttribute('x1', targetPt.x.toString());
        crossLine.setAttribute('x2', targetPt.x.toString());
        crossLine.setAttribute('opacity', '1');

        crossPt.setAttribute('cx', targetPt.x.toString());
        crossPt.setAttribute('cy', targetPt.y.toString());
        crossPt.setAttribute('opacity', '1');

        tooltip.classList.remove('hidden');
        const tooltipX = Math.min(rect.width - 190, Math.max(10, (targetPt.x / width) * rect.width - 80));
        tooltip.style.left = `${tooltipX}px`;
        tooltip.style.top = '10px';

        tooltipDate.textContent = new Date(pointData.date).toLocaleString('en-US', {
          month: 'short',
          day: '2-digit',
          hour: '2-digit',
          minute: '2-digit',
          hour12: false
        });
        tooltipVal.textContent = formatDollar(pointData.pv);
        tooltipBm.textContent = formatDollar(pointData.bm);

        const spread = pointData.pv - pointData.bm;
        const spreadSign = spread >= 0 ? '+' : '';
        tooltipAlpha.textContent = `${spreadSign}${formatDollar(spread)}`;
        tooltipAlpha.className = spread >= 0 ? 'font-bold text-emerald-400' : 'font-bold text-rose-400';
      };

      container.onmouseleave = () => {
        crossLine.setAttribute('opacity', '0');
        crossPt.setAttribute('opacity', '0');
        tooltip.classList.add('hidden');
      };
    }
  }

  function renderStreamsChart(history: any[], error?: string | null) {
    const streamsPathsGroup = document.getElementById('streams-paths-group');
    const streamsGridLines = document.getElementById('streams-grid-lines');
    const streamsYLabels = document.getElementById('streams-y-labels');
    const streamsXLabels = document.getElementById('streams-x-labels');

    if (!streamsPathsGroup) return;

    if (error) {
      streamsPathsGroup.innerHTML = '';
      if (streamsGridLines) streamsGridLines.innerHTML = '';
      if (streamsYLabels) streamsYLabels.innerHTML = '';
      if (streamsXLabels) streamsXLabels.innerHTML = '<span class="text-rose-500 font-bold">Error loading streams data</span>';
      return;
    }

    if (!history || history.length === 0) {
      streamsPathsGroup.innerHTML = '';
      if (streamsGridLines) streamsGridLines.innerHTML = '';
      if (streamsYLabels) streamsYLabels.innerHTML = '';
      if (streamsXLabels) streamsXLabels.innerHTML = '<span>No live production sessions recorded yet. Real capital executions will appear here automatically.</span>';
      return;
    }

    const width = 800;
    const height = 240;
    const padX = 20;
    const padY = 30;

    const maxWeight = 0.50;
    const scaleX = (idx: number) => {
      if (history.length === 1) return width / 2;
      return padX + (idx / (history.length - 1)) * (width - 2 * padX);
    };

    const scaleY = (weight: number) => {
      const clamped = Math.max(0, Math.min(maxWeight, weight));
      return height - padY - (clamped / maxWeight) * (height - 2 * padY);
    };

    if (streamsGridLines && streamsYLabels) {
      let gridHtml = '';
      let labelHtml = '';
      const levels = [0, 0.10, 0.20, 0.30, 0.40, 0.50];
      levels.forEach((lvl) => {
        const y = scaleY(lvl);
        gridHtml += `<line x1="${padX}" y1="${y}" x2="${width - padX}" y2="${y}" />`;
        labelHtml += `<text x="${padX}" y="${y - 4}">${(lvl * 100).toFixed(0)}%</text>`;
      });
      streamsGridLines.innerHTML = gridHtml;
      streamsYLabels.innerHTML = labelHtml;
    }

    const detectedKeys = new Set<string>();
    history.forEach(h => {
      Object.keys(h.weights_effective || {}).forEach(k => detectedKeys.add(k));
    });
    detectedKeys.add('CASH');
    const assetKeys = Array.from(detectedKeys);
    let pathsHtml = '';

    assetKeys.forEach((key) => {
      const color = ASSET_COLORS[key] || '#94a3b8';
      const points = history.map((h, i) => {
        let weight = 0;
        if (key === 'CASH') {
          weight = Number(h.cash_buffer_pct) || 0.02;
        } else {
          weight = Number(h.weights_effective?.[key] || 0);
        }
        return { x: scaleX(i), y: scaleY(weight), weight };
      });

      const d = points.map((p, i) => `${i === 0 ? 'M' : 'L'} ${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join(' ');
      pathsHtml += `
        <path 
          d="${d}" 
          fill="none" 
          stroke="${color}" 
          stroke-width="2.5" 
          stroke-linejoin="round"
          class="transition-all hover:stroke-width-4 cursor-pointer" 
        />
      `;

      points.forEach((p) => {
        pathsHtml += `<circle cx="${p.x.toFixed(1)}" cy="${p.y.toFixed(1)}" r="3" fill="${color}" stroke="#0f172a" stroke-width="1.5" />`;
      });
    });

    streamsPathsGroup.innerHTML = pathsHtml;

    if (streamsXLabels && history.length > 0) {
      const firstDate = new Date(history[0].run_timestamp).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
      const lastDate = new Date(history[history.length - 1].run_timestamp).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
      streamsXLabels.innerHTML = `
        <span>Start: ${firstDate}</span>
        <span class="text-cyan-500 font-bold">${history.length} Runs Tracked</span>
        <span>Latest: ${lastDate}</span>
      `;
    }

    const container = document.getElementById('streams-container');
    const crossLine = document.getElementById('streams-crosshair-line');
    const tooltip = document.getElementById('streams-tooltip');
    const tooltipDate = document.getElementById('streams-tooltip-date');
    const tooltipItems = document.getElementById('streams-tooltip-items');

    if (container && crossLine && tooltip && tooltipDate && tooltipItems) {
      container.onmousemove = (e) => {
        const rect = container.getBoundingClientRect();
        const mouseX = e.clientX - rect.left;
        const normalizedX = (mouseX / rect.width) * width;

        let nearestIdx = 0;
        let minDiff = Infinity;
        history.forEach((_, idx) => {
          const ptX = scaleX(idx);
          const diff = Math.abs(ptX - normalizedX);
          if (diff < minDiff) {
            minDiff = diff;
            nearestIdx = idx;
          }
        });

        const targetX = scaleX(nearestIdx);
        const pointData = history[nearestIdx];

        crossLine.setAttribute('x1', targetX.toString());
        crossLine.setAttribute('x2', targetX.toString());
        crossLine.setAttribute('opacity', '1');

        tooltip.classList.remove('hidden');
        const tooltipX = Math.min(rect.width - 200, Math.max(10, (targetX / width) * rect.width - 90));
        tooltip.style.left = `${tooltipX}px`;
        tooltip.style.top = '10px';

        tooltipDate.textContent = new Date(pointData.run_timestamp).toLocaleString('en-US', {
          month: 'short',
          day: '2-digit',
          hour: '2-digit',
          minute: '2-digit',
          hour12: false
        });

        let itemsHtml = '';
        assetKeys.forEach((key) => {
          const color = ASSET_COLORS[key] || '#94a3b8';
          let w = 0;
          if (key === 'CASH') {
            w = Number(pointData.cash_buffer_pct) || 0.02;
          } else {
            w = Number(pointData.weights_effective?.[key] || 0);
          }
          itemsHtml += `
            <div class="flex items-center justify-between space-x-3">
              <span class="flex items-center space-x-1.5">
                <span class="w-2 h-2 rounded-full" style="background-color: ${color}"></span>
                <span class="text-slate-300 font-semibold">${key}:</span>
              </span>
              <span class="font-bold text-slate-100">${(w * 100).toFixed(2)}%</span>
            </div>
          `;
        });
        tooltipItems.innerHTML = itemsHtml;
      };

      container.onmouseleave = () => {
        crossLine.setAttribute('opacity', '0');
        tooltip.classList.add('hidden');
      };
    }
  }

  function renderDrawdownChart(history: any[], error?: string | null) {
    const drawPath = document.getElementById('drawdown-path');
    const drawArea = document.getElementById('drawdown-area');
    const gridLines = document.getElementById('drawdown-grid-lines');
    const yLabels = document.getElementById('drawdown-y-labels');
    const xLabelsContainer = document.getElementById('drawdown-x-labels');
    const stopLine = document.getElementById('drawdown-stop-line');
    const stopLabel = document.getElementById('drawdown-stop-label');
    const zeroLine = document.getElementById('drawdown-zero-line');
    const pointsGroup = document.getElementById('drawdown-points-group');

    if (!drawPath || !drawArea) return;

    if (error) {
      if (gridLines) gridLines.innerHTML = '';
      if (yLabels) yLabels.innerHTML = '';
      if (pointsGroup) pointsGroup.innerHTML = '';
      if (xLabelsContainer) xLabelsContainer.innerHTML = '<span class="text-rose-500 font-bold">Error loading drawdown telemetry</span>';
      drawPath.setAttribute('d', '');
      drawArea.setAttribute('points', '');
      return;
    }

    if (!history || history.length === 0) {
      if (gridLines) gridLines.innerHTML = '';
      if (yLabels) yLabels.innerHTML = '';
      if (pointsGroup) pointsGroup.innerHTML = '';
      if (xLabelsContainer) {
        xLabelsContainer.innerHTML = '<span>No live production sessions recorded yet. Real capital executions will appear here automatically.</span>';
      }
      drawPath.setAttribute('d', '');
      drawArea.setAttribute('points', '');
      return;
    }

    const width = 800;
    const height = 240;
    const padX = 20;
    const padY = 24;

    let peak = 0;
    const dataPoints = history.map((h, i) => {
      const pv = Number(h.portfolio_value) || 0;
      if (i === 0 || pv > peak) {
        peak = pv;
      }
      const rawDd = peak > 0 ? ((pv - peak) / peak) * 100 : 0;
      const dd = Math.min(0, Number(rawDd.toFixed(2)));
      return {
        date: h.run_timestamp,
        pv,
        peak,
        dd
      };
    });

    const minDdVal = -15.0;
    const scaleX = (idx: number) => {
      if (dataPoints.length === 1) return width / 2;
      return padX + (idx / (dataPoints.length - 1)) * (width - 2 * padX);
    };

    const scaleY = (val: number) => {
      const clamped = Math.max(minDdVal, Math.min(0, val));
      return padY + ((0 - clamped) / (0 - minDdVal)) * (height - 2 * padY);
    };

    const zeroY = scaleY(0);
    const stopY = scaleY(-4.0);

    if (zeroLine) {
      zeroLine.setAttribute('x1', padX.toString());
      zeroLine.setAttribute('x2', (width - padX).toString());
      zeroLine.setAttribute('y1', zeroY.toString());
      zeroLine.setAttribute('y2', zeroY.toString());
    }

    if (stopLine) {
      stopLine.setAttribute('x1', padX.toString());
      stopLine.setAttribute('x2', (width - padX).toString());
      stopLine.setAttribute('y1', stopY.toString());
      stopLine.setAttribute('y2', stopY.toString());
    }

    if (stopLabel) {
      stopLabel.setAttribute('y', (stopY - 4).toString());
      stopLabel.setAttribute('x', (width - padX - 160).toString());
    }

    if (gridLines && yLabels) {
      let gridHtml = '';
      let labelHtml = '';
      const levels = [0, -4.0, -8.0, -12.0, -15.0];
      levels.forEach(lvl => {
        const y = scaleY(lvl);
        gridHtml += `<line x1="${padX}" y1="${y.toFixed(1)}" x2="${(width - padX).toFixed(1)}" y2="${y.toFixed(1)}" stroke-dasharray="${lvl === -4.0 ? '4 4' : '2 2'}" opacity="${lvl === 0 ? '0.6' : '0.25'}" />`;
        labelHtml += `<text x="${padX}" y="${(y - 4).toFixed(1)}">${lvl.toFixed(1)}%</text>`;
      });
      gridLines.innerHTML = gridHtml;
      yLabels.innerHTML = labelHtml;
    }

    const points = dataPoints.map((d, i) => ({
      x: scaleX(i),
      y: scaleY(d.dd),
      data: d
    }));

    const pathD = points.map((p, i) => `${i === 0 ? 'M' : 'L'} ${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join(' ');
    drawPath.setAttribute('d', pathD);

    const areaD = `${points[0].x.toFixed(1)},${zeroY.toFixed(1)} ` +
      points.map(p => `${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' ') +
      ` ${points[points.length - 1].x.toFixed(1)},${zeroY.toFixed(1)}`;
    drawArea.setAttribute('points', areaD);

    if (pointsGroup) {
      pointsGroup.innerHTML = points.map(p => 
        `<circle cx="${p.x.toFixed(1)}" cy="${p.y.toFixed(1)}" r="3.5" fill="#f43f5e" stroke="#0f172a" stroke-width="1.5" />`
      ).join('');
    }

    if (xLabelsContainer && dataPoints.length > 0) {
      const firstDate = new Date(dataPoints[0].date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
      const lastDate = new Date(dataPoints[dataPoints.length - 1].date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
      const minDdInSeries = Math.min(...dataPoints.map(d => d.dd));
      xLabelsContainer.innerHTML = `
        <span>Start Telemetry: ${firstDate}</span>
        <span class="text-rose-500 font-bold">Max Drawdown: ${minDdInSeries.toFixed(2)}%</span>
        <span>Latest: ${lastDate}</span>
      `;
    }

    const container = document.getElementById('drawdown-container');
    const crossLine = document.getElementById('drawdown-crosshair-line');
    const crossPt = document.getElementById('drawdown-crosshair-point');
    const tooltip = document.getElementById('drawdown-tooltip');
    const tooltipDate = document.getElementById('drawdown-tooltip-date');
    const tooltipVal = document.getElementById('drawdown-tooltip-val');
    const tooltipPv = document.getElementById('drawdown-tooltip-pv');
    const tooltipPeak = document.getElementById('drawdown-tooltip-peak');

    if (container && crossLine && crossPt && tooltip && tooltipDate && tooltipVal && tooltipPv && tooltipPeak) {
      container.onmousemove = (e) => {
        const rect = container.getBoundingClientRect();
        const mouseX = e.clientX - rect.left;
        const normalizedX = (mouseX / rect.width) * width;

        let nearestIdx = 0;
        let minDiff = Infinity;
        points.forEach((pt, idx) => {
          const diff = Math.abs(pt.x - normalizedX);
          if (diff < minDiff) {
            minDiff = diff;
            nearestIdx = idx;
          }
        });

        const targetPt = points[nearestIdx];
        const pData = targetPt.data;

        crossLine.setAttribute('x1', targetPt.x.toString());
        crossLine.setAttribute('x2', targetPt.x.toString());
        crossLine.setAttribute('opacity', '1');

        crossPt.setAttribute('cx', targetPt.x.toString());
        crossPt.setAttribute('cy', targetPt.y.toString());
        crossPt.setAttribute('opacity', '1');

        tooltip.classList.remove('hidden');
        const tooltipX = Math.min(rect.width - 200, Math.max(10, (targetPt.x / width) * rect.width - 80));
        tooltip.style.left = `${tooltipX}px`;
        tooltip.style.top = '10px';

        tooltipDate.textContent = new Date(pData.date).toLocaleString('en-US', {
          month: 'short',
          day: '2-digit',
          hour: '2-digit',
          minute: '2-digit',
          hour12: false
        });

        tooltipVal.textContent = `${pData.dd.toFixed(2)}%`;
        tooltipPv.textContent = formatDollar(pData.pv);
        tooltipPeak.textContent = formatDollar(pData.peak);
      };

      container.onmouseleave = () => {
        crossLine.setAttribute('opacity', '0');
        crossPt.setAttribute('opacity', '0');
        tooltip.classList.add('hidden');
      };
    }
  }

  function renderOrdersLedger(latest: any, error?: string | null) {
    const container = document.getElementById('orders-rows-container');
    const countEl = document.getElementById('orders-count');
    if (!container) return;

    if (error) {
      if (countEl) countEl.textContent = '0 orders (error)';
      container.innerHTML = `
        <div class="p-8 text-center text-rose-500 font-mono text-xs">
          // Error loading order rebalance ledger: ${error}
        </div>
      `;
      return;
    }

    if (!latest) {
      if (countEl) countEl.textContent = '0 orders';
      container.innerHTML = `
        <div class="p-8 text-center text-slate-400 font-mono text-xs">
          // No live production sessions recorded yet. Real capital executions will automatically appear here.
        </div>
      `;
      return;
    }

    const orders = latest.orders_executed || [];
    if (countEl) countEl.textContent = `${orders.length} orders in latest rebalance`;

    if (orders.length === 0) {
      container.innerHTML = `
        <div class="p-8 text-center text-slate-400 font-mono text-xs">
          // No order rebalance executions required for this run.
        </div>
      `;
      return;
    }

    const timestampStr = new Date(latest.run_timestamp).toLocaleString('en-US', {
      month: 'short',
      day: '2-digit',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false
    });

    const feePerOrder = (Number(latest.broker_fees || 0) / orders.length).toFixed(2);

    const rowsHtml = orders.map((order: any, idx: number) => {
      const isBuy = String(order.side).toUpperCase() === 'BUY';
      const actionBadge = isBuy
        ? 'bg-emerald-500/10 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 border-emerald-500/30'
        : 'bg-rose-500/10 dark:bg-rose-950/50 text-rose-600 dark:text-rose-400 border-rose-500/30';

      const statusBadge = order.status === 'FILLED'
        ? 'bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border-cyan-500/30'
        : 'bg-purple-500/10 text-purple-600 dark:text-purple-400 border-purple-500/30';

      return `
        <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 p-4 items-center hover:bg-slate-100/50 dark:hover:bg-slate-900/40 transition-colors min-w-0" style="animation-delay: ${idx * 40}ms">
          <div class="sm:col-span-3 text-slate-500 dark:text-slate-400 text-xs truncate">
            ${timestampStr}
          </div>

          <div class="sm:col-span-2 font-bold text-slate-900 dark:text-slate-100 flex items-center space-x-1.5 min-w-0">
            <span>${order.ticker}</span>
            <span class="text-[10px] text-slate-400 font-normal hidden lg:inline truncate">(${ASSET_NAMES[order.ticker] || 'Stock'})</span>
          </div>

          <div class="sm:col-span-2">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded text-[11px] font-bold border uppercase tracking-wider ${actionBadge}">
              ${order.side}
            </span>
          </div>

          <div class="sm:col-span-2 font-semibold text-slate-800 dark:text-slate-200">
            ${formatDollar(Number(order.notional))}
          </div>

          <div class="sm:col-span-2">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded text-[10px] font-bold border uppercase tracking-wider ${statusBadge}">
              ${order.status}
            </span>
          </div>

          <div class="sm:col-span-1 text-right text-slate-400 font-medium">
            $${feePerOrder}
          </div>
        </div>
      `;
    }).join('');

    container.innerHTML = rowsHtml;
  }

  async function loadTradingDesk() {
    if (window.location.pathname.startsWith('/nl')) return;

    const { data: { session } } = await supabase.auth.getSession();
    
    let isAdmin = false;
    if (session) {
      const { data: profile } = await supabase
        .from('profiles')
        .select('role')
        .eq('id', session.user.id)
        .single();
      isAdmin = profile?.role === 'admin';
    }

    if (!session || !isAdmin) {
      window.location.href = '/';
      return;
    }

    document.getElementById('secure-enclave')?.classList.remove('opacity-0', 'pointer-events-none');

    const userIdentity = document.getElementById('user-identity');
    if (userIdentity && session?.user?.email) {
      userIdentity.textContent = `// Identity: ${session.user.email} (Clearance Level: QUANT_ADMIN)`;
    }

    // Declare DOM refs first — before any function calls that reference them
    const paperBtn = document.getElementById('env-paper-btn') as HTMLButtonElement | null;
    const liveBtn = document.getElementById('env-live-btn') as HTMLButtonElement | null;

    function updateEnvButtons() {
      if (paperBtn && liveBtn) {
        if (currentVenue === 'paper') {
          paperBtn.className = 'flex items-center space-x-1.5 px-3 py-1.5 rounded-lg border transition-all duration-200 font-bold bg-amber-500/15 text-amber-600 dark:text-amber-400 border-amber-500/40 shadow-sm cursor-pointer';
          paperBtn.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span><span>Paper Trading (Active)</span>';
          liveBtn.className = 'flex items-center space-x-1.5 px-3 py-1.5 rounded-lg border border-transparent text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 transition-all duration-200 font-medium cursor-pointer';
          liveBtn.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-emerald-500/40"></span><span>Live Trading</span>';
        } else {
          paperBtn.className = 'flex items-center space-x-1.5 px-3 py-1.5 rounded-lg border border-transparent text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 transition-all duration-200 font-medium cursor-pointer';
          paperBtn.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-amber-400/40"></span><span>Paper Trading</span>';
          liveBtn.className = 'flex items-center space-x-1.5 px-3 py-1.5 rounded-lg border transition-all duration-200 font-bold bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 border-emerald-500/40 shadow-sm cursor-pointer';
          liveBtn.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span><span>Live Trading (Active)</span>';
        }
      }
    }

    async function updateDashboard() {
      const { latest, history, error } = await fetchTelemetryData(currentVenue);
      renderKPIs(latest, history, error);
      renderExecutiveWidgets(latest, error);
      renderAllocationMatrix(latest, error);
      renderEquityChart(history, error);
      renderStreamsChart(history, error);
      renderDrawdownChart(history, error);
      renderOrdersLedger(latest, error);
    }

    // Read Venue from URL on load and synchronize language toggles
    const initialParams = new URLSearchParams(window.location.search);
    currentVenue = initialParams.get('venue') === 'live' ? 'live' : 'paper';
    syncUrlAndLangToggles(currentVenue);
    updateEnvButtons();

    // Attach idempotent event listeners using data flag
    const enclave = document.getElementById('secure-enclave');
    if (!enclave?.dataset.bound) {
      if (enclave) enclave.dataset.bound = 'true';

      paperBtn?.addEventListener('click', async () => {
        if (currentVenue === 'paper') return;
        currentVenue = 'paper';
        syncUrlAndLangToggles(currentVenue);
        updateEnvButtons();
        await triggerRefresh();
      });

      liveBtn?.addEventListener('click', async () => {
        if (currentVenue === 'live') return;
        currentVenue = 'live';
        syncUrlAndLangToggles(currentVenue);
        updateEnvButtons();
        await triggerRefresh();
      });

      const tabEquityBtn = document.getElementById('chart-tab-equity');
      const tabStreamsBtn = document.getElementById('chart-tab-streams');
      const tabDrawdownBtn = document.getElementById('chart-tab-drawdown');
      const equityView = document.getElementById('equity-chart-view');
      const streamsView = document.getElementById('streams-chart-view');
      const drawdownView = document.getElementById('drawdown-chart-view');
      const equityLegend = document.getElementById('equity-legend');
      const streamsLegend = document.getElementById('streams-legend');
      const drawdownLegend = document.getElementById('drawdown-legend');

      tabEquityBtn?.addEventListener('click', () => {
        if (activeChartTab === 'equity') return;
        activeChartTab = 'equity';
        updateChartTabUI();
      });

      tabStreamsBtn?.addEventListener('click', () => {
        if (activeChartTab === 'streams') return;
        activeChartTab = 'streams';
        updateChartTabUI();
      });

      tabDrawdownBtn?.addEventListener('click', () => {
        if (activeChartTab === 'drawdown') return;
        activeChartTab = 'drawdown';
        updateChartTabUI();
      });

      function updateChartTabUI() {
        const activeClasses = ['bg-cyan-500/15', 'text-cyan-600', 'dark:text-cyan-400', 'border-cyan-500/40', 'font-bold', 'shadow-sm'];
        const inactiveClasses = ['text-slate-500', 'dark:text-slate-400', 'border-transparent', 'font-medium'];

        [tabEquityBtn, tabStreamsBtn, tabDrawdownBtn].forEach(b => {
          b?.classList.remove(...activeClasses);
          b?.classList.add(...inactiveClasses);
        });

        equityView?.classList.add('hidden');
        streamsView?.classList.add('hidden');
        drawdownView?.classList.add('hidden');

        equityLegend?.classList.add('hidden');
        streamsLegend?.classList.add('hidden');
        drawdownLegend?.classList.add('hidden');

        if (activeChartTab === 'equity') {
          tabEquityBtn?.classList.add(...activeClasses);
          tabEquityBtn?.classList.remove(...inactiveClasses);
          equityView?.classList.remove('hidden');
          equityLegend?.classList.remove('hidden');
        } else if (activeChartTab === 'streams') {
          tabStreamsBtn?.classList.add(...activeClasses);
          tabStreamsBtn?.classList.remove(...inactiveClasses);
          streamsView?.classList.remove('hidden');
          streamsLegend?.classList.remove('hidden');
        } else if (activeChartTab === 'drawdown') {
          tabDrawdownBtn?.classList.add(...activeClasses);
          tabDrawdownBtn?.classList.remove(...inactiveClasses);
          drawdownView?.classList.remove('hidden');
          drawdownLegend?.classList.remove('hidden');
        }
      }

      const refreshBtn = document.getElementById('refresh-telemetry-btn');
      refreshBtn?.addEventListener('click', async () => {
        await triggerRefresh();
      });
    }

    async function triggerRefresh() {
      const refreshIcon = document.getElementById('refresh-icon');
      const refreshOverlay = document.getElementById('refresh-overlay');
      const telemetryContent = document.getElementById('telemetry-content');

      if (refreshIcon) refreshIcon.classList.add('animate-spin');
      if (refreshOverlay) refreshOverlay.classList.remove('hidden');
      if (telemetryContent) {
        telemetryContent.classList.add('opacity-25', 'blur-[1px]', 'pointer-events-none');
      }

      await updateDashboard();

      setTimeout(() => {
        if (refreshOverlay) refreshOverlay.classList.add('hidden');
        if (telemetryContent) {
          telemetryContent.classList.remove('opacity-25', 'blur-[1px]', 'pointer-events-none');
        }
        if (refreshIcon) refreshIcon.classList.remove('animate-spin');
      }, 350);
    }

    await updateDashboard();
  }

  document.addEventListener('astro:page-load', loadTradingDesk);
</script>
