---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import WorkspaceNav from '../components/WorkspaceNav.astro';
import { supabase } from '../lib/supabase';

// Server-side profile check for admin clearance
const { data: { session } } = await supabase.auth.getSession();
let userEmail = '';

if (session) {
  userEmail = session.user.email || '';
  const { data: profile } = await supabase
    .from('profiles')
    .select('role')
    .eq('id', session.user.id)
    .single();

  if (profile?.role !== 'admin') {
    return Astro.redirect('/');
  }
}
---

<Layout 
  description="Autonomous Quant Trading Desk Cockpit & Dirichlet-Simplex Telemetry Monitor." 
  title="Quant Trading Desk | Executive Terminal"
>
  <div id="secure-enclave" class="max-w-7xl mx-auto py-8 sm:py-12 space-y-8 animate-fade-in-up opacity-0 pointer-events-none transition-opacity duration-300">
    
    <!-- Breadcrumbs -->
    <Breadcrumbs 
      items={[
        { label: 'Home', href: '/' },
        { label: 'Dashboard', href: '/dashboard' },
        { label: 'Quant Trading Desk' }
      ]} 
    />

    <!-- Administrative Workspace Navigation -->
    <WorkspaceNav activeTab="trading" />

    <!-- Top Bar / Header -->
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 border-b border-slate-300 dark:border-slate-800 pb-6 min-w-0">
      <div class="space-y-1.5 min-w-0">
        <div class="flex items-center space-x-2.5 flex-wrap gap-y-1">
          <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-cyan-950/10 dark:bg-cyan-950/60 border border-cyan-500/30 font-mono text-xs text-cyan-600 dark:text-cyan-400">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>QUANT TRADING DESK &bull; SECURE CONSOLE</span>
          </div>

          <span 
            id="admin-badge" 
            class="inline-flex items-center space-x-1.5 px-2.5 py-0.5 rounded bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border border-cyan-500/30 font-mono text-[10px] font-bold tracking-wider uppercase shadow-sm shadow-cyan-500/10"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-ping"></span>
            <span>ADMIN</span>
          </span>

          <span 
            id="venue-header-badge"
            class="inline-flex items-center space-x-1.5 px-2.5 py-0.5 rounded bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/30 font-mono text-[10px] font-bold tracking-wider uppercase"
          >
            <span>ALPACA VENUE: PAPER</span>
          </span>
        </div>

        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-slate-50 font-sans tracking-tight truncate">
          Quant Trading Desk Cockpit
        </h1>
        <p id="user-identity" class="text-xs font-mono text-slate-500 dark:text-slate-400 truncate">
          {userEmail ? `// Identity: ${userEmail}` : '// Identity: Verifying security enclave...'}
        </p>
      </div>

      <!-- Header Controls: Environment Switcher + Refresh Button -->
      <div class="flex flex-wrap items-center gap-3 shrink-0">
        <!-- Environment Filter Switcher Toggle -->
        <div class="inline-flex p-1 rounded-xl bg-slate-100/90 dark:bg-slate-950/80 border border-slate-300 dark:border-slate-800 text-xs font-mono shadow-sm">
          <button 
            id="env-paper-btn" 
            type="button"
            class="flex items-center space-x-1.5 px-3 py-1.5 rounded-lg border transition-all duration-200 font-bold bg-amber-500/15 text-amber-600 dark:text-amber-400 border-amber-500/40 shadow-sm cursor-pointer"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
            <span>Paper Trading (Active)</span>
          </button>
          <button 
            id="env-live-btn" 
            type="button"
            class="flex items-center space-x-1.5 px-3 py-1.5 rounded-lg border border-transparent text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 transition-all duration-200 font-medium cursor-pointer"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500/40"></span>
            <span>Live Trading</span>
          </button>
        </div>

        <!-- Refresh Telemetry Button -->
        <button 
          id="refresh-telemetry-btn" 
          type="button"
          class="px-4 py-2 rounded-lg bg-slate-100/80 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 text-xs font-mono text-slate-700 dark:text-slate-300 font-semibold shadow-sm transition-colors hover:bg-slate-200/80 dark:hover:bg-slate-900 cursor-pointer flex items-center space-x-2"
        >
          <svg id="refresh-icon" class="w-3.5 h-3.5 text-cyan-500 transition-transform duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          <span>Refresh Telemetry</span>
        </button>
      </div>
    </div>

    <!-- MAIN TELEMETRY WRAPPER WITH GREYED-OUT REFRESH FEEDBACK -->
    <div id="telemetry-content-wrapper" class="relative min-w-0">
      
      <!-- Floating Syncing Realtime Telemetry Badge -->
      <div id="refresh-overlay" class="hidden absolute inset-0 z-40 flex items-center justify-center bg-slate-950/20 backdrop-blur-[1px] rounded-2xl">
        <div class="px-5 py-2.5 rounded-xl bg-slate-900 border border-cyan-500/40 text-cyan-400 font-mono text-xs flex items-center space-x-2.5 shadow-2xl">
          <span class="w-3.5 h-3.5 border-2 border-cyan-400 border-t-transparent rounded-full animate-spin"></span>
          <span>Syncing Realtime Telemetry...</span>
        </div>
      </div>

      <!-- Telemetry Content Container -->
      <div id="telemetry-content" class="space-y-8 transition-all duration-300 min-w-0">

        <!-- MODULE 1: 2x2 EXECUTIVE KPI GRID (No overflow-hidden to prevent tooltip clipping) -->
        <div id="kpi-grid" class="grid grid-cols-1 md:grid-cols-2 gap-5 sm:gap-6 min-w-0">
          
          <!-- Card 1: Portfolio Value -->
          <div class="min-w-0 p-5 sm:p-6 rounded-2xl bg-slate-50/90 dark:bg-slate-900/60 border border-slate-300 dark:border-slate-800 shadow-md shadow-slate-200/70 dark:shadow-none space-y-3 font-mono flex flex-col justify-between">
            <div class="flex items-center justify-between gap-3 mb-1">
              <div class="flex items-center space-x-2">
                <span class="text-xs font-mono text-slate-500 dark:text-slate-400 uppercase tracking-wider">// Portfolio Value</span>
                <div class="relative group/tooltip inline-block">
                  <button type="button" class="w-4 h-4 rounded-full bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:text-cyan-500 dark:hover:text-cyan-400 text-[10px] flex items-center justify-center cursor-help">?</button>
                  <div class="hidden group-hover/tooltip:block absolute left-0 bottom-full mb-2 w-72 p-3 rounded-xl bg-slate-950/95 border border-slate-700 text-slate-200 text-xs shadow-2xl z-50 pointer-events-none leading-relaxed backdrop-blur-md">
                    Total aggregated market valuation across active algorithmic equity positions and liquid cash balances.
                  </div>
                </div>
              </div>
              <span id="kpi-daily-badge" class="shrink-0 text-[10px] font-mono font-bold px-2.5 py-1 rounded border bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/30 whitespace-nowrap">
                +0.00%
              </span>
            </div>

            <div class="flex items-baseline space-x-2 py-1 min-w-0">
              <span id="kpi-portfolio-value" class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-slate-50 tracking-tight whitespace-nowrap">
                $0.00
              </span>
            </div>

            <div class="flex items-center justify-between text-[11px] text-slate-400 dark:text-slate-500 pt-2 border-t border-slate-200 dark:border-slate-800/80">
              <span id="kpi-run-timestamp" class="truncate">Last Execution: Pending...</span>
              <span class="text-cyan-500 dark:text-cyan-400 font-semibold">Alpaca Paper / Live</span>
            </div>
          </div>

          <!-- Card 2: Cumulative Strategy Alpha -->
          <div class="min-w-0 p-5 sm:p-6 rounded-2xl bg-slate-50/90 dark:bg-slate-900/60 border border-slate-300 dark:border-slate-800 shadow-md shadow-slate-200/70 dark:shadow-none space-y-3 font-mono flex flex-col justify-between">
            <div class="flex items-center justify-between gap-3 mb-1">
              <div class="flex items-center space-x-2">
                <span class="text-xs font-mono text-slate-500 dark:text-slate-400 uppercase tracking-wider">// Cumulative Strategy Alpha</span>
                <div class="relative group/tooltip inline-block">
                  <button type="button" class="w-4 h-4 rounded-full bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:text-cyan-500 dark:hover:text-cyan-400 text-[10px] flex items-center justify-center cursor-help">?</button>
                  <div class="hidden group-hover/tooltip:block absolute left-0 bottom-full mb-2 w-72 p-3 rounded-xl bg-slate-950/95 border border-slate-700 text-slate-200 text-xs shadow-2xl z-50 pointer-events-none leading-relaxed backdrop-blur-md">
                    Excess return generated over the equal-weight Buy &amp; Hold benchmark basket.
                  </div>
                </div>
              </div>
              <span id="kpi-alpha-badge" class="shrink-0 text-[10px] font-mono font-bold px-2.5 py-1 rounded border bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/30 whitespace-nowrap shadow-sm shadow-emerald-500/10">
                ALPHA: +9.40%
              </span>
            </div>

            <div class="flex items-baseline space-x-2 py-1 min-w-0">
              <span id="kpi-alpha-value" class="text-3xl sm:text-4xl font-extrabold text-emerald-600 dark:text-emerald-400 tracking-tight whitespace-nowrap">
                +9.40%
              </span>
            </div>

            <!-- Sub-row: Strategy ROI & Benchmark ROI -->
            <div class="grid grid-cols-2 gap-3 py-1.5 border-y border-slate-200 dark:border-slate-800/80 my-0.5 text-xs">
              <div class="space-y-0.5">
                <span class="text-[10px] text-slate-400 block uppercase">Strategy ROI</span>
                <span id="kpi-strategy-roi" class="font-bold text-slate-900 dark:text-slate-100">+17.60%</span>
              </div>
              <div class="space-y-0.5 border-l border-slate-200 dark:border-slate-800/80 pl-3">
                <span class="text-[10px] text-slate-400 block uppercase">Benchmark ROI</span>
                <span id="kpi-benchmark-roi" class="font-bold text-slate-500 dark:text-slate-400">+8.20%</span>
              </div>
            </div>

            <div class="flex items-center justify-between text-[11px] text-slate-400 dark:text-slate-500 pt-1">
              <span id="kpi-alpha-spread" class="truncate">Alpha Spread: +$281.89 Outperformance</span>
              <span class="text-emerald-500 font-semibold shrink-0">Benchmark Beat</span>
            </div>
          </div>

          <!-- Card 3: Risk-Adjusted Alpha (DSOR & Ulcer Split Sub-Columns) -->
          <div class="min-w-0 p-5 sm:p-6 rounded-2xl bg-slate-50/90 dark:bg-slate-900/60 border border-slate-300 dark:border-slate-800 shadow-md shadow-slate-200/70 dark:shadow-none space-y-3 font-mono flex flex-col justify-between">
            <div class="flex items-center justify-between gap-3 mb-1">
              <div class="flex items-center space-x-2">
                <span class="text-xs font-mono text-slate-500 dark:text-slate-400 uppercase tracking-wider">// Risk-Adjusted Alpha</span>
                <div class="relative group/tooltip inline-block">
                  <button type="button" class="w-4 h-4 rounded-full bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:text-cyan-500 dark:hover:text-cyan-400 text-[10px] flex items-center justify-center cursor-help">?</button>
                  <div class="hidden group-hover/tooltip:block absolute left-0 bottom-full mb-2 w-72 p-3 rounded-xl bg-slate-950/95 border border-slate-700 text-slate-200 text-xs shadow-2xl z-50 pointer-events-none leading-relaxed backdrop-blur-md">
                    Differential Sortino Ratio (DSoR) measures excess return per unit of downside deviation. Ulcer Index measures depth and duration of drawdowns.
                  </div>
                </div>
              </div>
              <span class="shrink-0 text-[10px] font-mono font-semibold px-2.5 py-1 rounded border bg-purple-500/10 text-purple-600 dark:text-purple-400 border-purple-500/30 whitespace-nowrap">
                Low Volatility Profile
              </span>
            </div>

            <!-- Two Spacious Sub-Columns for DSOR and Ulcer -->
            <div class="grid grid-cols-2 gap-4 py-2 border-y border-slate-200 dark:border-slate-800/80 my-1">
              <div class="space-y-0.5">
                <div class="flex items-center space-x-1.5">
                  <span class="text-xs font-mono text-slate-500 uppercase">DSoR</span>
                  <span class="text-[10px] text-cyan-600 dark:text-cyan-400 font-semibold">[Target &gt;0.10]</span>
                </div>
                <div id="kpi-dsor" class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-slate-100 tracking-tight">
                  --
                </div>
                <span class="text-[10px] text-slate-400 block truncate">Downside Semi-Variance</span>
              </div>
              
              <div class="space-y-0.5 border-l border-slate-200 dark:border-slate-800/80 pl-4">
                <div class="flex items-center space-x-1.5">
                  <span class="text-xs font-mono text-slate-500 uppercase">Ulcer Index</span>
                  <span class="text-[10px] text-emerald-600 dark:text-emerald-400 font-semibold">[Low Stress &lt;3.0]</span>
                </div>
                <div id="kpi-ulcer" class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-slate-100 tracking-tight">
                  --
                </div>
                <span class="text-[10px] text-slate-400 block truncate">Drawdown Duration Stress</span>
              </div>
            </div>

            <div class="flex items-center justify-between text-[11px] text-slate-400 dark:text-slate-500 pt-1">
              <span>Risk Metric Engine: Active</span>
              <span class="text-purple-500 font-semibold">Asymmetric Upside</span>
            </div>
          </div>

          <!-- Card 4: Risk Guardrail Engine -->
          <div class="min-w-0 p-5 sm:p-6 rounded-2xl bg-slate-50/90 dark:bg-slate-900/60 border border-slate-300 dark:border-slate-800 shadow-md shadow-slate-200/70 dark:shadow-none space-y-3 font-mono flex flex-col justify-between">
            <div class="flex items-center justify-between gap-3 mb-1">
              <div class="flex items-center space-x-2">
                <span class="text-xs font-mono text-slate-500 dark:text-slate-400 uppercase tracking-wider">// Risk Guardrail Engine</span>
                <div class="relative group/tooltip inline-block">
                  <button type="button" class="w-4 h-4 rounded-full bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:text-cyan-500 dark:hover:text-cyan-400 text-[10px] flex items-center justify-center cursor-help">?</button>
                  <div class="hidden group-hover/tooltip:block absolute left-0 bottom-full mb-2 w-72 p-3 rounded-xl bg-slate-950/95 border border-slate-700 text-slate-200 text-xs shadow-2xl z-50 pointer-events-none leading-relaxed backdrop-blur-md">
                    Automated safety circuit halts all order executions immediately if daily portfolio drawdown exceeds -4.0%.
                  </div>
                </div>
              </div>
              <span id="kpi-venue-badge" class="shrink-0 text-[10px] font-mono font-bold px-2.5 py-1 rounded border bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/30 whitespace-nowrap shadow-sm shadow-amber-500/10">
                PAPER VENUE (MOCK)
              </span>
            </div>

            <div class="flex items-center space-x-3 py-2 min-w-0">
              <span id="kpi-status-indicator" class="w-3.5 h-3.5 rounded-full bg-slate-400 shrink-0"></span>
              <span id="kpi-circuit-status" class="text-xl sm:text-2xl font-extrabold text-slate-400 tracking-tight truncate">
                INITIALIZING...
              </span>
            </div>

            <div class="flex items-center justify-between text-[11px] text-slate-400 dark:text-slate-500 pt-2 border-t border-slate-200 dark:border-slate-800/80">
              <span>40% Concentration Cap &bull; 4% Stop Circuit</span>
              <span class="text-emerald-500 font-semibold">Active Guardrails</span>
            </div>
          </div>

        </div>

        <!-- MODULE 2: VISUAL EXECUTIVE WIDGETS (Strategy Posture Gauge & Circuit Breaker Thermometer) -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 sm:gap-6 min-w-0">
          
          <!-- Widget A: Strategy Posture Gauge -->
          <div class="p-5 sm:p-6 rounded-2xl bg-slate-50/90 dark:bg-slate-900/60 border border-slate-300 dark:border-slate-800 shadow-md font-mono space-y-4 min-w-0">
            <div class="flex items-center justify-between gap-2 border-b border-slate-200 dark:border-slate-800 pb-3">
              <div class="flex items-center space-x-2">
                <span class="text-xs font-mono font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wider">
                  // Strategy Posture Gauge
                </span>
                <div class="relative group/tooltip inline-block">
                  <button type="button" class="w-4 h-4 rounded-full bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:text-cyan-500 dark:hover:text-cyan-400 text-[10px] flex items-center justify-center cursor-help">?</button>
                  <div class="hidden group-hover/tooltip:block absolute left-0 bottom-full mb-2 w-72 p-3 rounded-xl bg-slate-950/95 border border-slate-700 text-slate-200 text-xs shadow-2xl z-50 pointer-events-none leading-relaxed backdrop-blur-md">
                    Dynamic posture determined by portfolio weight concentration, equity volatility, and FinBERT sentiment.
                  </div>
                </div>
              </div>
              <span id="posture-status-badge" class="text-[10px] text-slate-400 uppercase">Standby</span>
            </div>

            <!-- Skeleton Loader for Posture Gauge (Shown during initial load) -->
            <div id="posture-skeleton" class="animate-pulse space-y-3 pt-1">
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
                <div class="h-20 rounded-xl bg-slate-200/70 dark:bg-slate-800/60"></div>
                <div class="h-20 rounded-xl bg-slate-200/70 dark:bg-slate-800/60"></div>
                <div class="h-20 rounded-xl bg-slate-200/70 dark:bg-slate-800/60"></div>
              </div>
              <div class="h-4 bg-slate-200/70 dark:bg-slate-800/60 rounded w-3/4"></div>
            </div>

            <!-- 3-Step Segmented Posture Bar (Hidden during skeleton loading) -->
            <div id="posture-content" class="hidden space-y-4">
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 pt-1">
                <div id="posture-defensive" class="p-3 rounded-xl border transition-all text-center space-y-1 bg-slate-100/60 dark:bg-slate-950/60 border-slate-200 dark:border-slate-800 text-slate-400 opacity-60">
                  <div class="text-base">🛡️</div>
                  <div class="text-[11px] font-bold">Defensive</div>
                  <div class="text-[9px] uppercase tracking-wider text-slate-400">Capital Preservation</div>
                </div>
                <div id="posture-balanced" class="p-3 rounded-xl border transition-all text-center space-y-1 bg-slate-100/60 dark:bg-slate-950/60 border-slate-200 dark:border-slate-800 text-slate-400 opacity-60">
                  <div class="text-base">⚖️</div>
                  <div class="text-[11px] font-bold">Balanced</div>
                  <div class="text-[9px] uppercase tracking-wider text-slate-400">Multi-Asset Rotation</div>
                </div>
                <div id="posture-aggressive" class="p-3 rounded-xl border transition-all text-center space-y-1 bg-slate-100/60 dark:bg-slate-950/60 border-slate-200 dark:border-slate-800 text-slate-400 opacity-60">
                  <div class="text-base">🚀</div>
                  <div class="text-[11px] font-bold">High Conviction</div>
                  <div class="text-[9px] uppercase tracking-wider text-slate-400">Alpha Accumulation</div>
                </div>
              </div>

              <!-- Reassuring Explanation Line -->
              <p id="posture-explanation" class="text-xs font-sans text-slate-600 dark:text-slate-300 leading-relaxed pt-1">
                Awaiting telemetry synchronization...
              </p>
            </div>

            <!-- Error State Container -->
            <div id="posture-error" class="hidden p-4 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-500 text-xs font-mono flex items-center space-x-2.5">
              <svg class="w-4 h-4 shrink-0 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              <span id="posture-error-msg">Error loading strategy posture telemetry.</span>
            </div>
          </div>

          <!-- Widget B: Daily Circuit Breaker Thermometer -->
          <div class="p-5 sm:p-6 rounded-2xl bg-slate-50/90 dark:bg-slate-900/60 border border-slate-300 dark:border-slate-800 shadow-md font-mono space-y-4 min-w-0">
            <div class="flex items-center justify-between gap-2 border-b border-slate-200 dark:border-slate-800 pb-3">
              <div class="flex items-center space-x-2">
                <span class="text-xs font-mono font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wider">
                  // Daily Circuit Breaker Thermometer
                </span>
                <div class="relative group/tooltip inline-block">
                  <button type="button" class="w-4 h-4 rounded-full bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:text-cyan-500 dark:hover:text-cyan-400 text-[10px] flex items-center justify-center cursor-help">?</button>
                  <div class="hidden group-hover/tooltip:block absolute left-0 bottom-full mb-2 w-72 p-3 rounded-xl bg-slate-950/95 border border-slate-700 text-slate-200 text-xs shadow-2xl z-50 pointer-events-none leading-relaxed backdrop-blur-md">
                    Visual proximity meter tracking current day performance against the -4.0% emergency trading halt threshold.
                  </div>
                </div>
              </div>
              <span id="circuit-buffer-badge" class="px-2 py-0.5 rounded text-[10px] font-bold border bg-slate-200/80 dark:bg-slate-800 text-slate-500 border-slate-300 dark:border-slate-700">
                --
              </span>
            </div>

            <!-- Skeleton Loader for Thermometer (Shown during initial load) -->
            <div id="thermometer-skeleton" class="animate-pulse space-y-3 pt-2">
              <div class="h-4 bg-slate-200/70 dark:bg-slate-800/60 rounded-full w-full"></div>
              <div class="flex justify-between">
                <div class="h-3 bg-slate-200/70 dark:bg-slate-800/60 rounded w-20"></div>
                <div class="h-3 bg-slate-200/70 dark:bg-slate-800/60 rounded w-16"></div>
                <div class="h-3 bg-slate-200/70 dark:bg-slate-800/60 rounded w-20"></div>
