---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="User Profile"
  description="Manage user account settings and profile information."
>
  <div class="max-w-4xl mx-auto space-y-8 animate-fade-in-up">
    <div class="border-b border-slate-200 dark:border-slate-800 pb-5">
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-slate-100 font-sans tracking-tight">
        Profile Settings
      </h1>
      <p class="mt-2 text-sm text-slate-600 dark:text-slate-400 font-mono">
        Account management coming soon.
      </p>
    </div>
  </div>
</Layout>
